# Build output
/build/
*.core

# dist/ — `cyrius distlib` output. The bundle and its .deps sidecar ARE
# tracked (1.0.10): they are the published library face a consumer resolves
# with `modules = ["dist/kashi.cyr"]` at a git tag, so they must exist in the
# tree at that tag. Everything else under dist/ stays ignored. CI regenerates
# the bundle and fails on drift (ci.yml "dist bundle in sync"); an untracked
# bundle would slip that gate silently (`git diff --quiet` on an untracked
# path exits 0), hence the explicit re-includes.
/dist/*
!dist/kashi.cyr
!dist/kashi.deps

# Resolved deps — auto-generated by `cyrius deps`, not tracked.
# (agnos / kybernet / agnosys / libro / argonaut all gitignore lib/.)
/lib/

# Release / toolchain artifacts
cyrius-*.tar.gz
*.tar.gz
SHA256SUMS

# Lockfile policy: track when git-deps are present, otherwise omit.
# (kashi has no git-deps yet; cyrius.lock is omitted.)

# Claude Code
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.env
.env.*
*.pem
*.key
