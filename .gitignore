# Build output
/build/
*.core

# dist/ — `cyrius distlib` output. The bundle and its .deps sidecar ARE
# tracked (1.0.10): they are the published library face a consumer resolves
# with `modules = ["dist/kashi.cyr"]` at a git tag, so they must exist in the
# tree at that tag. Everything else under dist/ stays ignored. CI regenerates
# the bundle and fails on drift (ci.yml "dist bundle in sync"); an untracked
# bundle would slip that gate silently (`git diff --quiet` on an untracked
# path exits 0), hence the explicit re-includes.
/dist/*
!dist/kashi.cyr
!dist/kashi.deps

# Resolved deps — auto-generated by `cyrius deps`, not tracked.
# (agnos / kybernet / agnosys / libro / argonaut all gitignore lib/.)
/lib/

# Release / toolchain artifacts
cyrius-*.tar.gz
*.tar.gz
SHA256SUMS

# Lockfile policy: cyrius.lock is TRACKED (1.1.1). It pins the sha256 of
# every stdlib file `cyrius deps` vendors into lib/, and `cyrius deps`
# refuses (exit 1) a file the installed toolchain carries differently — CI's
# integrity check on the toolchain it downloads. cyrius 6.6.9+ writes it for
# a stdlib-only project too and asks that it be committed (until 1.1.1 the
# policy was "omit unless git-deps"). It moves with the pin: `cyrius deps`
# re-locks after a pin bump; commit the result.

# Claude Code
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.env
.env.*
*.pem
*.key
