    kashi_fset8(0xB6, 0x6C6C6C6C6CEC6C6C);  # CP437 0xB6
    kashi_fset8(0xB7, 0x000000FC6C6C6C6C);  # CP437 0xB7
    kashi_fset8(0xB8, 0x0000F818F8181818);  # CP437 0xB8
    kashi_fset8(0xB9, 0x6CEC0CEC6C6C6C6C);  # CP437 0xB9
    kashi_fset8(0xBA, 0x6C6C6C6C6C6C6C6C);  # CP437 0xBA
    kashi_fset8(0xBB, 0x0000FC0CEC6C6C6C);  # CP437 0xBB
    kashi_fset8(0xBC, 0x6C6C0CFC00000000);  # CP437 0xBC
    kashi_fset8(0xBD, 0x6C6C6CFC00000000);  # CP437 0xBD
    kashi_fset8(0xBE, 0x1818F818F8000000);  # CP437 0xBE
    kashi_fset8(0xBF, 0x000000F818181818);  # CP437 0xBF
    kashi_fset8(0xC0, 0x181818181F000000);  # CP437 0xC0
    kashi_fset8(0xC1, 0x18181818FF000000);  # CP437 0xC1
    kashi_fset8(0xC2, 0x000000FF18181818);  # CP437 0xC2
    kashi_fset8(0xC3, 0x181818181F181818);  # CP437 0xC3
    kashi_fset8(0xC4, 0x000000FF00000000);  # CP437 0xC4
    kashi_fset8(0xC5, 0x18181818FF181818);  # CP437 0xC5
    kashi_fset8(0xC6, 0x181F181F18181818);  # CP437 0xC6
    kashi_fset8(0xC7, 0x6C6C6C6C6F6C6C6C);  # CP437 0xC7
    kashi_fset8(0xC8, 0x6C6C6F606F000000);  # CP437 0xC8
    kashi_fset8(0xC9, 0x00003F3037363636);  # CP437 0xC9 — double upper-left corner
    kashi_fset8(0xCA, 0x6C6CEF00EF000000);  # CP437 0xCA
    kashi_fset8(0xCB, 0x0000FF00EF6C6C6C);  # CP437 0xCB
    kashi_fset8(0xCC, 0x6C6C6F606F6C6C6C);  # CP437 0xCC
    kashi_fset8(0xCD, 0x0000FF00FF000000);  # CP437 0xCD — double horizontal
    kashi_fset8(0xCE, 0x6C6CEF00EF6C6C6C);  # CP437 0xCE
    kashi_fset8(0xCF, 0x1818FF00FF000000);  # CP437 0xCF
    kashi_fset8(0xD0, 0x6C6C6C6CFF000000);  # CP437 0xD0
    kashi_fset8(0xD1, 0x0000FF00FF181818);  # CP437 0xD1
    kashi_fset8(0xD2, 0x000000FF6C6C6C6C);  # CP437 0xD2
    kashi_fset8(0xD3, 0x6C6C6C6C7C000000);  # CP437 0xD3
    kashi_fset8(0xD4, 0x18181F181F000000);  # CP437 0xD4
    kashi_fset8(0xD5, 0x0000001F18181818);  # CP437 0xD5
    kashi_fset8(0xD6, 0x0000007C6C6C6C6C);  # CP437 0xD6
    kashi_fset8(0xD7, 0x6C6C6C6CFF6C6C6C);  # CP437 0xD7
    kashi_fset8(0xD8, 0x1818FF18FF181818);  # CP437 0xD8
    kashi_fset8(0xD9, 0x18181818F8000000);  # CP437 0xD9
    kashi_fset8(0xDA, 0x000000001F181818);  # CP437 0xDA
    kashi_fset8(0xDB, 0xFFFFFFFFFFFFFFFF);  # CP437 0xDB — full block
    kashi_fset8(0xDC, 0x00000000FFFFFFFF);  # CP437 0xDC — lower half
    kashi_fset8(0xDD, 0xF0F0F0F0F0F0F0F0);  # CP437 0xDD — left half
    kashi_fset8(0xDE, 0x0F0F0F0F0F0F0F0F);  # CP437 0xDE — right half
    kashi_fset8(0xDF, 0xFFFFFFFF00000000);  # CP437 0xDF — upper half
    kashi_fset8(0xE0, 0x000076DCC8DC7600);  # CP437 0xE0
    kashi_fset8(0xE1, 0x0078CCF8CCF8C0C0);  # CP437 0xE1
    kashi_fset8(0xE2, 0x00FEC6C0C0C0C000);  # CP437 0xE2
    kashi_fset8(0xE3, 0x00FE6C6C6C6C6C00);  # CP437 0xE3
    kashi_fset8(0xE4, 0xFEC6603060C6FE00);  # CP437 0xE4
    kashi_fset8(0xE5, 0x000000007ED8D870);  # CP437 0xE5
    kashi_fset8(0xE6, 0x00006666667C60C0);  # CP437 0xE6
    kashi_fset8(0xE7, 0x000076DC18181800);  # CP437 0xE7
    kashi_fset8(0xE8, 0x7E183C6666663C18);  # CP437 0xE8
    kashi_fset8(0xE9, 0x386CC6FEC6C66C38);  # CP437 0xE9
    kashi_fset8(0xEA, 0x386CC6C66C6C6CEE);  # CP437 0xEA
    kashi_fset8(0xEB, 0x1E30187CCCCCCC78);  # CP437 0xEB
    kashi_fset8(0xEC, 0x0000007EDBDB7E00);  # CP437 0xEC
    kashi_fset8(0xED, 0x06067EDBDB7EC0C0);  # CP437 0xED
    kashi_fset8(0xEE, 0x386060607C606038);  # CP437 0xEE
    kashi_fset8(0xEF, 0x7CC6C6C6C6C6C600);  # CP437 0xEF
    kashi_fset8(0xF0, 0x00FE0000FE0000FE);  # CP437 0xF0
    kashi_fset8(0xF1, 0x18187E18187E0000);  # CP437 0xF1
    kashi_fset8(0xF2, 0x60301818306000FC);  # CP437 0xF2
    kashi_fset8(0xF3, 0x180C0C18306000FC);  # CP437 0xF3
    kashi_fset8(0xF4, 0x0E1B1B1818181818);  # CP437 0xF4
    kashi_fset8(0xF5, 0x18181818D8D8D870);  # CP437 0xF5
    kashi_fset8(0xF6, 0x18180018187E0000);  # CP437 0xF6
    kashi_fset8(0xF7, 0x0076DC0076DC0000);  # CP437 0xF7
    kashi_fset8(0xF8, 0x386C6C3800000000);  # CP437 0xF8
    kashi_fset8(0xF9, 0x0000001818000000);  # CP437 0xF9
    kashi_fset8(0xFA, 0x0000001800000000);  # CP437 0xFA
    kashi_fset8(0xFB, 0x0F0C0C0CEC6C3C1C);  # CP437 0xFB
    kashi_fset8(0xFC, 0x6C36363636000000);  # CP437 0xFC
    kashi_fset8(0xFD, 0x780C18307C000000);  # CP437 0xFD
    kashi_fset8(0xFE, 0x00003C3C3C3C0000);  # CP437 0xFE
    kashi_fset8(0xFF, 0x0000000000000000);  # CP437 0xFF — blank

    # --- Derive VGA 9x16 from VGA 8x16 + the VGA 9-bit-mode col-9 rule.
    # In VGA text mode the 9th column is generated by the hardware: for
    # codepoints in the CP437 box-drawing range 0xC0..0xDF, col 8 (the
    # leftmost bit of the second byte) repeats col 7 (bit 0 of the first
    # byte) so box-drawing lines connect across cells; for all other
    # codepoints col 8 is 0. We bake this rule at init time so the new
    # 9x16 built-in is just `font16 + computed col-9`, no second table
    # to ship or transcribe. See ADR 0006.
    var dch = KASHI_GLYPH_FIRST;
    while (dch <= KASHI_GLYPH_LAST) {
        var src_base = &kashi_font16 + (dch - KASHI_GLYPH_FIRST) * 16;
        var dst_base = &kashi_font9_16 + (dch - KASHI_GLYPH_FIRST) * 32;
        var dr = 0;
        while (dr < 16) {
            var b0 = load8(src_base + dr);
            var b1 = 0;
            if (dch >= 0xC0) {
                if (dch <= 0xDF) { b1 = (b0 & 1) << 7; }
            }
            store8(dst_base + dr * 2 + 0, b0);
            store8(dst_base + dr * 2 + 1, b1);
            dr = dr + 1;
        }
        dch = dch + 1;
    }

    kashi_font_ready = 1;
    return 0;
}

# 1 once kashi_font_init() has populated the tables, else 0. Lets a
# freestanding consumer assert init ran before the first render (audit
# 2026-05-27, F2 — previously the flag was write-only). Pre-init the
# buffers are zeroed BSS, so access is bounds-safe and renders blank.
fn kashi_font_is_ready() {
    return kashi_font_ready;
}

# --- Metadata accessors (freestanding; pure arithmetic) ---

# Glyph cell width in pixels. Both fonts are 8 px wide. Unknown id -> 0.
fn kashi_font_width(font_id) {
    if (font_id == KASHI_FONT_VGA_8X16) { return 8; }
    if (font_id == KASHI_FONT_CGA_8X8) { return 8; }
    if (font_id == KASHI_FONT_VGA_9X16) { return 9; }
    return 0;
}

# Glyph cell height in pixels (= rows per glyph). Unknown id -> 0.
fn kashi_font_height(font_id) {
    if (font_id == KASHI_FONT_VGA_8X16) { return 16; }
    if (font_id == KASHI_FONT_CGA_8X8) { return 8; }
    if (font_id == KASHI_FONT_VGA_9X16) { return 16; }
    return 0;
}

# First encoded codepoint (0x20 / space) for any valid font. Unknown -> 0.
fn kashi_font_first(font_id) {
    if (font_id == KASHI_FONT_VGA_8X16) { return KASHI_GLYPH_FIRST; }
    if (font_id == KASHI_FONT_CGA_8X8) { return KASHI_GLYPH_FIRST; }
    if (font_id == KASHI_FONT_VGA_9X16) { return KASHI_GLYPH_FIRST; }
    return 0;
}

# Number of encoded glyphs (224) for any valid font. Unknown -> 0.
fn kashi_font_count(font_id) {
    if (font_id == KASHI_FONT_VGA_8X16) { return KASHI_GLYPH_COUNT; }
    if (font_id == KASHI_FONT_CGA_8X8) { return KASHI_GLYPH_COUNT; }
    if (font_id == KASHI_FONT_VGA_9X16) { return KASHI_GLYPH_COUNT; }
    return 0;
}

# Bytes per glyph row = ceil(width / 8). 8-wide built-ins return 1; the
# VGA 9x16 built-in (0.5.1) returns 2. Unknown id -> 0. Added in 0.5.0
# (ADR 0005); extended in 0.5.1 (ADR 0006).
fn kashi_font_stride(font_id) {
    if (font_id == KASHI_FONT_VGA_8X16) { return 1; }
    if (font_id == KASHI_FONT_CGA_8X8) { return 1; }
    if (font_id == KASHI_FONT_VGA_9X16) { return 2; }
    return 0;
}

# 1 if `ch` is in the encoded range [0x20, 0x7F], else 0. Caller-facing
# bounds gate so consumers can decide their own fallback for control chars.
fn kashi_glyph_encoded(ch) {
    if (ch < KASHI_GLYPH_FIRST) { return 0; }
    if (ch > KASHI_GLYPH_LAST) { return 0; }
    return 1;
}

# Base pointer to a glyph's contiguous row bytes within the BSS buffer.
# Returns the address of row 0; the consumer reads `height` bytes from it.
# Returns 0 (null) for an out-of-range char or unknown font — the caller
# must null-check (a freestanding kernel cannot afford a wild deref).
fn kashi_glyph_ptr(font_id, ch) {
    if (kashi_glyph_encoded(ch) == 0) { return 0; }
    if (font_id == KASHI_FONT_VGA_8X16) {
        return &kashi_font16 + (ch - KASHI_GLYPH_FIRST) * 16;
    }
    if (font_id == KASHI_FONT_CGA_8X8) {
        return &kashi_font8 + (ch - KASHI_GLYPH_FIRST) * 8;
    }
    if (font_id == KASHI_FONT_VGA_9X16) {
        return &kashi_font9_16 + (ch - KASHI_GLYPH_FIRST) * 32;
    }
    return 0;
}

# One row byte of a glyph (bit 7 = leftmost pixel). row is 0-based, top
# first. Returns 0 for an out-of-range char, unknown font, or out-of-range
# row — a 0 byte renders as blank, the safe default for a console. For
# wide-glyph fonts (stride > 1) this returns the LEADING byte (byte_idx 0);
# use kashi_glyph_row_byte for the other bytes.
fn kashi_glyph_row(font_id, ch, row) {
    if (kashi_glyph_encoded(ch) == 0) { return 0; }
    var h = kashi_font_height(font_id);
    if (h == 0) { return 0; }
    if (row < 0) { return 0; }
    if (row >= h) { return 0; }
    var base = kashi_glyph_ptr(font_id, ch);
    if (base == 0) { return 0; }
    # Stride-aware (0.5.1). Inline the stride rather than call
    # kashi_font_stride() since this accessor is on the per-row render
    # hot path; the function call adds a few ns. Returns the LEADING
    # byte of the row for wide fonts (matches the ADR 0005 contract);
    # multi-byte access via kashi_glyph_row_byte.
    var stride = 1;
    if (font_id == KASHI_FONT_VGA_9X16) { stride = 2; }
    return load8(base + row * stride);
}

# One row byte at column-byte position `byte_idx` (0 = leftmost 8 px).
# Multi-byte-aware sibling of kashi_glyph_row: for stride-1 fonts (both
# built-ins) only byte_idx == 0 is meaningful — anything else returns 0.
# Bounds-safe: all out-of-range inputs return 0 (blank). Added in 0.5.0
# (ADR 0005); enables wide-glyph access uniformly across the freestanding
# and library-face accessor families.
fn kashi_glyph_row_byte(font_id, ch, row, byte_idx) {
    if (byte_idx < 0) { return 0; }
    var stride = kashi_font_stride(font_id);
    if (stride == 0) { return 0; }
    if (byte_idx >= stride) { return 0; }
    if (kashi_glyph_encoded(ch) == 0) { return 0; }
    var h = kashi_font_height(font_id);
    if (h == 0) { return 0; }
    if (row < 0) { return 0; }
    if (row >= h) { return 0; }
    var base = kashi_glyph_ptr(font_id, ch);
    if (base == 0) { return 0; }
    return load8(base + row * stride + byte_idx);
}

# --- font_psf.cyr ---

# === kashi — PSF (PC Screen Font) parser ===
#
# Self-contained, heapless PSF1/PSF2 header parser. Uses ONLY the
# load8/load32/load64 intrinsics + arithmetic — no stdlib, no heap, no
# registry — so it lints standalone and fuzzes in isolation. The runtime
# registry, glyph-store allocation, and the unified accessors that build on
# this parser live in the LIBRARY face (src/lib.cyr); this file is the pure
# byte-level validation layer.
#
# This is kashi's first untrusted-input surface (font bytes from a file or
# the network). Every field is validated and every length bound checked
# BEFORE any indexed read past the fixed header — a malformed or truncated
# font must return an error, never a wild dereference (fuzzed in
# tests/kashi.fcyr).
#
# --- Scope (as of 1.0.0) ---
#
#   * PSF1 (magic 0x36 0x04): 8-wide, 256/512-glyph banks; optional Unicode
#     table (mode bits HASTAB / SEQ).
#   * PSF2 (magic 0x72 0xB5 0x4A 0x86 = LE 0x864AB572): width 1..32
#     (multi-byte rows up to 4 bytes/row — ADR 0005); optional Unicode
#     table (flag HAS_UNICODE).
#   * Unicode table walking via kashi_psf_uni_token; the library face
#     (src/lib.cyr) builds the codepoint→glyph map (ADR 0003) and the
#     ligature/sequence lookup (ADR 0005) on top.
#
# This file is part of the stdlib-using library face. It must NEVER be
# `include`d by the freestanding core (src/font_data.cyr); the dependency
# only ever flows lib.cyr -> font_psf.cyr, never the reverse.

# Result codes for the runtime/library surface. Cyrius enum values must be
# plain non-negative literals, so errors use a positive 10x namespace; the
# public load/register functions return font_id (>= 2) on success or
# `0 - <code>` (negative) on failure (see src/lib.cyr).
enum KashiResult {
    KASHI_OK = 0;
    KASHI_ENOSYS = 101;         # booked, not built
    KASHI_EINVAL = 102;         # invalid argument
    KASHI_EFORMAT = 103;        # malformed / unsupported font file
}

# PSF magic + validation bounds (all plain literals).
enum KashiPsfConst {
    KASHI_PSF1_MAGIC0 = 0x36;
    KASHI_PSF1_MAGIC1 = 0x04;
    KASHI_PSF1_MODE512 = 1;       # mode bit 0: 512-glyph bank
    KASHI_PSF1_MODEHASTAB = 2;    # mode bit 1: has a Unicode table
    KASHI_PSF1_MODESEQ = 4;       # mode bit 2: table has sequences (implies tab)
    KASHI_PSF1_HDR = 4;           # magic(2) + mode(1) + charsize(1)
    KASHI_PSF2_MAGIC = 0x864AB572;
    KASHI_PSF2_HDR_MIN = 32;      # fixed PSF2 header size
    KASHI_PSF2_HAS_UNICODE = 1;   # flags bit 0: has a Unicode table
    KASHI_PSF_MAX_HEIGHT = 32;    # sanity bound on glyph height
    KASHI_PSF_MAX_WIDTH = 32;     # 0.5.0: up to 4 bytes per row (multi-byte rows; ADR 0005)
    KASHI_PSF_MAX_COUNT = 65536;  # sanity bound on glyph count
    KASHI_PSF_KIND_PSF1 = 1;
    KASHI_PSF_KIND_PSF2 = 2;
}

# Token kinds returned by kashi_psf_uni_token while walking a Unicode table.
enum KashiPsfTok {
    KASHI_TOK_CP = 0;     # a single codepoint (read out + 8)
    KASHI_TOK_SEQ = 1;    # sequence separator (0xFFFE PSF1 / 0xFE PSF2)
    KASHI_TOK_TERM = 2;   # glyph terminator (0xFFFF PSF1 / 0xFF PSF2)
    KASHI_TOK_END = 3;    # past `end`, or malformed — stop the walk
    # Token out-struct field offsets (caller-provided `var tok[24]`).
    KASHI_UT_TYPE = 0;
    KASHI_UT_CP = 8;
    KASHI_UT_NEXT = 16;   # byte offset of the next token
}

# Parsed-header out struct, written by psf_parse into a caller-provided
# 56-byte buffer (function-local `var hdr[56]`). Fields are u64 at fixed
# byte offsets.
enum KashiPsfHdr {
    KASHI_PH_KIND = 0;       # 1 = PSF1, 2 = PSF2
    KASHI_PH_WIDTH = 8;      # glyph width in pixels (1..32)
    KASHI_PH_HEIGHT = 16;    # glyph height in pixels = rows per glyph
    KASHI_PH_COUNT = 24;     # number of glyphs
    KASHI_PH_CHARSIZE = 32;  # bytes per glyph (= height for <=8 wide)
    KASHI_PH_DATAOFF = 40;   # byte offset of glyph data within the buffer
    KASHI_PH_UNIOFF = 48;    # byte offset of the Unicode table, 0 if none
}

# Parse a PSF1 header (caller already matched the 2-byte magic and ensured
# len >= KASHI_PSF1_HDR). Internal.
fn _kashi_psf1_parse(buf, len, out) {
    var charsize = load8(buf + 3);   # bytes per glyph; = height for 8-wide
    var height = charsize;
    if (height < 1) { return KASHI_EFORMAT; }
    if (height > KASHI_PSF_MAX_HEIGHT) { return KASHI_EFORMAT; }
    var mode = load8(buf + 2);
    # 0.8.0 audit F1: reject unknown mode bits. PSF1 defines bits 0-2
    # (MODE512 | MODEHASTAB | MODESEQ); bits 3-7 must be zero. An
    # adversarial PSF with junk in the high mode bits is malformed.
    if ((mode & 0xF8) != 0) { return KASHI_EFORMAT; }
    var count = 256;
    if ((mode & KASHI_PSF1_MODE512) != 0) { count = 512; }
    var glyph_bytes = count * charsize;   # <= 512 * 32, fits i64
    var dataend = KASHI_PSF1_HDR + glyph_bytes;
    if (len < dataend) { return KASHI_EFORMAT; }
    # Unicode table present if a table mode bit is set AND bytes follow the
    # glyph data. mode & 0x06 = HASTAB | SEQ.
    var unioff = 0;
    if ((mode & (KASHI_PSF1_MODEHASTAB | KASHI_PSF1_MODESEQ)) != 0) {
        if (len > dataend) { unioff = dataend; }
    }
    store64(out + KASHI_PH_KIND, KASHI_PSF_KIND_PSF1);
    store64(out + KASHI_PH_WIDTH, 8);
    store64(out + KASHI_PH_HEIGHT, height);
    store64(out + KASHI_PH_COUNT, count);
    store64(out + KASHI_PH_CHARSIZE, charsize);
    store64(out + KASHI_PH_DATAOFF, KASHI_PSF1_HDR);
    store64(out + KASHI_PH_UNIOFF, unioff);
    return KASHI_OK;
}

# Parse a PSF2 header (caller already matched the 4-byte magic and ensured
# len >= KASHI_PSF2_HDR_MIN). Internal. load32 is little-endian.
fn _kashi_psf2_parse(buf, len, out) {
    var version = load32(buf + 4);
    if (version != 0) { return KASHI_EFORMAT; }
    var headersize = load32(buf + 8);
    if (headersize < KASHI_PSF2_HDR_MIN) { return KASHI_EFORMAT; }
    if (headersize > len) { return KASHI_EFORMAT; }
    var count = load32(buf + 16);
    var charsize = load32(buf + 20);
    var height = load32(buf + 24);
    var width = load32(buf + 28);
    if (height < 1) { return KASHI_EFORMAT; }
    if (height > KASHI_PSF_MAX_HEIGHT) { return KASHI_EFORMAT; }
    if (width < 1) { return KASHI_EFORMAT; }
    if (width > KASHI_PSF_MAX_WIDTH) { return KASHI_EFORMAT; }
    # bytes per row = ceil(width / 8); declared charsize must equal
    # height * stride. Also rejects fonts whose declared charsize disagrees
    # with their geometry (a typical PSF-mangling failure mode).
    var stride = (width + 7) / 8;
    if (charsize != height * stride) { return KASHI_EFORMAT; }
    if (count < 1) { return KASHI_EFORMAT; }
    if (count > KASHI_PSF_MAX_COUNT) { return KASHI_EFORMAT; }
    var glyph_bytes = count * charsize;   # bounded by checks above
    var flags = load32(buf + 12);
    # 0.8.0 audit F2: reject unknown flag bits. PSF2 defines only bit 0
    # (HAS_UNICODE); all other bits must be zero. Junk in the high
    # bits indicates a malformed or hostile font.
    if ((flags & 0xFFFFFFFE) != 0) { return KASHI_EFORMAT; }
    var dataend = headersize + glyph_bytes;
    if (len < dataend) { return KASHI_EFORMAT; }
    var unioff = 0;
    if ((flags & KASHI_PSF2_HAS_UNICODE) != 0) {
        if (len > dataend) { unioff = dataend; }
    }
    store64(out + KASHI_PH_KIND, KASHI_PSF_KIND_PSF2);
    store64(out + KASHI_PH_WIDTH, width);
    store64(out + KASHI_PH_HEIGHT, height);
    store64(out + KASHI_PH_COUNT, count);
    store64(out + KASHI_PH_CHARSIZE, charsize);
    store64(out + KASHI_PH_DATAOFF, headersize);
    store64(out + KASHI_PH_UNIOFF, unioff);
    return KASHI_OK;
}

# Detect and validate a PSF1/PSF2 font in `buf` (`len` bytes). On success
# fills the 56-byte `out` header struct and returns KASHI_OK; otherwise
# returns KASHI_EINVAL (bad args) or KASHI_EFORMAT (bad/unsupported/truncated
# font) and leaves `out` zeroed. Does NOT read glyph data — only the fixed
# header — so it is safe to call on any buffer, including hostile ones.
fn kashi_psf_parse(buf, len, out) {
    if (buf == 0) { return KASHI_EINVAL; }
    if (out == 0) { return KASHI_EINVAL; }
    if (len < 0) { return KASHI_EINVAL; }
    # Zero the out header first — a caller's `var hdr[56]` is uninitialized.
    store64(out + KASHI_PH_KIND, 0);
    store64(out + KASHI_PH_WIDTH, 0);
    store64(out + KASHI_PH_HEIGHT, 0);
    store64(out + KASHI_PH_COUNT, 0);
    store64(out + KASHI_PH_CHARSIZE, 0);
    store64(out + KASHI_PH_DATAOFF, 0);
    store64(out + KASHI_PH_UNIOFF, 0);

    # PSF2: 4-byte LE magic (needs the full 32-byte fixed header present).
    if (len >= KASHI_PSF2_HDR_MIN) {
        if (load32(buf) == KASHI_PSF2_MAGIC) {
            return _kashi_psf2_parse(buf, len, out);
        }
    }
    # PSF1: 2-byte magic (header is 4 bytes).
    if (len >= KASHI_PSF1_HDR) {
        if (load8(buf) == KASHI_PSF1_MAGIC0) {
            if (load8(buf + 1) == KASHI_PSF1_MAGIC1) {
                return _kashi_psf1_parse(buf, len, out);
            }
        }
    }
    return KASHI_EFORMAT;
}

# Decode one unit of a Unicode table at byte offset `pos` into the 24-byte
# `out` token struct {type @0, codepoint @8, next_offset @16}. `end` is the
# one-past-last valid offset (= the buffer length). `kind` is the PSF kind
# from the parsed header (1 = PSF1 LE-u16, 2 = PSF2 UTF-8).
#
# Always bounds-safe: at/over `end`, or on a malformed/truncated unit,
# returns KASHI_TOK_END (with next = end) so a caller's walk terminates
# rather than reading past the buffer. Pure — load8 + arithmetic only.
fn kashi_psf_uni_token(buf, pos, end, kind, out) {
    store64(out + KASHI_UT_CP, 0);
    if (pos < 0) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }
    if (pos >= end) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }

    if (kind == KASHI_PSF_KIND_PSF1) {
        if (pos + 2 > end) {
            store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
            store64(out + KASHI_UT_NEXT, end);
            return 0;
        }
        var u = load8(buf + pos) | (load8(buf + pos + 1) << 8);
        store64(out + KASHI_UT_NEXT, pos + 2);
        if (u == 0xFFFF) { store64(out + KASHI_UT_TYPE, KASHI_TOK_TERM); return 0; }
        if (u == 0xFFFE) { store64(out + KASHI_UT_TYPE, KASHI_TOK_SEQ); return 0; }
        store64(out + KASHI_UT_TYPE, KASHI_TOK_CP);
        store64(out + KASHI_UT_CP, u);
        return 0;
    }

    # PSF2: UTF-8 codepoints, 0xFF terminates a glyph's entry, 0xFE separates
    # a sequence.
    var b0 = load8(buf + pos);
    if (b0 == 0xFF) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_TERM);
        store64(out + KASHI_UT_NEXT, pos + 1);
        return 0;
    }
    if (b0 == 0xFE) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_SEQ);
        store64(out + KASHI_UT_NEXT, pos + 1);
        return 0;
    }
    if (b0 < 0x80) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_CP);
        store64(out + KASHI_UT_CP, b0);
        store64(out + KASHI_UT_NEXT, pos + 1);
        return 0;
    }
    # Multi-byte lead: pick the length, then fold in continuation bytes.
    var need = 0;
    var cp = 0;
    if ((b0 & 0xE0) == 0xC0) { need = 2; cp = b0 & 0x1F; }
    if ((b0 & 0xF0) == 0xE0) { need = 3; cp = b0 & 0x0F; }
    if ((b0 & 0xF8) == 0xF0) { need = 4; cp = b0 & 0x07; }
    if (need == 0) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);   # invalid lead byte
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }
    if (pos + need > end) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);   # truncated
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }
    var i = 1;
    var bad = 0;
    while (i < need) {
        var cb = load8(buf + pos + i);
        if ((cb & 0xC0) != 0x80) { bad = 1; }
        cp = (cp << 6) | (cb & 0x3F);
        i = i + 1;
    }
    if (bad != 0) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);   # bad continuation
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }
    # 0.7.2 (ADR 0010): reject overlong sequences per RFC 3629. A
    # codepoint must be encoded with the minimum number of bytes — e.g.,
    # U+0041 is `0x41` (1 byte), never `0xC1 0x81` (overlong 2-byte
    # form). Overlong encodings are a canonical-filter-bypass vector
    # historically used in security exploits; rejecting them keeps the
    # decoder canonical.
    if (need == 2) {
        if (cp < 0x80) {
            store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
            store64(out + KASHI_UT_NEXT, end);
            return 0;
        }
    }
    if (need == 3) {
        if (cp < 0x800) {
            store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
            store64(out + KASHI_UT_NEXT, end);
            return 0;
        }
    }
    if (need == 4) {
        if (cp < 0x10000) {
            store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
            store64(out + KASHI_UT_NEXT, end);
            return 0;
        }
    }
    # 0.6.0 audit F2: reject codepoints outside the Unicode range and the
    # UTF-16 surrogate band — these are invalid UTF-8 by spec. No memory
    # safety concern (cp is just a u64 map key) but accepting them lets
    # garbage into the codepoint map. Bound: max U+10FFFF; reject U+D800..DFFF.
    if (cp > 0x10FFFF) {
        store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
        store64(out + KASHI_UT_NEXT, end);
        return 0;
    }
    if (cp >= 0xD800) {
        if (cp <= 0xDFFF) {
            store64(out + KASHI_UT_TYPE, KASHI_TOK_END);
            store64(out + KASHI_UT_NEXT, end);
            return 0;
        }
    }
    store64(out + KASHI_UT_TYPE, KASHI_TOK_CP);
    store64(out + KASHI_UT_CP, cp);
    store64(out + KASHI_UT_NEXT, pos + need);
    return 0;
}

# --- font_bdf.cyr ---

# === kashi — BDF (Bitmap Distribution Format) parser ===
#
# Self-contained, heapless BDF parser. Same posture as src/font_psf.cyr:
# load8 + arithmetic only — no stdlib, no heap, no allocations. So
# `cyaudit vet src/font_bdf.cyr` must report "no dependencies", and the
# parser fuzzes in isolation (tests/kashi.fcyr).
#
# BDF is X11's text source format for bitmap fonts (Terminus, Spleen,
# Tamzen, Cozette, Unifont — all ship as BDF first). See ADR 0008 for
# the 0.7.0 design rationale (strict BBX, ENCODING -1 skipped, 4 MiB
# file cap, properties block walked past without parse).
#
# This file is part of the stdlib-using library face. It must NEVER be
# `include`d by the freestanding core (src/font_data.cyr); the dependency
# only ever flows lib.cyr -> font_bdf.cyr, never the reverse.
#
# --- API (consumed by src/lib.cyr) ---
#
#   kashi_bdf_parse_header(buf, len, hdr, ctx)
#     Validates STARTFONT / FONTBOUNDINGBOX / CHARS, skips
#     STARTPROPERTIES..ENDPROPERTIES blocks, and locates the first
#     STARTCHAR. Fills:
#       hdr (56 bytes):  KIND=3 (BDF), WIDTH, HEIGHT, COUNT, CHARSIZE,
#                        DATAOFF (= offset of first STARTCHAR), UNIOFF=0
#       ctx (32 bytes):  FONTBOUNDINGBOX width/height/xoff/yoff (for
#                        per-glyph BBX validation by next_glyph)
#     Returns KASHI_BDF_OK / KASHI_BDF_EINVAL / KASHI_BDF_EFORMAT.
#
#   kashi_bdf_next_glyph(buf, pos, end, ctx, dest, dest_size, gout)
#     Cursor: from byte offset `pos`, scans to the next STARTCHAR, reads
#     ENCODING + BBX (validated against `ctx`) + BITMAP, decodes the hex
#     rows directly into `dest` (must be >= ceil(width/8)*height bytes),
#     advances past ENDCHAR. Writes the result kind, codepoint, and
#     next-position into the 24-byte `gout`:
#       BG_KIND=0 (OK)   — bitmap written to dest; CP holds the codepoint
#       BG_KIND=1 (SKIP) — ENCODING was -1; dest is undefined, advance NEXT
#       BG_KIND=2 (END)  — reached ENDFONT or buffer end; NEXT holds pos
#     Returns KASHI_BDF_OK on a clean parse (incl. SKIP/END) or
#     KASHI_BDF_EINVAL / KASHI_BDF_EFORMAT on bad args / malformed BDF.

# --- BDF-specific result codes ---
#
# font_psf.cyr defines KashiResult (KASHI_OK/EINVAL/EFORMAT) — but we
# don't include it here (would break "no dependencies" for vet). So the
# BDF parser uses its own non-clashing enum; src/lib.cyr translates
# KASHI_BDF_E* back to the public KASHI_E* values on the load path.
enum KashiBdfRc {
    KASHI_BDF_OK = 0;
    KASHI_BDF_EINVAL = 1;     # null/negative arg
    KASHI_BDF_EFORMAT = 2;    # malformed / unsupported BDF
}

# Constants. KIND=3 extends the PSF parsed-header kind namespace (PSF1=1,
# PSF2=2 in font_psf.cyr). MAX_* mirror the PSF parser's caps (ADR 0005).
# FILE_CAP is the in-memory bound for kashi_load_bdf_file (ADR 0008).
enum KashiBdfConst {
    KASHI_BDF_KIND = 3;
    KASHI_BDF_MAX_WIDTH = 32;
    KASHI_BDF_MAX_HEIGHT = 32;
    KASHI_BDF_MAX_COUNT = 65536;
    KASHI_BDF_FILE_CAP = 4194304;     # 4 MiB
    KASHI_BDF_INT_MAX_DIGITS = 10;    # overflow guard on _kashi_bdf_int
}

# Parsed-header out struct (56 bytes; same shape PSF uses). Defined here
# so font_bdf.cyr stays self-contained — values match font_psf.cyr's
# KashiPsfHdr by design (any future divergence would be a bug).
enum KashiBdfHdr {
    BDF_PH_KIND = 0;
    BDF_PH_WIDTH = 8;
    BDF_PH_HEIGHT = 16;
    BDF_PH_COUNT = 24;
    BDF_PH_CHARSIZE = 32;
    BDF_PH_DATAOFF = 40;
    BDF_PH_UNIOFF = 48;
}

# BDF context (32 bytes). Holds FONTBOUNDINGBOX so next_glyph can validate
# each BBX strictly against the font-wide cell. xoff/yoff are i64 (signed).
enum KashiBdfCtx {
    BDF_CTX_W = 0;
    BDF_CTX_H = 8;
    BDF_CTX_X = 16;
    BDF_CTX_Y = 24;
}

# Glyph out struct from next_glyph (24 bytes).
enum KashiBdfGOut {
    BG_KIND = 0;      # 0=OK, 1=SKIP, 2=END
    BG_CP = 8;        # codepoint (valid only when KIND=0)
    BG_NEXT = 16;     # byte offset to resume scanning
    BG_KIND_OK = 0;
    BG_KIND_SKIP = 1;
    BG_KIND_END = 2;
}

# --- Low-level text scanning primitives ---

# Skip ASCII spaces and tabs. Returns the offset of the first non-WS byte
# at or after `pos` (or `end`). Pure: only load8 + arithmetic.
fn _kashi_bdf_ws(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            var c = load8(buf + pos);
            if (c == 0x20) { pos = pos + 1; }
            if (c == 0x09) { pos = pos + 1; }
            if (c != 0x20) {
                if (c != 0x09) { done = 1; }
            }
        }
    }
    return pos;
}

# Offset of the next newline (\n) at or after `pos`. Returns `end` if no
# newline before the end of the buffer.
fn _kashi_bdf_eol(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            if (load8(buf + pos) == 0x0A) { done = 1; }
            if (done == 0) { pos = pos + 1; }
        }
    }
    return pos;
}

# Advance past the next newline. Returns the offset of the byte immediately
# after the \n (or `end` if no newline before end).
fn _kashi_bdf_next_line(buf, pos, end) {
    var e = _kashi_bdf_eol(buf, pos, end);
    if (e < end) { return e + 1; }
    return end;
}

# Word-boundary check: after a keyword match at `pos+klen`, the next byte
# (if any) must be whitespace or end-of-line. Avoids matching prefixes
# (e.g., STARTFONT vs. STARTFONTGIBBERISH).
fn _kashi_bdf_after_kw(buf, pos, end) {
    if (pos >= end) { return 1; }
    var c = load8(buf + pos);
    if (c == 0x20) { return 1; }
    if (c == 0x09) { return 1; }
    if (c == 0x0A) { return 1; }
    if (c == 0x0D) { return 1; }
    return 0;
}

# Parse a signed decimal integer at `pos`. Writes the value to `out + 0`
# (i64) and the post-integer position to `out + 8`. Returns 1 on success,
# 0 on no-digits-found. Caps consumed digits at KASHI_BDF_INT_MAX_DIGITS
# to keep adversarial inputs from overflowing i64 in the accumulator.
fn _kashi_bdf_int(buf, pos, end, out) {
    store64(out + 0, 0);
    store64(out + 8, pos);
    if (pos >= end) { return 0; }
    var sign = 1;
    var c0 = load8(buf + pos);
    if (c0 == 0x2D) { sign = 0 - 1; pos = pos + 1; }
    if (c0 == 0x2B) { pos = pos + 1; }
    var start = pos;
    var n = 0;
    var digits = 0;
    var overflow = 0;
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            var d = load8(buf + pos);
            if (d < 0x30) { done = 1; }
            if (d > 0x39) { done = 1; }
            if (done == 0) {
                if (digits >= KASHI_BDF_INT_MAX_DIGITS) {
                    # 0.8.0 audit F3: the prior 10-digit cap silently
                    # truncated and returned success, leaving leftover
                    # digits for the next field. Now we mark overflow
                    # and return failure rather than fail-quiet.
                    overflow = 1;
                    done = 1;
                }
                if (done == 0) {
                    n = n * 10 + (d - 0x30);
                    pos = pos + 1;
                    digits = digits + 1;
                }
            }
        }
    }
    if (overflow != 0) { return 0; }
    if (pos == start) { return 0; }
    store64(out + 0, n * sign);
    store64(out + 8, pos);
    return 1;
}

# Parse one hex nybble. Returns 0..15 on success, 0 - 1 on non-hex.
fn _kashi_bdf_nyb(c) {
    if (c >= 0x30) {
        if (c <= 0x39) { return c - 0x30; }
    }
    if (c >= 0x41) {
        if (c <= 0x46) { return c - 0x41 + 10; }
    }
    if (c >= 0x61) {
        if (c <= 0x66) { return c - 0x61 + 10; }
    }
    return 0 - 1;
}

# Parse one hex byte (two hex characters) at `pos`. Returns 0..255 on
# success, 0 - 1 on non-hex / truncated.
fn _kashi_bdf_hex(buf, pos, end) {
    if (pos + 2 > end) { return 0 - 1; }
    var h = _kashi_bdf_nyb(load8(buf + pos));
    var l = _kashi_bdf_nyb(load8(buf + pos + 1));
    if (h < 0) { return 0 - 1; }
    if (l < 0) { return 0 - 1; }
    return (h << 4) | l;
}

# --- Keyword recognizers (line-start, word-bounded) ---
#
# Each returns 1 if buf[pos..] starts with the named keyword followed by a
# word boundary (whitespace or end-of-line/buffer), else 0. Verbose
# per-keyword expansion keeps the parser pure (no module-scope keyword
# tables, no init function, no string-literal dependency). Order is the
# order of first appearance in a well-formed BDF.

fn _kashi_bdf_is_startfont(buf, pos, end) {
    if (pos + 9 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x53) { return 0; }   # S
    if (load8(buf + pos + 1) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 2) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 3) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 4) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 5) != 0x46) { return 0; }   # F
    if (load8(buf + pos + 6) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 7) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 8) != 0x54) { return 0; }   # T
    return _kashi_bdf_after_kw(buf, pos + 9, end);
}

fn _kashi_bdf_is_fontboundingbox(buf, pos, end) {
    if (pos + 15 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x46) { return 0; }   # F
    if (load8(buf + pos + 1) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 2) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 3) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 4) != 0x42) { return 0; }   # B
    if (load8(buf + pos + 5) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 6) != 0x55) { return 0; }   # U
    if (load8(buf + pos + 7) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 8) != 0x44) { return 0; }   # D
    if (load8(buf + pos + 9) != 0x49) { return 0; }   # I
    if (load8(buf + pos + 10) != 0x4E) { return 0; }  # N
    if (load8(buf + pos + 11) != 0x47) { return 0; }  # G
    if (load8(buf + pos + 12) != 0x42) { return 0; }  # B
    if (load8(buf + pos + 13) != 0x4F) { return 0; }  # O
    if (load8(buf + pos + 14) != 0x58) { return 0; }  # X
    return _kashi_bdf_after_kw(buf, pos + 15, end);
}

fn _kashi_bdf_is_chars(buf, pos, end) {
    if (pos + 5 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x43) { return 0; }   # C
    if (load8(buf + pos + 1) != 0x48) { return 0; }   # H
    if (load8(buf + pos + 2) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 3) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 4) != 0x53) { return 0; }   # S
    return _kashi_bdf_after_kw(buf, pos + 5, end);
}

fn _kashi_bdf_is_startchar(buf, pos, end) {
    if (pos + 9 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x53) { return 0; }   # S
    if (load8(buf + pos + 1) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 2) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 3) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 4) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 5) != 0x43) { return 0; }   # C
    if (load8(buf + pos + 6) != 0x48) { return 0; }   # H
    if (load8(buf + pos + 7) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 8) != 0x52) { return 0; }   # R
    return _kashi_bdf_after_kw(buf, pos + 9, end);
}

fn _kashi_bdf_is_encoding(buf, pos, end) {
    if (pos + 8 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 1) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 2) != 0x43) { return 0; }   # C
    if (load8(buf + pos + 3) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 4) != 0x44) { return 0; }   # D
    if (load8(buf + pos + 5) != 0x49) { return 0; }   # I
    if (load8(buf + pos + 6) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 7) != 0x47) { return 0; }   # G
    return _kashi_bdf_after_kw(buf, pos + 8, end);
}

fn _kashi_bdf_is_bbx(buf, pos, end) {
    if (pos + 3 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x42) { return 0; }   # B
    if (load8(buf + pos + 1) != 0x42) { return 0; }   # B
    if (load8(buf + pos + 2) != 0x58) { return 0; }   # X
    return _kashi_bdf_after_kw(buf, pos + 3, end);
}

fn _kashi_bdf_is_bitmap(buf, pos, end) {
    if (pos + 6 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x42) { return 0; }   # B
    if (load8(buf + pos + 1) != 0x49) { return 0; }   # I
    if (load8(buf + pos + 2) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 3) != 0x4D) { return 0; }   # M
    if (load8(buf + pos + 4) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 5) != 0x50) { return 0; }   # P
    return _kashi_bdf_after_kw(buf, pos + 6, end);
}

fn _kashi_bdf_is_endchar(buf, pos, end) {
    if (pos + 7 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 1) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 2) != 0x44) { return 0; }   # D
    if (load8(buf + pos + 3) != 0x43) { return 0; }   # C
    if (load8(buf + pos + 4) != 0x48) { return 0; }   # H
    if (load8(buf + pos + 5) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 6) != 0x52) { return 0; }   # R
    return _kashi_bdf_after_kw(buf, pos + 7, end);
}

fn _kashi_bdf_is_endfont(buf, pos, end) {
    if (pos + 7 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 1) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 2) != 0x44) { return 0; }   # D
    if (load8(buf + pos + 3) != 0x46) { return 0; }   # F
    if (load8(buf + pos + 4) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 5) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 6) != 0x54) { return 0; }   # T
    return _kashi_bdf_after_kw(buf, pos + 7, end);
}

fn _kashi_bdf_is_startprops(buf, pos, end) {
    if (pos + 15 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x53) { return 0; }   # S
    if (load8(buf + pos + 1) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 2) != 0x41) { return 0; }   # A
    if (load8(buf + pos + 3) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 4) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 5) != 0x50) { return 0; }   # P
    if (load8(buf + pos + 6) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 7) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 8) != 0x50) { return 0; }   # P
    if (load8(buf + pos + 9) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 10) != 0x52) { return 0; }  # R
    if (load8(buf + pos + 11) != 0x54) { return 0; }  # T
    if (load8(buf + pos + 12) != 0x49) { return 0; }  # I
    if (load8(buf + pos + 13) != 0x45) { return 0; }  # E
    if (load8(buf + pos + 14) != 0x53) { return 0; }  # S
    return _kashi_bdf_after_kw(buf, pos + 15, end);
}

fn _kashi_bdf_is_endprops(buf, pos, end) {
    if (pos + 13 > end) { return 0; }
    if (load8(buf + pos + 0) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 1) != 0x4E) { return 0; }   # N
    if (load8(buf + pos + 2) != 0x44) { return 0; }   # D
    if (load8(buf + pos + 3) != 0x50) { return 0; }   # P
    if (load8(buf + pos + 4) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 5) != 0x4F) { return 0; }   # O
    if (load8(buf + pos + 6) != 0x50) { return 0; }   # P
    if (load8(buf + pos + 7) != 0x45) { return 0; }   # E
    if (load8(buf + pos + 8) != 0x52) { return 0; }   # R
    if (load8(buf + pos + 9) != 0x54) { return 0; }   # T
    if (load8(buf + pos + 10) != 0x49) { return 0; }  # I
    if (load8(buf + pos + 11) != 0x45) { return 0; }  # E
    if (load8(buf + pos + 12) != 0x53) { return 0; }  # S
    return _kashi_bdf_after_kw(buf, pos + 13, end);
}

# --- Header parsing ---

# Skip a STARTPROPERTIES..ENDPROPERTIES block starting at `pos` (the line
# containing STARTPROPERTIES). Returns the offset of the first byte of the
# line AFTER ENDPROPERTIES on success, or 0 - 1 (i.e., negative) on
# malformed (no ENDPROPERTIES before buffer end). Internal.
fn _kashi_bdf_skip_props(buf, pos, end) {
    var p = _kashi_bdf_next_line(buf, pos, end);
    var done = 0;
    while (done == 0) {
        if (p >= end) { return 0 - 1; }
        var ls = _kashi_bdf_ws(buf, p, end);
        if (_kashi_bdf_is_endprops(buf, ls, end) == 1) {
            return _kashi_bdf_next_line(buf, ls, end);
        }
        p = _kashi_bdf_next_line(buf, p, end);
    }
    return 0 - 1;
}

# Validate header + locate first STARTCHAR. See API doc at file top.
fn kashi_bdf_parse_header(buf, len, hdr, ctx) {
    if (buf == 0) { return KASHI_BDF_EINVAL; }
    if (hdr == 0) { return KASHI_BDF_EINVAL; }
    if (ctx == 0) { return KASHI_BDF_EINVAL; }
    if (len < 0) { return KASHI_BDF_EINVAL; }

    # Zero outputs.
    store64(hdr + BDF_PH_KIND, 0);
    store64(hdr + BDF_PH_WIDTH, 0);
    store64(hdr + BDF_PH_HEIGHT, 0);
    store64(hdr + BDF_PH_COUNT, 0);
    store64(hdr + BDF_PH_CHARSIZE, 0);
    store64(hdr + BDF_PH_DATAOFF, 0);
    store64(hdr + BDF_PH_UNIOFF, 0);
    store64(ctx + BDF_CTX_W, 0);
    store64(ctx + BDF_CTX_H, 0);
    store64(ctx + BDF_CTX_X, 0);
    store64(ctx + BDF_CTX_Y, 0);

    # Track what we have seen.
    var saw_startfont = 0;
    var saw_fbb = 0;
    var saw_chars = 0;
    var width = 0;
    var height = 0;
    var fbb_x = 0;
    var fbb_y = 0;
    var count = 0;
    var dataoff = 0;

    # Walk lines until first STARTCHAR (or end / error).
    var p = 0;
    var done = 0;
    var rc = KASHI_BDF_EFORMAT;
    var nint[16];

    while (done == 0) {
        if (p >= len) { done = 1; }
        if (done == 0) {
            var ls = _kashi_bdf_ws(buf, p, len);
            if (ls >= len) { done = 1; }
            if (done == 0) {
                var c0 = load8(buf + ls);
                var advanced = 0;
                # Blank lines (LF or CR at the first non-WS position).
                if (c0 == 0x0A) {
                    p = _kashi_bdf_next_line(buf, ls, len);
                    advanced = 1;
                }
                if (c0 == 0x0D) {
                    p = _kashi_bdf_next_line(buf, ls, len);
                    advanced = 1;
                }
                # Classify the line. Each matcher both sets `advanced` and
                # updates `p`; the bottom fallthrough only fires if NO matcher
                # matched (handles leading-whitespace lines correctly — a
                # bare `p == ls` check would not advance for those).
                if (advanced == 0) {
                    if (_kashi_bdf_is_startfont(buf, ls, len) == 1) {
                        saw_startfont = 1;
                        p = _kashi_bdf_next_line(buf, ls, len);
                        advanced = 1;
                    }
                }
                if (saw_startfont == 0) {
                    if (advanced == 0) {
                        # First non-blank line must be STARTFONT.
                        done = 1;
                    }
                }
                if (done == 0) {
                    if (advanced == 0) {
                        if (_kashi_bdf_is_fontboundingbox(buf, ls, len) == 1) {
                            advanced = 1;
                            var q = _kashi_bdf_ws(buf, ls + 15, len);
                            if (_kashi_bdf_int(buf, q, len, &nint) == 0) { done = 1; }
                            if (done == 0) {
                                width = load64(&nint + 0);
                                q = _kashi_bdf_ws(buf, load64(&nint + 8), len);
                                if (_kashi_bdf_int(buf, q, len, &nint) == 0) { done = 1; }
                            }
                            if (done == 0) {
                                height = load64(&nint + 0);
                                q = _kashi_bdf_ws(buf, load64(&nint + 8), len);
                                if (_kashi_bdf_int(buf, q, len, &nint) == 0) { done = 1; }
                            }
                            if (done == 0) {
                                fbb_x = load64(&nint + 0);
                                q = _kashi_bdf_ws(buf, load64(&nint + 8), len);
                                if (_kashi_bdf_int(buf, q, len, &nint) == 0) { done = 1; }
                            }
                            if (done == 0) {
                                fbb_y = load64(&nint + 0);
                                if (width < 1) { done = 1; }
                                if (width > KASHI_BDF_MAX_WIDTH) { done = 1; }
                                if (height < 1) { done = 1; }
                                if (height > KASHI_BDF_MAX_HEIGHT) { done = 1; }
                            }
                            if (done == 0) {
                                saw_fbb = 1;
                                p = _kashi_bdf_next_line(buf, ls, len);
                            }
                        }
                    }
                    if (advanced == 0) {
                        if (_kashi_bdf_is_startprops(buf, ls, len) == 1) {
                            advanced = 1;
                            var np = _kashi_bdf_skip_props(buf, ls, len);
                            if (np < 0) { done = 1; }
                            if (done == 0) { p = np; }
                        }
                    }
                    if (advanced == 0) {
                        if (_kashi_bdf_is_chars(buf, ls, len) == 1) {
                            advanced = 1;
                            if (saw_fbb == 0) { done = 1; }
                            if (done == 0) {
                                var q = _kashi_bdf_ws(buf, ls + 5, len);
                                if (_kashi_bdf_int(buf, q, len, &nint) == 0) { done = 1; }
                                if (done == 0) {
                                    count = load64(&nint + 0);
                                    if (count < 1) { done = 1; }
                                    if (count > KASHI_BDF_MAX_COUNT) { done = 1; }
                                }
                            }
                            if (done == 0) {
                                saw_chars = 1;
                                p = _kashi_bdf_next_line(buf, ls, len);
                            }
                        }
                    }
                    if (advanced == 0) {
                        if (_kashi_bdf_is_startchar(buf, ls, len) == 1) {
                            advanced = 1;
                            if (saw_fbb == 0) { done = 1; }
                            if (saw_chars == 0) { done = 1; }
                            if (done == 0) {
                                dataoff = ls;
                                rc = KASHI_BDF_OK;
                                done = 1;
                            }
                        }
                    }
                    if (done == 0) {
                        if (advanced == 0) {
                            # Unrecognized line (FONT, SIZE, COMMENT, etc.).
                            p = _kashi_bdf_next_line(buf, ls, len);
                        }
                    }
                }
            }
        }
    }

    if (rc != KASHI_BDF_OK) { return rc; }

    var stride = (width + 7) / 8;
    var charsize = height * stride;
    store64(hdr + BDF_PH_KIND, KASHI_BDF_KIND);
    store64(hdr + BDF_PH_WIDTH, width);
    store64(hdr + BDF_PH_HEIGHT, height);
    store64(hdr + BDF_PH_COUNT, count);
    store64(hdr + BDF_PH_CHARSIZE, charsize);
    store64(hdr + BDF_PH_DATAOFF, dataoff);
    store64(hdr + BDF_PH_UNIOFF, 0);
    store64(ctx + BDF_CTX_W, width);
    store64(ctx + BDF_CTX_H, height);
    store64(ctx + BDF_CTX_X, fbb_x);
    store64(ctx + BDF_CTX_Y, fbb_y);
    return KASHI_BDF_OK;
}

# --- Glyph parsing ---

# Decode one BITMAP row of `stride` hex bytes (= `stride * 2` hex chars on
# one logical line) at `pos` into `dest`. Returns the offset past the
# row's newline on success, or 0 - 1 on malformed (non-hex / truncated /
# missing terminator).
fn _kashi_bdf_decode_row(buf, pos, end, stride, dest) {
    var p = _kashi_bdf_ws(buf, pos, end);
    var i = 0;
    var done = 0;
    while (done == 0) {
        if (i >= stride) { done = 1; }
        if (done == 0) {
            var b = _kashi_bdf_hex(buf, p, end);
            if (b < 0) { return 0 - 1; }
            store8(dest + i, b);
            p = p + 2;
            i = i + 1;
        }
    }
    # After the last hex pair, expect optional WS then newline or EOF.
    p = _kashi_bdf_ws(buf, p, end);
    if (p >= end) { return p; }
    var c = load8(buf + p);
    if (c == 0x0A) { return p + 1; }
    if (c == 0x0D) { return _kashi_bdf_next_line(buf, p, end); }
    return 0 - 1;
}

# See API doc at file top.
fn kashi_bdf_next_glyph(buf, pos, end, ctx, dest, dest_size, gout) {
    if (buf == 0) { return KASHI_BDF_EINVAL; }
    if (ctx == 0) { return KASHI_BDF_EINVAL; }
    if (gout == 0) { return KASHI_BDF_EINVAL; }
    if (pos < 0) { return KASHI_BDF_EINVAL; }
    if (end < pos) { return KASHI_BDF_EINVAL; }

    store64(gout + BG_KIND, BG_KIND_END);
    store64(gout + BG_CP, 0);
    store64(gout + BG_NEXT, pos);

    var fbb_w = load64(ctx + BDF_CTX_W);
    var fbb_h = load64(ctx + BDF_CTX_H);
    var fbb_x = load64(ctx + BDF_CTX_X);
    var fbb_y = load64(ctx + BDF_CTX_Y);
    var stride = (fbb_w + 7) / 8;
    var need = fbb_h * stride;
    if (dest_size < need) {
        if (dest != 0) { return KASHI_BDF_EINVAL; }
        # dest == 0 is allowed only if we're going to SKIP — but we don't
        # know that yet. Conservative: require a buffer large enough.
        return KASHI_BDF_EINVAL;
    }
    if (dest == 0) { return KASHI_BDF_EINVAL; }

    # Scan forward for STARTCHAR or ENDFONT.
    var p = pos;
    var found = 0;
    var nint[16];
    var done_scan = 0;
    while (done_scan == 0) {
        if (p >= end) { done_scan = 1; }
        if (done_scan == 0) {
            var ls = _kashi_bdf_ws(buf, p, end);
            if (ls >= end) { done_scan = 1; }
            if (done_scan == 0) {
                if (_kashi_bdf_is_startchar(buf, ls, end) == 1) {
                    p = _kashi_bdf_next_line(buf, ls, end);
                    found = 1;
                    done_scan = 1;
                }
                if (done_scan == 0) {
                    if (_kashi_bdf_is_endfont(buf, ls, end) == 1) {
                        # No more glyphs.
                        store64(gout + BG_KIND, BG_KIND_END);
                        store64(gout + BG_NEXT, _kashi_bdf_next_line(buf, ls, end));
                        return KASHI_BDF_OK;
                    }
                    p = _kashi_bdf_next_line(buf, ls, end);
                }
            }
        }
    }
    if (found == 0) {
        # Reached end without STARTCHAR or ENDFONT — that's OK (callers
        # may pass partial buffers); report END at end.
        store64(gout + BG_KIND, BG_KIND_END);
        store64(gout + BG_NEXT, end);
        return KASHI_BDF_OK;
    }

    # Inside a STARTCHAR..ENDCHAR block. Need ENCODING, BBX, BITMAP rows,
    # ENDCHAR.
    var cp = 0;
    var saw_encoding = 0;
    var saw_bbx = 0;
    var saw_bitmap = 0;
    var saw_endchar = 0;
    var skip = 0;
    var blockend = 0;
    var inblock = 1;
    while (inblock == 1) {
        if (p >= end) { return KASHI_BDF_EFORMAT; }
        var ls = _kashi_bdf_ws(buf, p, end);
        if (ls >= end) { return KASHI_BDF_EFORMAT; }
        var c0 = load8(buf + ls);
        var advanced = 0;
        # Blank-line paths.
        if (c0 == 0x0A) {
            p = _kashi_bdf_next_line(buf, ls, end);
            advanced = 1;
        }
        if (c0 == 0x0D) {
            p = _kashi_bdf_next_line(buf, ls, end);
            advanced = 1;
        }
        if (advanced == 0) {
            if (_kashi_bdf_is_endchar(buf, ls, end) == 1) {
                saw_endchar = 1;
                blockend = _kashi_bdf_next_line(buf, ls, end);
                inblock = 0;
                advanced = 1;
            }
        }
        if (inblock == 1) {
            if (advanced == 0) {
                if (_kashi_bdf_is_encoding(buf, ls, end) == 1) {
                    advanced = 1;
                    if (saw_encoding == 1) { return KASHI_BDF_EFORMAT; }
                    var q = _kashi_bdf_ws(buf, ls + 8, end);
                    if (_kashi_bdf_int(buf, q, end, &nint) == 0) { return KASHI_BDF_EFORMAT; }
                    cp = load64(&nint + 0);
                    saw_encoding = 1;
                    if (cp < 0) { skip = 1; }
                    if (cp > 0x10FFFF) { skip = 1; }
                    p = _kashi_bdf_next_line(buf, ls, end);
                }
            }
            if (advanced == 0) {
                if (_kashi_bdf_is_bbx(buf, ls, end) == 1) {
                    advanced = 1;
                    if (saw_bbx == 1) { return KASHI_BDF_EFORMAT; }
                    var q2 = _kashi_bdf_ws(buf, ls + 3, end);
                    if (_kashi_bdf_int(buf, q2, end, &nint) == 0) { return KASHI_BDF_EFORMAT; }
                    var bw = load64(&nint + 0);
                    q2 = _kashi_bdf_ws(buf, load64(&nint + 8), end);
                    if (_kashi_bdf_int(buf, q2, end, &nint) == 0) { return KASHI_BDF_EFORMAT; }
                    var bh = load64(&nint + 0);
                    q2 = _kashi_bdf_ws(buf, load64(&nint + 8), end);
                    if (_kashi_bdf_int(buf, q2, end, &nint) == 0) { return KASHI_BDF_EFORMAT; }
                    var bx = load64(&nint + 0);
                    q2 = _kashi_bdf_ws(buf, load64(&nint + 8), end);
                    if (_kashi_bdf_int(buf, q2, end, &nint) == 0) { return KASHI_BDF_EFORMAT; }
                    var by = load64(&nint + 0);
                    # Strict BBX policy (ADR 0008): all 4 fields match.
                    if (bw != fbb_w) { return KASHI_BDF_EFORMAT; }
                    if (bh != fbb_h) { return KASHI_BDF_EFORMAT; }
                    if (bx != fbb_x) { return KASHI_BDF_EFORMAT; }
                    if (by != fbb_y) { return KASHI_BDF_EFORMAT; }
                    saw_bbx = 1;
                    p = _kashi_bdf_next_line(buf, ls, end);
                }
            }
            if (advanced == 0) {
                if (_kashi_bdf_is_bitmap(buf, ls, end) == 1) {
                    advanced = 1;
                    if (saw_bbx == 0) { return KASHI_BDF_EFORMAT; }
                    if (saw_bitmap == 1) { return KASHI_BDF_EFORMAT; }
                    var rowp = _kashi_bdf_next_line(buf, ls, end);
                    var r = 0;
                    while (r < fbb_h) {
                        # When skipping, still consume rows to advance the
                        # cursor. dest_size >= need was checked up front so
                        # the write is in-bounds even though we discard the
                        # bytes for KIND=SKIP.
                        var next = _kashi_bdf_decode_row(buf, rowp, end, stride, dest + r * stride);
                        if (next < 0) { return KASHI_BDF_EFORMAT; }
                        rowp = next;
                        r = r + 1;
                    }
                    saw_bitmap = 1;
                    p = rowp;
                }
            }
            if (advanced == 0) {
                # Unrecognized line within the glyph block (SWIDTH, DWIDTH,
                # COMMENT, SWIDTH1, VVECTOR, etc.). Skip it. Using a flag
                # (not `p == ls`) correctly handles leading-WS lines.
                p = _kashi_bdf_next_line(buf, ls, end);
            }
        }
    }

    if (saw_endchar == 0) { return KASHI_BDF_EFORMAT; }
    if (saw_encoding == 0) { return KASHI_BDF_EFORMAT; }
    if (saw_bbx == 0) { return KASHI_BDF_EFORMAT; }
    if (saw_bitmap == 0) { return KASHI_BDF_EFORMAT; }

    if (skip == 1) {
        store64(gout + BG_KIND, BG_KIND_SKIP);
        store64(gout + BG_CP, cp);
        store64(gout + BG_NEXT, blockend);
        return KASHI_BDF_OK;
    }
    store64(gout + BG_KIND, BG_KIND_OK);
    store64(gout + BG_CP, cp);
    store64(gout + BG_NEXT, blockend);
    return KASHI_BDF_OK;
}

# --- font_pcf.cyr ---

# === kashi — PCF (Portable Compiled Format) parser ===
#
# Self-contained, heapless PCF parser. Same posture as src/font_psf.cyr
# and src/font_bdf.cyr: load8 + arithmetic only — no stdlib, no heap, no
# allocations. `cyaudit vet src/font_pcf.cyr` must report "no
# dependencies", and the parser fuzzes in isolation (tests/kashi.fcyr).
#
# PCF is X11's compiled binary bitmap font format — what `bdftopcf`
# produces and what X servers load at runtime. Many distributions ship
# bitmap fonts (Terminus, Spleen, Tamzen, Cozette, Unifont) as PCF only.
# See ADR 0009 for the 0.7.1 design rationale.
#
# This file is part of the stdlib-using library face. It must NEVER be
# `include`d by the freestanding core (src/font_data.cyr); the dependency
# only ever flows lib.cyr -> font_pcf.cyr, never the reverse.
#
# --- API (consumed by src/lib.cyr) ---
#
#   kashi_pcf_parse_header(buf, len, hdr, ctx)
#     Validates magic + TOC, locates the required tables (METRICS,
#     BITMAPS, BDF_ENCODINGS), validates METRICS uniformity, computes
#     width/height/glyph_count. Fills:
#       hdr (56 bytes):  KIND=4 (PCF), WIDTH, HEIGHT, COUNT, CHARSIZE,
#                        DATAOFF (offset of bitmap pixel data), UNIOFF=0
#       ctx (128 bytes): glyph_count, dims, source/target row strides,
#                        table offsets within `buf`, format flags,
#                        BDF_ENCODINGS range
#     Returns KASHI_PCF_OK / KASHI_PCF_EINVAL / KASHI_PCF_EFORMAT.
#
#   kashi_pcf_decode_glyph(buf, ctx, glyph_idx, dest, dest_size)
#     Decodes glyph `glyph_idx` into `dest` (>= height * our_stride
#     bytes). Applies scan-unit byte swap + bit-reverse to produce
#     canonical MSB-bit / 1-byte-stride output (kashi's convention:
#     byte 0 = leftmost 8 pixels, bit 7 = leftmost pixel of those 8).
#
#   kashi_pcf_cp_to_idx(buf, ctx, cp)
#     Resolves a codepoint to a glyph index via the BDF_ENCODINGS
#     table. Returns the glyph index (>= 0, < glyph_count) or `0 - 1`
#     if unmapped. Used by the load path to enumerate encoded
#     codepoints without re-parsing the table.

# --- PCF-specific result codes ---
#
# font_psf.cyr defines KashiResult and font_bdf.cyr defines
# KashiBdfRc — keep the PCF codes in their own non-clashing enum;
# src/lib.cyr translates KASHI_PCF_E* into the public KASHI_E* form
# on the load path.
enum KashiPcfRc {
    KASHI_PCF_OK = 0;
    KASHI_PCF_EINVAL = 1;
    KASHI_PCF_EFORMAT = 2;
}

# Constants. KIND=4 extends the kind namespace (PSF1=1, PSF2=2, BDF=3
# in the sibling parsers). MAX_* mirror the existing caps. FILE_CAP
# matches BDF (4 MiB) — see ADR 0009.
enum KashiPcfConst {
    KASHI_PCF_KIND = 4;
    KASHI_PCF_MAX_WIDTH = 32;
    KASHI_PCF_MAX_HEIGHT = 32;
    KASHI_PCF_MAX_COUNT = 65536;
    KASHI_PCF_MAX_TABLES = 64;        # sanity bound on TOC entries
    KASHI_PCF_FILE_CAP = 4194304;     # 4 MiB
    KASHI_PCF_MAGIC0 = 0x01;
    KASHI_PCF_MAGIC1 = 0x66;          # 'f'
    KASHI_PCF_MAGIC2 = 0x63;          # 'c'
    KASHI_PCF_MAGIC3 = 0x70;          # 'p'
    KASHI_PCF_HDR = 8;                # 4-byte magic + 4-byte table_count
    KASHI_PCF_TOC_STRIDE = 16;        # bytes per TOC entry
}

# Table type bits (bit-flag style per the X11 PCF spec; the file's TOC
# stores the type as a u32 with one bit set).
enum KashiPcfType {
    PCF_TYPE_PROPERTIES = 0x01;       # ignored
    PCF_TYPE_ACCELERATORS = 0x02;     # ignored
    PCF_TYPE_METRICS = 0x04;          # REQUIRED
    PCF_TYPE_BITMAPS = 0x08;          # REQUIRED
    PCF_TYPE_INK_METRICS = 0x10;      # ignored
    PCF_TYPE_BDF_ENCODINGS = 0x20;    # REQUIRED
    PCF_TYPE_SWIDTHS = 0x40;          # ignored
    PCF_TYPE_GLYPH_NAMES = 0x80;      # ignored
    PCF_TYPE_BDF_ACCELERATORS = 0x100;# ignored
}

# Format-word bit masks. The format word's low byte holds the layout
# flags; bit 8 (`0x100`) carries the compressed-metrics flag in the
# METRICS table only.
enum KashiPcfFmt {
    PCF_FMT_GLYPH_PAD_MASK = 0x03;    # bits 0-1: 0=1B, 1=2B, 2=4B, 3=8B
    PCF_FMT_BYTE_ORDER = 0x04;        # bit 2: 0=LSB, 1=MSB (byte order)
    PCF_FMT_BIT_ORDER = 0x08;         # bit 3: 0=LSB, 1=MSB (bit order)
    PCF_FMT_SCAN_UNIT_MASK = 0x30;    # bits 4-5: 0=1B, 1=2B, 2=4B, 3=8B
    PCF_FMT_COMPRESSED = 0x100;       # bit 8: METRICS table is compressed
    # 0.8.0 audit F5/F6/F7: explicit valid-bit masks for unknown-bit
    # rejection. METRICS adds COMPRESSED; other tables don't.
    PCF_FMT_VALID_METRICS = 0x13F;    # bits 0-5 + bit 8
    PCF_FMT_VALID_OTHER = 0x3F;       # bits 0-5
}

# Parsed-header out struct (56 bytes; same shape as PSF / BDF).
enum KashiPcfHdr {
    PCF_PH_KIND = 0;
    PCF_PH_WIDTH = 8;
    PCF_PH_HEIGHT = 16;
    PCF_PH_COUNT = 24;
    PCF_PH_CHARSIZE = 32;
    PCF_PH_DATAOFF = 40;              # offset of bitmap pixel data (diagnostic)
    PCF_PH_UNIOFF = 48;               # always 0 — PCF has no separate table
}

# PCF context (128 bytes). Carries everything `decode_glyph` and
# `cp_to_idx` need after `parse_header` returns.
enum KashiPcfCtx {
    PCF_CTX_GLYPH_COUNT = 0;
    PCF_CTX_WIDTH = 8;
    PCF_CTX_HEIGHT = 16;
    PCF_CTX_PCF_ROW_BYTES = 24;       # bytes per source row (depends on pad)
    PCF_CTX_OUR_STRIDE = 32;          # bytes per our-canonical row = ceil(w/8)
    PCF_CTX_BMP_OFFS = 40;            # offset of glyph_offsets[] within buf
    PCF_CTX_BMP_DATA = 48;            # offset of bitmap pixel data within buf
    PCF_CTX_BMP_END = 56;             # one-past-end of bitmap pixel data
    PCF_CTX_BMP_BE = 64;              # 1 if BITMAPS table is big-endian byte
    PCF_CTX_BMP_BIT_LSB = 72;         # 1 if BITMAPS bit order is LSB
    PCF_CTX_BMP_SCAN = 80;            # scan_unit: 1, 2, 4, or 8
    PCF_CTX_ENC_DATA = 88;            # offset of glyph_indices[] within buf
    PCF_CTX_ENC_BE = 96;              # 1 if BDF_ENCODINGS table is big-endian
    PCF_CTX_MIN_B1 = 104;
    PCF_CTX_MAX_B1 = 112;
    PCF_CTX_MIN_B2 = 120;
    # Note: 128 bytes total — caller's `var ctx[128]` is enough.
    # max_b2 is stored in the high half of MIN_B2's u64? No — we have one
    # slot left (PCF_CTX_MIN_B2 + 8 = 128, the upper bound). max_b2 has
    # to go elsewhere or the ctx must be larger. Below we use a 144-byte
    # convention: caller allocates `var ctx[144]`.
    PCF_CTX_MAX_B2 = 128;
    # Total: 136 bytes used; pad to 144 for headroom.
}

# --- Endian-aware multi-byte loads ---

# Read a u16 at `off` from `buf` in the requested endianness.
# `be == 1` → big-endian (byte 0 is high); else little-endian (byte 0 is low).
fn _kashi_pcf_load16(buf, off, be) {
    var b0 = load8(buf + off + 0);
    var b1 = load8(buf + off + 1);
    if (be == 1) { return (b0 << 8) | b1; }
    return b0 | (b1 << 8);
}

# Read a u32 at `off` from `buf` in the requested endianness.
fn _kashi_pcf_load32(buf, off, be) {
    var b0 = load8(buf + off + 0);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    if (be == 1) {
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# Read a signed i16 at `off` from `buf` in the requested endianness.
fn _kashi_pcf_loadi16(buf, off, be) {
    var v = _kashi_pcf_load16(buf, off, be);
    if (v >= 0x8000) { return v - 65536; }
    return v;
}

# Bit-reverse one byte. (b7 b6 b5 b4 b3 b2 b1 b0) -> (b0 b1 b2 b3 b4 b5 b6 b7).
fn _kashi_pcf_revbits(b) {
    var r = 0;
    r = r | ((b & 0x01) << 7);
    r = r | ((b & 0x02) << 5);
    r = r | ((b & 0x04) << 3);
    r = r | ((b & 0x08) << 1);
    r = r | ((b & 0x10) >> 1);
    r = r | ((b & 0x20) >> 3);
    r = r | ((b & 0x40) >> 5);
    r = r | ((b & 0x80) >> 7);
    return r;
}

# Decode glyph_pad / scan_unit code from format byte to actual byte size.
# Encoding: 0=1, 1=2, 2=4, 3=8.
fn _kashi_pcf_pad_size(code) {
    if (code == 0) { return 1; }
    if (code == 1) { return 2; }
    if (code == 2) { return 4; }
    if (code == 3) { return 8; }
    return 0;
}

# --- TOC walking ---

# Scan the TOC for duplicate type values. Returns 1 if any type appears
# more than once, else 0. Bounds-safe: caller has already validated
# `KASHI_PCF_HDR + table_count * KASHI_PCF_TOC_STRIDE <= len`.
# 0.8.0 audit F8: a duplicate-type TOC is malformed (libXfont's
# CVE-2008-0006 cited TOC handling that took the LAST duplicate
# without validating — kashi takes the FIRST, which is safer, but
# detecting and rejecting upfront is even cleaner).
fn _kashi_pcf_has_dup_tables(buf, table_count) {
    var i = 0;
    while (i < table_count) {
        var ei = KASHI_PCF_HDR + i * KASHI_PCF_TOC_STRIDE;
        var ti = _kashi_pcf_load32(buf, ei + 0, 0);
        var j = i + 1;
        while (j < table_count) {
            var ej = KASHI_PCF_HDR + j * KASHI_PCF_TOC_STRIDE;
            var tj = _kashi_pcf_load32(buf, ej + 0, 0);
            if (tj == ti) { return 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Find the TOC entry for `wanted_type` (a PCF_TYPE_* bit). Stores
# `format` at `out + 0`, `size` at `out + 8`, `offset` at `out + 16`
# (24 bytes total). Returns 1 on found, 0 if absent. TOC is always
# little-endian per the PCF spec, regardless of any table's format.
fn _kashi_pcf_find_table(buf, len, table_count, wanted_type, out) {
    store64(out + 0, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var i = 0;
    while (i < table_count) {
        var entry = KASHI_PCF_HDR + i * KASHI_PCF_TOC_STRIDE;
        if (entry + KASHI_PCF_TOC_STRIDE > len) { return 0; }
        var ty = _kashi_pcf_load32(buf, entry + 0, 0);
        if (ty == wanted_type) {
            var fmt = _kashi_pcf_load32(buf, entry + 4, 0);
            var sz = _kashi_pcf_load32(buf, entry + 8, 0);
            var off = _kashi_pcf_load32(buf, entry + 12, 0);
            store64(out + 0, fmt);
            store64(out + 8, sz);
            store64(out + 16, off);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# --- METRICS table parsing ---
#
# Verifies the metrics table contains `glyph_count` entries with uniform
# metrics, and returns the resolved width/height. The table starts with
# its format word (4 bytes, LE byte order per the PCF spec for table
# format words) followed by either:
#   compressed: u16 count + count * (5 bytes/glyph)   (count is BE/LE per format)
#   uncompressed: u32 count + count * (12 bytes/glyph)
# Compressed fields are u8 biased by +0x80 (so 0x80 = 0). Uncompressed
# fields are i16 in the table's endianness.

# Width = right_sb - left_sb; Height = ascent + descent.
# Writes (width, height) to `out + 0` and `out + 8` respectively.
# Returns KASHI_PCF_OK / KASHI_PCF_EFORMAT.
fn _kashi_pcf_parse_metrics(buf, len, m_off, m_size, m_fmt, glyph_count, out) {
    if (m_off < 0) { return KASHI_PCF_EFORMAT; }
    if (m_size < 4) { return KASHI_PCF_EFORMAT; }
    if (m_off + m_size > len) { return KASHI_PCF_EFORMAT; }
    # First 4 bytes at the table are the format word; must match the
    # TOC's format (LE byte order for format words themselves).
    var on_disk_fmt = _kashi_pcf_load32(buf, m_off, 0);
    if (on_disk_fmt != m_fmt) { return KASHI_PCF_EFORMAT; }
    # 0.8.0 audit F5: reject unknown format bits (defense-in-depth per
    # libXfont CVE-2008-0006 pattern — undefined bits in trusted format
    # words are a malformed-file signal). `(m_fmt & VALID) != m_fmt`
    # is true iff some bit in m_fmt lies outside the VALID mask.
    if ((m_fmt & PCF_FMT_VALID_METRICS) != m_fmt) {
        return KASHI_PCF_EFORMAT;
    }

    var be = (m_fmt & PCF_FMT_BYTE_ORDER) >> 2;   # 0 or 1
    var compressed = (m_fmt & PCF_FMT_COMPRESSED) >> 8;
    var p = m_off + 4;
    var count = 0;
    var per_glyph = 0;
    if (compressed == 1) {
        if (p + 2 > m_off + m_size) { return KASHI_PCF_EFORMAT; }
        count = _kashi_pcf_load16(buf, p, be);
        p = p + 2;
        per_glyph = 5;
    }
    if (compressed == 0) {
        if (p + 4 > m_off + m_size) { return KASHI_PCF_EFORMAT; }
        count = _kashi_pcf_load32(buf, p, be);
        p = p + 4;
        per_glyph = 12;
    }
    if (count != glyph_count) { return KASHI_PCF_EFORMAT; }
    if (count < 1) { return KASHI_PCF_EFORMAT; }
    if (count > KASHI_PCF_MAX_COUNT) { return KASHI_PCF_EFORMAT; }
    var data_end = p + count * per_glyph;
    if (data_end > m_off + m_size) { return KASHI_PCF_EFORMAT; }

    # Read glyph 0 metrics as the reference.
    var ref_left = 0;
    var ref_right = 0;
    var ref_width = 0;
    var ref_asc = 0;
    var ref_desc = 0;
    if (compressed == 1) {
        # Compressed fields: byte value - 0x80 = signed value.
        # (0.8.0 audit F4: removed redundant loadi8 line — same result via
        # the explicit `- 0x80` form, which is also what the per-glyph
        # uniformity loop below uses.)
        ref_left = load8(buf + p + 0) - 0x80;
        ref_right = load8(buf + p + 1) - 0x80;
        ref_width = load8(buf + p + 2) - 0x80;
        ref_asc = load8(buf + p + 3) - 0x80;
        ref_desc = load8(buf + p + 4) - 0x80;
    }
    if (compressed == 0) {
        ref_left = _kashi_pcf_loadi16(buf, p + 0, be);
        ref_right = _kashi_pcf_loadi16(buf, p + 2, be);
        ref_width = _kashi_pcf_loadi16(buf, p + 4, be);
        ref_asc = _kashi_pcf_loadi16(buf, p + 6, be);
        ref_desc = _kashi_pcf_loadi16(buf, p + 8, be);
        # field 10..11 is `attributes` — ignored.
    }

    var width = ref_right - ref_left;
    var height = ref_asc + ref_desc;
    if (width < 1) { return KASHI_PCF_EFORMAT; }
    if (width > KASHI_PCF_MAX_WIDTH) { return KASHI_PCF_EFORMAT; }
    if (height < 1) { return KASHI_PCF_EFORMAT; }
    if (height > KASHI_PCF_MAX_HEIGHT) { return KASHI_PCF_EFORMAT; }

    # Strict uniformity: every other glyph must match the reference.
    var i = 1;
    var bad = 0;
    while (i < count) {
        var qp = p + i * per_glyph;
        var lb = 0;
        var rb = 0;
        var wb = 0;
        var ab = 0;
        var db = 0;
        if (compressed == 1) {
            lb = load8(buf + qp + 0) - 0x80;
            rb = load8(buf + qp + 1) - 0x80;
            wb = load8(buf + qp + 2) - 0x80;
            ab = load8(buf + qp + 3) - 0x80;
            db = load8(buf + qp + 4) - 0x80;
        }
        if (compressed == 0) {
            lb = _kashi_pcf_loadi16(buf, qp + 0, be);
            rb = _kashi_pcf_loadi16(buf, qp + 2, be);
            wb = _kashi_pcf_loadi16(buf, qp + 4, be);
            ab = _kashi_pcf_loadi16(buf, qp + 6, be);
            db = _kashi_pcf_loadi16(buf, qp + 8, be);
        }
        if (lb != ref_left) { bad = 1; }
        if (rb != ref_right) { bad = 1; }
        if (wb != ref_width) { bad = 1; }
        if (ab != ref_asc) { bad = 1; }
        if (db != ref_desc) { bad = 1; }
        i = i + 1;
    }
    if (bad != 0) { return KASHI_PCF_EFORMAT; }

    store64(out + 0, width);
    store64(out + 8, height);
    return KASHI_PCF_OK;
}

# --- BITMAPS table parsing ---
#
# Layout:
#   0..3:    format word (LE)
#   4..7:    glyph_count (table's endianness)
#   8..8+N*4: glyph_offsets[] (each u32 in table's endianness)
#   N+8..N+24: 4 padding sizes (u32 each) — total bitmap data sizes per pad
#   N+24..end: bitmap_data
fn _kashi_pcf_parse_bitmaps(buf, len, b_off, b_size, b_fmt, glyph_count, ctx) {
    if (b_off < 0) { return KASHI_PCF_EFORMAT; }
    if (b_size < 8) { return KASHI_PCF_EFORMAT; }
    if (b_off + b_size > len) { return KASHI_PCF_EFORMAT; }
    var on_disk_fmt = _kashi_pcf_load32(buf, b_off, 0);
    if (on_disk_fmt != b_fmt) { return KASHI_PCF_EFORMAT; }
    # 0.8.0 audit F6: reject unknown format bits in BITMAPS (no
    # COMPRESSED bit allowed here — that's METRICS-only).
    if ((b_fmt & PCF_FMT_VALID_OTHER) != b_fmt) {
        return KASHI_PCF_EFORMAT;
    }

    var be = (b_fmt & PCF_FMT_BYTE_ORDER) >> 2;
    var bit_lsb = 1 - ((b_fmt & PCF_FMT_BIT_ORDER) >> 3);   # 1 if LSB
    var pad_code = b_fmt & PCF_FMT_GLYPH_PAD_MASK;
    var scan_code = (b_fmt & PCF_FMT_SCAN_UNIT_MASK) >> 4;
    var glyph_pad = _kashi_pcf_pad_size(pad_code);
    var scan_unit = _kashi_pcf_pad_size(scan_code);
    if (glyph_pad < 1) { return KASHI_PCF_EFORMAT; }
    if (scan_unit < 1) { return KASHI_PCF_EFORMAT; }
    # Constrain so per-row scan-unit swap stays within row boundaries
    # (ADR 0009: glyph_pad >= scan_unit avoids cross-row swap pathology).
    if (glyph_pad < scan_unit) { return KASHI_PCF_EFORMAT; }

    var p = b_off + 4;
    var declared = _kashi_pcf_load32(buf, p, be);
    p = p + 4;
    if (declared != glyph_count) { return KASHI_PCF_EFORMAT; }

    var offs_start = p;
    var offs_end = p + glyph_count * 4;
    if (offs_end + 16 > b_off + b_size) { return KASHI_PCF_EFORMAT; }
    var pad_sizes_off = offs_end;
    # bitmap_data starts after the 4 padding-size entries.
    var data_off = pad_sizes_off + 16;
    if (data_off > b_off + b_size) { return KASHI_PCF_EFORMAT; }
    var data_end = b_off + b_size;

    store64(ctx + PCF_CTX_BMP_OFFS, offs_start);
    store64(ctx + PCF_CTX_BMP_DATA, data_off);
    store64(ctx + PCF_CTX_BMP_END, data_end);
    store64(ctx + PCF_CTX_BMP_BE, be);
    store64(ctx + PCF_CTX_BMP_BIT_LSB, bit_lsb);
    store64(ctx + PCF_CTX_BMP_SCAN, scan_unit);

    var width = load64(ctx + PCF_CTX_WIDTH);
    var our_stride = (width + 7) / 8;
    # pcf_row_bytes = bytes per row in the source: width bits padded
    # up to a glyph_pad-byte boundary.
    var data_bits = width;
    var pad_bits = glyph_pad * 8;
    var pcf_row_bytes = ((data_bits + pad_bits - 1) / pad_bits) * glyph_pad;
    store64(ctx + PCF_CTX_PCF_ROW_BYTES, pcf_row_bytes);
    store64(ctx + PCF_CTX_OUR_STRIDE, our_stride);
    return KASHI_PCF_OK;
}

# --- BDF_ENCODINGS table parsing ---
#
# Layout:
#   0..3:    format word (LE)
#   4..5:    min_char_or_byte2 (table's endianness)
#   6..7:    max_char_or_byte2
#   8..9:    min_byte1
#   10..11:  max_byte1
#   12..13:  default_char
#   14..14+N*2: glyph_indices[]  where N = (max_b2-min_b2+1) * (max_b1-min_b1+1)
fn _kashi_pcf_parse_encodings(buf, len, e_off, e_size, e_fmt, glyph_count, ctx) {
    if (e_off < 0) { return KASHI_PCF_EFORMAT; }
    if (e_size < 14) { return KASHI_PCF_EFORMAT; }
    if (e_off + e_size > len) { return KASHI_PCF_EFORMAT; }
    var on_disk_fmt = _kashi_pcf_load32(buf, e_off, 0);
    if (on_disk_fmt != e_fmt) { return KASHI_PCF_EFORMAT; }
    # 0.8.0 audit F7: reject unknown format bits in BDF_ENCODINGS.
    if ((e_fmt & PCF_FMT_VALID_OTHER) != e_fmt) {
        return KASHI_PCF_EFORMAT;
    }

    var be = (e_fmt & PCF_FMT_BYTE_ORDER) >> 2;
    var min_b2 = _kashi_pcf_load16(buf, e_off + 4, be);
    var max_b2 = _kashi_pcf_load16(buf, e_off + 6, be);
    var min_b1 = _kashi_pcf_load16(buf, e_off + 8, be);
    var max_b1 = _kashi_pcf_load16(buf, e_off + 10, be);
    # default_char at +12..+13 — ignored.
    if (min_b2 > max_b2) { return KASHI_PCF_EFORMAT; }
    if (min_b1 > max_b1) { return KASHI_PCF_EFORMAT; }
    if (max_b2 > 0xFF) { return KASHI_PCF_EFORMAT; }
    if (max_b1 > 0xFF) { return KASHI_PCF_EFORMAT; }
    var range_b2 = max_b2 - min_b2 + 1;
    var range_b1 = max_b1 - min_b1 + 1;
    var n = range_b1 * range_b2;
    if (n < 1) { return KASHI_PCF_EFORMAT; }
    var indices_off = e_off + 14;
    if (indices_off + n * 2 > e_off + e_size) { return KASHI_PCF_EFORMAT; }

    store64(ctx + PCF_CTX_ENC_DATA, indices_off);
    store64(ctx + PCF_CTX_ENC_BE, be);
    store64(ctx + PCF_CTX_MIN_B1, min_b1);
    store64(ctx + PCF_CTX_MAX_B1, max_b1);
    store64(ctx + PCF_CTX_MIN_B2, min_b2);
    store64(ctx + PCF_CTX_MAX_B2, max_b2);
    return KASHI_PCF_OK;
}

# --- Public: header parse ---

fn kashi_pcf_parse_header(buf, len, hdr, ctx) {
    if (buf == 0) { return KASHI_PCF_EINVAL; }
    if (hdr == 0) { return KASHI_PCF_EINVAL; }
    if (ctx == 0) { return KASHI_PCF_EINVAL; }
    if (len < 0) { return KASHI_PCF_EINVAL; }

    # Zero outputs (caller's `var hdr[56]`, `var ctx[144]`).
    var z = 0;
    while (z < 56) { store8(hdr + z, 0); z = z + 1; }
    z = 0;
    while (z < 144) { store8(ctx + z, 0); z = z + 1; }

    # Header: 4-byte magic + 4-byte LE table_count.
    if (len < KASHI_PCF_HDR) { return KASHI_PCF_EFORMAT; }
    if (load8(buf + 0) != KASHI_PCF_MAGIC0) { return KASHI_PCF_EFORMAT; }
    if (load8(buf + 1) != KASHI_PCF_MAGIC1) { return KASHI_PCF_EFORMAT; }
    if (load8(buf + 2) != KASHI_PCF_MAGIC2) { return KASHI_PCF_EFORMAT; }
    if (load8(buf + 3) != KASHI_PCF_MAGIC3) { return KASHI_PCF_EFORMAT; }
    var table_count = _kashi_pcf_load32(buf, 4, 0);
    if (table_count < 1) { return KASHI_PCF_EFORMAT; }
    if (table_count > KASHI_PCF_MAX_TABLES) { return KASHI_PCF_EFORMAT; }
    var toc_end = KASHI_PCF_HDR + table_count * KASHI_PCF_TOC_STRIDE;
    if (toc_end > len) { return KASHI_PCF_EFORMAT; }
    # 0.8.0 audit F8: reject TOCs with duplicate type entries.
    if (_kashi_pcf_has_dup_tables(buf, table_count) == 1) {
        return KASHI_PCF_EFORMAT;
    }

    # Locate required tables.
    var ent[24];
    if (_kashi_pcf_find_table(buf, len, table_count, PCF_TYPE_METRICS, &ent) == 0) {
        return KASHI_PCF_EFORMAT;
    }
    var m_fmt = load64(&ent + 0);
    var m_size = load64(&ent + 8);
    var m_off = load64(&ent + 16);

    if (_kashi_pcf_find_table(buf, len, table_count, PCF_TYPE_BITMAPS, &ent) == 0) {
        return KASHI_PCF_EFORMAT;
    }
    var b_fmt = load64(&ent + 0);
    var b_size = load64(&ent + 8);
    var b_off = load64(&ent + 16);

    if (_kashi_pcf_find_table(buf, len, table_count, PCF_TYPE_BDF_ENCODINGS, &ent) == 0) {
        return KASHI_PCF_EFORMAT;
    }
    var e_fmt = load64(&ent + 0);
    var e_size = load64(&ent + 8);
    var e_off = load64(&ent + 16);

    # Read glyph_count from BITMAPS (it's the canonical glyph count;
    # METRICS validates against it).
    if (b_off + 8 > len) { return KASHI_PCF_EFORMAT; }
    var b_be = (b_fmt & PCF_FMT_BYTE_ORDER) >> 2;
    var glyph_count = _kashi_pcf_load32(buf, b_off + 4, b_be);
    if (glyph_count < 1) { return KASHI_PCF_EFORMAT; }
    if (glyph_count > KASHI_PCF_MAX_COUNT) { return KASHI_PCF_EFORMAT; }
    store64(ctx + PCF_CTX_GLYPH_COUNT, glyph_count);

    # METRICS: dimensions + uniformity check.
    var dims[16];
    var rc = _kashi_pcf_parse_metrics(buf, len, m_off, m_size, m_fmt, glyph_count, &dims);
    if (rc != KASHI_PCF_OK) { return rc; }
    var width = load64(&dims + 0);
    var height = load64(&dims + 8);
    store64(ctx + PCF_CTX_WIDTH, width);
    store64(ctx + PCF_CTX_HEIGHT, height);

    # BITMAPS: offsets + data layout.
    rc = _kashi_pcf_parse_bitmaps(buf, len, b_off, b_size, b_fmt, glyph_count, ctx);
    if (rc != KASHI_PCF_OK) { return rc; }

    # BDF_ENCODINGS: codepoint range.
    rc = _kashi_pcf_parse_encodings(buf, len, e_off, e_size, e_fmt, glyph_count, ctx);
    if (rc != KASHI_PCF_OK) { return rc; }

    # Fill the parsed-header struct (same shape PSF / BDF use).
    var our_stride = (width + 7) / 8;
    var charsize = height * our_stride;
    var data_off = load64(ctx + PCF_CTX_BMP_DATA);
    store64(hdr + PCF_PH_KIND, KASHI_PCF_KIND);
    store64(hdr + PCF_PH_WIDTH, width);
    store64(hdr + PCF_PH_HEIGHT, height);
    store64(hdr + PCF_PH_COUNT, glyph_count);
    store64(hdr + PCF_PH_CHARSIZE, charsize);
    store64(hdr + PCF_PH_DATAOFF, data_off);
    store64(hdr + PCF_PH_UNIOFF, 0);
    return KASHI_PCF_OK;
}

# --- Public: glyph decode ---
#
# Reads `glyph_idx`'s per-row pcf_row_bytes from the source bitmap data,
# applies scan-unit byte swap (if byte/bit orders differ) + bit-reverse
# (if bit order is LSB), and writes the first our_stride bytes of each
# canonicalized row into `dest`. dest_size must be >= height * our_stride.

fn kashi_pcf_decode_glyph(buf, ctx, glyph_idx, dest, dest_size) {
    if (buf == 0) { return KASHI_PCF_EINVAL; }
    if (ctx == 0) { return KASHI_PCF_EINVAL; }
    if (dest == 0) { return KASHI_PCF_EINVAL; }
    if (glyph_idx < 0) { return KASHI_PCF_EINVAL; }
    var glyph_count = load64(ctx + PCF_CTX_GLYPH_COUNT);
    if (glyph_idx >= glyph_count) { return KASHI_PCF_EINVAL; }

    var width = load64(ctx + PCF_CTX_WIDTH);
    var height = load64(ctx + PCF_CTX_HEIGHT);
    var pcf_row_bytes = load64(ctx + PCF_CTX_PCF_ROW_BYTES);
    var our_stride = load64(ctx + PCF_CTX_OUR_STRIDE);
    var need = height * our_stride;
    if (dest_size < need) { return KASHI_PCF_EINVAL; }

    var offs_pos = load64(ctx + PCF_CTX_BMP_OFFS);
    var data_pos = load64(ctx + PCF_CTX_BMP_DATA);
    var data_end = load64(ctx + PCF_CTX_BMP_END);
    var be = load64(ctx + PCF_CTX_BMP_BE);
    var bit_lsb = load64(ctx + PCF_CTX_BMP_BIT_LSB);
    var scan_unit = load64(ctx + PCF_CTX_BMP_SCAN);

    var goff = _kashi_pcf_load32(buf, offs_pos + glyph_idx * 4, be);
    var src = data_pos + goff;
    if (src < data_pos) { return KASHI_PCF_EFORMAT; }
    var total = height * pcf_row_bytes;
    if (src + total > data_end) { return KASHI_PCF_EFORMAT; }

    # Per-row scratch (max pcf_row_bytes = 8 at glyph_pad=8).
    var scratch[8];
    var need_swap = 0;
    var bit_msb = 1 - bit_lsb;
    # libXfont-style: swap if byte_order != bit_order. byte_order bit
    # = `be`; bit_order MSB bit = `bit_msb`. need_swap = (be != bit_msb).
    if (be != bit_msb) { need_swap = 1; }
    if (scan_unit < 2) { need_swap = 0; }

    var r = 0;
    while (r < height) {
        var row_src = src + r * pcf_row_bytes;
        # Copy row into scratch.
        var k = 0;
        while (k < pcf_row_bytes) {
            store8(&scratch + k, load8(buf + row_src + k));
            k = k + 1;
        }
        # Scan-unit byte swap (in-scratch).
        if (need_swap == 1) {
            var grp = 0;
            while (grp + scan_unit <= pcf_row_bytes) {
                var a = 0;
                var b = scan_unit - 1;
                while (a < b) {
                    var ta = load8(&scratch + grp + a);
                    var tb = load8(&scratch + grp + b);
                    store8(&scratch + grp + a, tb);
                    store8(&scratch + grp + b, ta);
                    a = a + 1;
                    b = b - 1;
                }
                grp = grp + scan_unit;
            }
        }
        # Bit-reverse each byte if bit_order is LSB.
        if (bit_lsb == 1) {
            var k2 = 0;
            while (k2 < pcf_row_bytes) {
                store8(&scratch + k2, _kashi_pcf_revbits(load8(&scratch + k2)));
                k2 = k2 + 1;
            }
        }
        # Copy the first our_stride bytes into dest.
        var k3 = 0;
        while (k3 < our_stride) {
            store8(dest + r * our_stride + k3, load8(&scratch + k3));
            k3 = k3 + 1;
        }
        r = r + 1;
    }
    return KASHI_PCF_OK;
}

# --- Public: codepoint → glyph index ---
#
# Resolves `cp` through the BDF_ENCODINGS table. The table is a 2D
# array indexed by (byte1, byte2): byte1 = (cp >> 8), byte2 = cp & 0xFF.
# Returns the glyph index, or `0 - 1` if cp is unmapped (out of range
# or the table cell holds the sentinel 0xFFFF).

fn kashi_pcf_cp_to_idx(buf, ctx, cp) {
    if (buf == 0) { return 0 - 1; }
    if (ctx == 0) { return 0 - 1; }
    if (cp < 0) { return 0 - 1; }
    var min_b1 = load64(ctx + PCF_CTX_MIN_B1);
    var max_b1 = load64(ctx + PCF_CTX_MAX_B1);
    var min_b2 = load64(ctx + PCF_CTX_MIN_B2);
    var max_b2 = load64(ctx + PCF_CTX_MAX_B2);
    var b1 = (cp >> 8) & 0xFF;
    var b2 = cp & 0xFF;
    if (b1 < min_b1) { return 0 - 1; }
    if (b1 > max_b1) { return 0 - 1; }
    if (b2 < min_b2) { return 0 - 1; }
    if (b2 > max_b2) { return 0 - 1; }
    var range_b2 = max_b2 - min_b2 + 1;
    var idx = (b1 - min_b1) * range_b2 + (b2 - min_b2);
    var data = load64(ctx + PCF_CTX_ENC_DATA);
    var be = load64(ctx + PCF_CTX_ENC_BE);
    var raw = _kashi_pcf_load16(buf, data + idx * 2, be);
    if (raw == 0xFFFF) { return 0 - 1; }
    var glyph_count = load64(ctx + PCF_CTX_GLYPH_COUNT);
    if (raw >= glyph_count) { return 0 - 1; }
    return raw;
}

# --- lib.cyr ---

# === kashi — library root ===
#
# kashi (काशि, "shining") is the AGNOS console-font subsystem: bitmap glyph
# data plus the machinery to load and query console fonts. This file is the
# stdlib-using LIBRARY face — the surface consumers who CAN link the Cyrius
# stdlib (userland tools, the future TTY/console stack) use.
#
# --- The two faces of kashi (the load-bearing split — see docs/adr/0001) ---
#
#   1. FREESTANDING CORE  — src/font_data.cyr
#      No stdlib, no heap, no syscalls. Three built-in fonts (VGA 8x16,
#      CGA 8x8, VGA 9x16 derived) + pure-arithmetic accessors covering full
#      CP437. A freestanding kernel (agnos, which has `[deps] stdlib = []`
#      and a vendored klib/) `include`s this file DIRECTLY and never
#      touches the rest of kashi.
#
#   2. FULL LIBRARY       — this file (src/lib.cyr) + src/font_psf.cyr.
#      stdlib-using. Runtime PSF1/PSF2 import (`kashi_load_psf*`,
#      `kashi_register_font`), codepoint→glyph Unicode mapping, ligature
#      lookup, unified codepoint-addressed accessors (built-in + runtime),
#      active-font knob. Do NOT let any of it leak `include`s into
#      font_data.cyr — the boundary is checked by `cyaudit vet`.

# ---------------------------------------------------------------------------
# Runtime font surface (M1). The PSF byte parser + result codes (KashiResult)
# and PSF constants live in src/font_psf.cyr; this file owns the runtime
# registry, glyph-store allocation, and the unified accessors that dispatch
# across the built-in (ids 0,1) and runtime (ids >= 2) id spaces. See
# docs/adr/0002.
#
# Return convention: kashi_load_psf / kashi_register_font return a font_id
# (>= KASHI_RT_FONT_BASE) on success, or `0 - <KashiResult>` (negative) on
# failure. Built-in ids 0,1 are never returned by these. (`0 - N` form per
# the no-negative-literals rule.)
#
# Glyph addressing (M2 — see docs/adr/0003): the unified accessors
# kashi_font_ptr / kashi_font_row are CODEPOINT-addressed. Built-ins use an
# ASCII codepoint (0x20..0x7F). A runtime font that carried a PSF Unicode
# table resolves the codepoint through that table; a runtime font WITHOUT a
# table falls back to treating the codepoint as a raw glyph index. Raw
# glyph-INDEX access (tooling / enumeration) is kashi_rt_glyph_ptr / _row.
# ---------------------------------------------------------------------------

# Runtime fonts start at id 3 (0 = VGA 8x16, 1 = CGA 8x8, 2 = VGA 9x16 are
# the freestanding-core built-ins). Bumped 2 -> 3 in 0.5.1 (ADR 0006) when
# the 9x16 derived built-in landed.
enum KashiRtBase {
    KASHI_RT_FONT_BASE = 3;
}

# Runtime font record: 88 bytes (grown in 0.5.0 for stride + sequences).
enum KashiRtRec {
    RT_WIDTH = 0;
    RT_HEIGHT = 8;
    RT_COUNT = 16;
    RT_CHARSIZE = 24;
    RT_DATA = 32;       # ptr to owned glyph bytes (count * charsize)
    RT_UMAP = 40;       # ptr to sorted {u64 codepoint, u64 glyph} pairs, 0 if none
    RT_UCOUNT = 48;     # number of codepoint->glyph pairs in RT_UMAP
    RT_STRIDE = 56;     # bytes per glyph row = ceil(width / 8)
    RT_SEQS = 64;       # ptr to {u64 cps_ptr, u64 length, u64 glyph} records, 0 if none
    RT_SEQCOUNT = 72;   # number of sequence records in RT_SEQS
    RT_SEQDATA = 80;    # ptr to flat codepoint stream backing RT_SEQS, 0 if none
}

# Registry: a vec of record pointers, lazily created on first register.
var _rt_registry = 0;

# Fetch the record for a runtime font_id, or 0 if out of range / no registry.
fn _kashi_rt_get(font_id) {
    if (_rt_registry == 0) { return 0; }
    var idx = font_id - KASHI_RT_FONT_BASE;
    if (idx < 0) { return 0; }
    if (idx >= vec_len(_rt_registry)) { return 0; }
    return vec_get(_rt_registry, idx);
}

# Register an ALREADY-OWNED glyph store (count * charsize bytes the registry
# now owns — no copy). Returns the new font_id. Internal.
fn _kashi_rt_register(width, height, count, charsize, data) {
    if (_rt_registry == 0) { _rt_registry = vec_new(); }
    var rec = alloc(88);
    if (rec == 0) { return 0 - KASHI_EINVAL; }
    var stride = (width + 7) / 8;
    store64(rec + RT_WIDTH, width);
    store64(rec + RT_HEIGHT, height);
    store64(rec + RT_COUNT, count);
    store64(rec + RT_CHARSIZE, charsize);
    store64(rec + RT_DATA, data);
    store64(rec + RT_UMAP, 0);
    store64(rec + RT_UCOUNT, 0);
    store64(rec + RT_STRIDE, stride);
    store64(rec + RT_SEQS, 0);
    store64(rec + RT_SEQCOUNT, 0);
    store64(rec + RT_SEQDATA, 0);
    vec_push(_rt_registry, rec);
    return KASHI_RT_FONT_BASE + vec_len(_rt_registry) - 1;
}

# Build the codepoint->glyph map for a runtime font from its PSF Unicode
# table (bytes [unioff, len) of `buf`, decoded per `kind`). Two passes: count
# single-codepoint mappings, then fill a {u64 codepoint, u64 glyph} pair
# array, insertion-sorted by codepoint, into RT_UMAP / RT_UCOUNT. Bounded by
# `len` and the glyph count; a malformed table just yields a shorter map,
# never a crash. Sequence entries (after a separator) are skipped. Internal.
fn _kashi_build_umap(rec, buf, len, kind, unioff) {
    var tok[24];
    var count = load64(rec + RT_COUNT);

    # Pass 1 — count single codepoints belonging to a real glyph.
    var n = 0;
    var pos = unioff;
    var glyph = 0;
    var inseq = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t = load64(&tok + KASHI_UT_TYPE);
        if (t == KASHI_TOK_END) { pos = len; }
        if (t != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t == KASHI_TOK_CP) {
                if (inseq == 0) {
                    if (glyph < count) { n = n + 1; }
                }
            }
            if (t == KASHI_TOK_SEQ) { inseq = 1; }
            if (t == KASHI_TOK_TERM) {
                glyph = glyph + 1;
                inseq = 0;
            }
        }
    }
    if (n == 0) { return 0; }

    var arr = alloc(n * 16);
    if (arr == 0) { return 0; }

    # Pass 2 — fill (codepoint, glyph) pairs.
    var w = 0;
    pos = unioff;
    glyph = 0;
    inseq = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t2 = load64(&tok + KASHI_UT_TYPE);
        if (t2 == KASHI_TOK_END) { pos = len; }
        if (t2 != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t2 == KASHI_TOK_CP) {
                if (inseq == 0) {
                    if (glyph < count) {
                        if (w < n) {
                            store64(arr + w * 16 + 0, load64(&tok + KASHI_UT_CP));
                            store64(arr + w * 16 + 8, glyph);
                            w = w + 1;
                        }
                    }
                }
            }
            if (t2 == KASHI_TOK_SEQ) { inseq = 1; }
            if (t2 == KASHI_TOK_TERM) {
                glyph = glyph + 1;
                inseq = 0;
            }
        }
    }

    # Insertion sort the w pairs by codepoint (ascending). w <= count <= 512.
    var i = 1;
    while (i < w) {
        var kc = load64(arr + i * 16 + 0);
        var kg = load64(arr + i * 16 + 8);
        var j = i;
        var done = 0;
        while (done == 0) {
            if (j == 0) { done = 1; }
            if (done == 0) {
                var cprev = load64(arr + (j - 1) * 16 + 0);
                if (cprev <= kc) { done = 1; }
                if (done == 0) {
                    store64(arr + j * 16 + 0, cprev);
                    store64(arr + j * 16 + 8, load64(arr + (j - 1) * 16 + 8));
                    j = j - 1;
                }
            }
        }
        store64(arr + j * 16 + 0, kc);
        store64(arr + j * 16 + 8, kg);
        i = i + 1;
    }

    store64(rec + RT_UMAP, arr);
    store64(rec + RT_UCOUNT, w);
    return 0;
}

# Build the sequence (ligature) list for a runtime font: walk the same PSF
# Unicode table that _kashi_build_umap consumes, this time harvesting
# multi-codepoint runs that follow a SEQ separator. Each sequence becomes
# one record `{cps_ptr, length, glyph}` (24 bytes) into RT_SEQS, with all
# codepoints packed into a single flat backing store (RT_SEQDATA). Two
# passes: count sequences + total codepoints, then alloc both and fill.
# Lookup is linear (sequences are typically few per font). Internal.
fn _kashi_build_useqs(rec, buf, len, kind, unioff) {
    var tok[24];
    var count = load64(rec + RT_COUNT);

    # Pass 1 — count sequences and total codepoint length.
    var nseqs = 0;
    var ntotal = 0;
    var pos = unioff;
    var glyph = 0;
    var inseq = 0;
    var curlen = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t = load64(&tok + KASHI_UT_TYPE);
        if (t == KASHI_TOK_END) { pos = len; }
        if (t != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t == KASHI_TOK_SEQ) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            nseqs = nseqs + 1;
                            ntotal = ntotal + curlen;
                        }
                    }
                }
                inseq = 1;
                curlen = 0;
            }
            if (t == KASHI_TOK_TERM) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            nseqs = nseqs + 1;
                            ntotal = ntotal + curlen;
                        }
                    }
                }
                glyph = glyph + 1;
                inseq = 0;
                curlen = 0;
            }
            if (t == KASHI_TOK_CP) {
                if (inseq == 1) { curlen = curlen + 1; }
            }
        }
    }
    if (nseqs == 0) { return 0; }

    var seqs = alloc(nseqs * 24);
    if (seqs == 0) { return 0; }
    var cps = alloc(ntotal * 8);
    if (cps == 0) { return 0; }

    # Pass 2 — fill records and the codepoint backing store.
    var w = 0;
    var wcps = 0;
    var curstart = 0;
    pos = unioff;
    glyph = 0;
    inseq = 0;
    curlen = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t2 = load64(&tok + KASHI_UT_TYPE);
        if (t2 == KASHI_TOK_END) { pos = len; }
        if (t2 != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t2 == KASHI_TOK_SEQ) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            if (w < nseqs) {
                                store64(seqs + w * 24 + 0, cps + curstart * 8);
                                store64(seqs + w * 24 + 8, curlen);
                                store64(seqs + w * 24 + 16, glyph);
                                w = w + 1;
                            }
                        }
                    }
                }
                inseq = 1;
                curstart = wcps;
                curlen = 0;
            }
            if (t2 == KASHI_TOK_TERM) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            if (w < nseqs) {
                                store64(seqs + w * 24 + 0, cps + curstart * 8);
                                store64(seqs + w * 24 + 8, curlen);
                                store64(seqs + w * 24 + 16, glyph);
                                w = w + 1;
                            }
                        }
                    }
                }
                glyph = glyph + 1;
                inseq = 0;
                curlen = 0;
            }
            if (t2 == KASHI_TOK_CP) {
                if (inseq == 1) {
                    if (wcps < ntotal) {
                        store64(cps + wcps * 8, load64(&tok + KASHI_UT_CP));
                        wcps = wcps + 1;
                        curlen = curlen + 1;
                    }
                }
            }
        }
    }

    store64(rec + RT_SEQS, seqs);
    store64(rec + RT_SEQCOUNT, w);
    store64(rec + RT_SEQDATA, cps);
    return 0;
}

# Resolve a codepoint to a glyph index for a runtime font record. With a
# Unicode map: binary search (returns 0 - 1 if the codepoint is unmapped).
# Without a map: identity (the codepoint as a raw index if in [0,count), else
# 0 - 1). Internal.
fn _kashi_rt_cp_to_glyph(rec, cp) {
    var umap = load64(rec + RT_UMAP);
    if (umap == 0) {
        var count = load64(rec + RT_COUNT);
        if (cp < 0) { return 0 - 1; }
        if (cp >= count) { return 0 - 1; }
        return cp;
    }
    var ucount = load64(rec + RT_UCOUNT);
    var lo = 0;
    var hi = ucount - 1;
    while (lo <= hi) {
        var mid = lo + (hi - lo) / 2;
        var mc = load64(umap + mid * 16 + 0);
        if (mc == cp) { return load64(umap + mid * 16 + 8); }
        if (mc < cp) { lo = mid + 1; }
        if (mc > cp) { hi = mid - 1; }
    }
    return 0 - 1;
}

# Register a runtime font from caller-supplied glyph data. width must be
# 1..32, height 1..32, glyph_count in [1, KASHI_PSF_MAX_COUNT]. Rows are
# ceil(width/8) bytes each (one byte per row for <= 8 wide). The glyph
# bytes are COPIED into a store the registry owns, so the caller may
# free/reuse its buffer afterward. Returns font_id (>= KASHI_RT_FONT_BASE)
# or `0 - KASHI_EINVAL`.
fn kashi_register_font(width, height, glyph_data, glyph_count) {
    if (width < 1) { return 0 - KASHI_EINVAL; }
    if (width > KASHI_PSF_MAX_WIDTH) { return 0 - KASHI_EINVAL; }
    if (height < 1) { return 0 - KASHI_EINVAL; }
    if (height > KASHI_PSF_MAX_HEIGHT) { return 0 - KASHI_EINVAL; }
    if (glyph_count < 1) { return 0 - KASHI_EINVAL; }
    # 0.6.0 audit F1: cap glyph_count at the same bound the PSF parser
    # enforces, otherwise `glyph_count * charsize` could overflow i64 for
    # an adversarial caller and the subsequent alloc/memcpy would walk off.
    if (glyph_count > KASHI_PSF_MAX_COUNT) { return 0 - KASHI_EINVAL; }
    if (glyph_data == 0) { return 0 - KASHI_EINVAL; }
    var stride = (width + 7) / 8;
    var charsize = height * stride;
    var nbytes = glyph_count * charsize;
    var owned = alloc(nbytes);
    if (owned == 0) { return 0 - KASHI_EINVAL; }
    memcpy(owned, glyph_data, nbytes);
    return _kashi_rt_register(width, height, glyph_count, charsize, owned);
}

# Load a PSF1/PSF2 font from an in-memory buffer into a runtime font slot.
# Validates via kashi_psf_parse, copies the glyph bytes into an owned store,
# and registers it. Returns font_id (>= 2) or `0 - <KashiResult>` on a
# malformed / unsupported / truncated font (so a caller can `if (id < 0)`).
fn kashi_load_psf(buf, len) {
    var hdr[56];
    var rc = kashi_psf_parse(buf, len, &hdr);
    if (rc != KASHI_OK) { return 0 - rc; }
    var width = load64(&hdr + KASHI_PH_WIDTH);
    var height = load64(&hdr + KASHI_PH_HEIGHT);
    var count = load64(&hdr + KASHI_PH_COUNT);
    var charsize = load64(&hdr + KASHI_PH_CHARSIZE);
    var dataoff = load64(&hdr + KASHI_PH_DATAOFF);
    var unioff = load64(&hdr + KASHI_PH_UNIOFF);
    var kind = load64(&hdr + KASHI_PH_KIND);
    var nbytes = count * charsize;
    var owned = alloc(nbytes);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    memcpy(owned, buf + dataoff, nbytes);
    var id = _kashi_rt_register(width, height, count, charsize, owned);
    if (id < 0) { return id; }
    # If the font carried a Unicode table, build its codepoint->glyph map so
    # the unified accessors can address this font by codepoint.
    if (unioff != 0) {
        var rec = _kashi_rt_get(id);
        if (rec != 0) {
            _kashi_build_umap(rec, buf, len, kind, unioff);
            _kashi_build_useqs(rec, buf, len, kind, unioff);
        }
    }
    return id;
}

# Load a PSF font from a file path. Reads the file into a capped buffer
# (256 KiB — ample for any console font; larger is rejected) and hands it to
# kashi_load_psf. Returns font_id (>= 2) or `0 - <KashiResult>`.
fn kashi_load_psf_file(path) {
    var cap = 262144;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0 - KASHI_EINVAL; }      # open/read error
    if (n == 0) { return 0 - KASHI_EFORMAT; }    # empty / not found
    return kashi_load_psf(buf, n);
}

# --- BDF import (0.7.0; ADR 0008) ---
#
# Load an X11 BDF (Bitmap Distribution Format) font from an in-memory
# buffer into a runtime slot. The pure parser lives in src/font_bdf.cyr;
# this routine drives it glyph-by-glyph, copying each glyph's bitmap into
# an owned glyph store and collecting (codepoint, glyph) pairs for the
# codepoint→glyph map. ENCODING -1 glyphs are skipped (ADR 0008).
# Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.

# Translate a BDF-parser result code into the public KashiResult negative-form.
fn _kashi_bdf_to_result(rc) {
    if (rc == KASHI_BDF_OK) { return KASHI_OK; }
    if (rc == KASHI_BDF_EINVAL) { return KASHI_EINVAL; }
    return KASHI_EFORMAT;
}

fn kashi_load_bdf(buf, len) {
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }

    var hdr[56];
    var ctx[32];
    var rc = kashi_bdf_parse_header(buf, len, &hdr, &ctx);
    if (rc != KASHI_BDF_OK) { return 0 - _kashi_bdf_to_result(rc); }

    var width = load64(&hdr + BDF_PH_WIDTH);
    var height = load64(&hdr + BDF_PH_HEIGHT);
    var count = load64(&hdr + BDF_PH_COUNT);
    var charsize = load64(&hdr + BDF_PH_CHARSIZE);
    var dataoff = load64(&hdr + BDF_PH_DATAOFF);

    # Single-pass over-allocate to the declared count (the upper bound) and
    # write each OK glyph into its slot; SKIP glyphs land in a scratch slot
    # and are discarded. Trailing unused space stays in the owned buffer —
    # harmless waste bounded by KASHI_BDF_MAX_COUNT * 128.
    var owned = alloc(count * charsize);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    var umap = alloc(count * 16);
    if (umap == 0) { return 0 - KASHI_EFORMAT; }

    # Stack scratch for SKIP rows and for the "CHARS was a lie (too low)"
    # detection path. 128 bytes = max charsize (32*4) per ADR 0005.
    var scratch[128];

    var gout[24];
    var pos = dataoff;
    var w = 0;
    var loop_done = 0;
    var err = 0;
    while (loop_done == 0) {
        var slot = &scratch;
        if (w < count) { slot = owned + w * charsize; }
        var grc = kashi_bdf_next_glyph(buf, pos, len, &ctx, slot, charsize, &gout);
        if (grc != KASHI_BDF_OK) { err = 1; loop_done = 1; }
        if (loop_done == 0) {
            var kind = load64(&gout + BG_KIND);
            if (kind == BG_KIND_END) { loop_done = 1; }
            if (loop_done == 0) {
                pos = load64(&gout + BG_NEXT);
                if (kind == BG_KIND_OK) {
                    if (w >= count) { err = 1; loop_done = 1; }
                    if (loop_done == 0) {
                        var cp = load64(&gout + BG_CP);
                        store64(umap + w * 16 + 0, cp);
                        store64(umap + w * 16 + 8, w);
                        w = w + 1;
                    }
                }
            }
        }
    }
    if (err == 1) { return 0 - KASHI_EFORMAT; }
    if (w == 0) { return 0 - KASHI_EFORMAT; }

    # Insertion-sort the codepoint→glyph map (same shape as PSF — kept here
    # rather than factored because the PSF version walks the parser
    # directly; sharing is fiddly without a third helper).
    var i = 1;
    while (i < w) {
        var kc = load64(umap + i * 16 + 0);
        var kg = load64(umap + i * 16 + 8);
        var j = i;
        var sdone = 0;
        while (sdone == 0) {
            if (j == 0) { sdone = 1; }
            if (sdone == 0) {
                var cprev = load64(umap + (j - 1) * 16 + 0);
                if (cprev <= kc) { sdone = 1; }
                if (sdone == 0) {
                    store64(umap + j * 16 + 0, cprev);
                    store64(umap + j * 16 + 8, load64(umap + (j - 1) * 16 + 8));
                    j = j - 1;
                }
            }
        }
        store64(umap + j * 16 + 0, kc);
        store64(umap + j * 16 + 8, kg);
        i = i + 1;
    }

    var id = _kashi_rt_register(width, height, w, charsize, owned);
    if (id < 0) { return id; }
    var rec = _kashi_rt_get(id);
    if (rec != 0) {
        store64(rec + RT_UMAP, umap);
        store64(rec + RT_UCOUNT, w);
    }
    return id;
}

# Load a BDF font from a file path. Reads the file into a capped buffer
# (KASHI_BDF_FILE_CAP = 4 MiB — ADR 0008) and hands it to kashi_load_bdf.
# Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.
fn kashi_load_bdf_file(path) {
    var cap = KASHI_BDF_FILE_CAP;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0 - KASHI_EINVAL; }
    if (n == 0) { return 0 - KASHI_EFORMAT; }
    return kashi_load_bdf(buf, n);
}

# --- PCF import (0.7.1; ADR 0009) ---
#
# X11 compiled bitmap format. The pure parser lives in src/font_pcf.cyr;
# this routine drives it: parse header, decode every glyph in source
# order, then walk the BDF_ENCODINGS range to build the codepoint→glyph
# map. Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.

fn _kashi_pcf_to_result(rc) {
    if (rc == KASHI_PCF_OK) { return KASHI_OK; }
    if (rc == KASHI_PCF_EINVAL) { return KASHI_EINVAL; }
    return KASHI_EFORMAT;
}

fn kashi_load_pcf(buf, len) {
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }

    var hdr[56];
    var ctx[144];
    var rc = kashi_pcf_parse_header(buf, len, &hdr, &ctx);
    if (rc != KASHI_PCF_OK) { return 0 - _kashi_pcf_to_result(rc); }

    var width = load64(&hdr + PCF_PH_WIDTH);
    var height = load64(&hdr + PCF_PH_HEIGHT);
    var count = load64(&hdr + PCF_PH_COUNT);
    var charsize = load64(&hdr + PCF_PH_CHARSIZE);

    # Decode every glyph in source order. The runtime store mirrors the
    # PCF's glyph index space; the cp-map below maps codepoints to those
    # same indices (multiple cps can map to the same glyph index).
    var owned = alloc(count * charsize);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    var g = 0;
    while (g < count) {
        var grc = kashi_pcf_decode_glyph(buf, &ctx, g, owned + g * charsize, charsize);
        if (grc != KASHI_PCF_OK) { return 0 - KASHI_EFORMAT; }
        g = g + 1;
    }

    # Walk the encoded codepoint range, collect (cp, glyph_idx) pairs.
    # Worst case is range_b1 * range_b2 entries (≤ 65536 for plane-0 BMP).
    var min_b1 = load64(&ctx + PCF_CTX_MIN_B1);
    var max_b1 = load64(&ctx + PCF_CTX_MAX_B1);
    var min_b2 = load64(&ctx + PCF_CTX_MIN_B2);
    var max_b2 = load64(&ctx + PCF_CTX_MAX_B2);
    var range_b1 = max_b1 - min_b1 + 1;
    var range_b2 = max_b2 - min_b2 + 1;
    var max_entries = range_b1 * range_b2;
    var umap = alloc(max_entries * 16);
    if (umap == 0) { return 0 - KASHI_EFORMAT; }

    var w = 0;
    var b1 = min_b1;
    while (b1 <= max_b1) {
        var b2 = min_b2;
        while (b2 <= max_b2) {
            var cp = (b1 << 8) | b2;
            var idx = kashi_pcf_cp_to_idx(buf, &ctx, cp);
            if (idx >= 0) {
                if (w < max_entries) {
                    store64(umap + w * 16 + 0, cp);
                    store64(umap + w * 16 + 8, idx);
                    w = w + 1;
                }
            }
            b2 = b2 + 1;
        }
        b1 = b1 + 1;
    }
    if (w == 0) { return 0 - KASHI_EFORMAT; }

    # Insertion-sort by codepoint (same shape as the PSF / BDF cp-map).
    var i = 1;
    while (i < w) {
        var kc = load64(umap + i * 16 + 0);
        var kg = load64(umap + i * 16 + 8);
        var j = i;
        var sdone = 0;
        while (sdone == 0) {
            if (j == 0) { sdone = 1; }
            if (sdone == 0) {
                var cprev = load64(umap + (j - 1) * 16 + 0);
                if (cprev <= kc) { sdone = 1; }
                if (sdone == 0) {
                    store64(umap + j * 16 + 0, cprev);
                    store64(umap + j * 16 + 8, load64(umap + (j - 1) * 16 + 8));
                    j = j - 1;
                }
            }
        }
        store64(umap + j * 16 + 0, kc);
        store64(umap + j * 16 + 8, kg);
        i = i + 1;
    }

    var id = _kashi_rt_register(width, height, count, charsize, owned);
    if (id < 0) { return id; }
    var rec = _kashi_rt_get(id);
    if (rec != 0) {
        store64(rec + RT_UMAP, umap);
        store64(rec + RT_UCOUNT, w);
    }
    return id;
}

# Load a PCF font from a file path. Reads up to KASHI_PCF_FILE_CAP
# (4 MiB) bytes and hands the buffer to kashi_load_pcf.
fn kashi_load_pcf_file(path) {
    var cap = KASHI_PCF_FILE_CAP;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0 - KASHI_EINVAL; }
    if (n == 0) { return 0 - KASHI_EFORMAT; }
    return kashi_load_pcf(buf, n);
}

# --- Sidecar Unicode table attachment (0.7.2; ADR 0010) ---
#
# Attach an externally-supplied codepoint→glyph mapping to an
# already-loaded runtime font. Two source formats:
#   * Binary — raw PSF1 (LE-u16) or PSF2 (UTF-8) Unicode-table bytes
#     (the format psfaddtable / psfgettable emit when the PSF carries
#     no inline table). Reuses _kashi_build_umap + _kashi_build_useqs.
#   * Text — psfgettable-style: one line per glyph,
#     "0x<hex_idx>  U+<hex_cp> [U+<hex_cp> ...]   # comment".
#
# Replace semantics: any existing umap/seqs on the runtime record are
# overwritten (the previous allocations leak-conceptually; the bump
# allocator reclaims at process exit). Built-in fonts return
# KASHI_EINVAL — attach is for runtime ids (≥ KASHI_RT_FONT_BASE) only.
# Returns KASHI_OK or `0 - <KashiResult>`.

# Tab file-size cap (matches the existing PSF cap).
enum KashiTabCap {
    KASHI_TAB_FILE_CAP = 262144;
}

# --- Text-tab parser primitives (internal) ---

fn _kashi_tab_ws(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            var c = load8(buf + pos);
            if (c == 0x20) { pos = pos + 1; }
            if (c == 0x09) { pos = pos + 1; }
            if (c != 0x20) {
                if (c != 0x09) { done = 1; }
            }
        }
    }
    return pos;
}

fn _kashi_tab_eol(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            if (load8(buf + pos) == 0x0A) { done = 1; }
            if (done == 0) { pos = pos + 1; }
        }
    }
    return pos;
}

fn _kashi_tab_next_line(buf, pos, end) {
    var e = _kashi_tab_eol(buf, pos, end);
    if (e < end) { return e + 1; }
    return end;
}

# Check whether buf[pos..pos+2] equals (p0, p1). Returns 1 if yes.
fn _kashi_tab_pfx2(buf, pos, end, p0, p1) {
    if (pos + 2 > end) { return 0; }
    if (load8(buf + pos) != p0) { return 0; }
    if (load8(buf + pos + 1) != p1) { return 0; }
    return 1;
}

# Parse a hex integer at pos (no prefix; just hex digits). Writes
# value at out + 0, post-position at out + 8. Returns 1 on success,
# 0 on no-digits. Caps consumed digits at 12 to keep i64 safe.
fn _kashi_tab_hex(buf, pos, end, out) {
    store64(out + 0, 0);
    store64(out + 8, pos);
    var start = pos;
    var n = 0;
    var digits = 0;
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            if (digits >= 12) { done = 1; }
            if (done == 0) {
                var c = load8(buf + pos);
                var d = 0 - 1;
                if (c >= 0x30) {
                    if (c <= 0x39) { d = c - 0x30; }
                }
                if (c >= 0x41) {
                    if (c <= 0x46) { d = c - 0x41 + 10; }
                }
                if (c >= 0x61) {
                    if (c <= 0x66) { d = c - 0x61 + 10; }
                }
                if (d < 0) { done = 1; }
                if (done == 0) {
                    n = (n << 4) | d;
                    pos = pos + 1;
                    digits = digits + 1;
                }
            }
        }
    }
    if (pos == start) { return 0; }
    store64(out + 0, n);
    store64(out + 8, pos);
    return 1;
}

# Text-tab parser. Walks `buf[0..len]`, parses each non-blank /
# non-comment line as "0x<idx>  U+<cp> [U+<cp> ...]  # comment".
# Builds the (cp, glyph_idx) pair array, sorts, attaches to `rec`.
# Returns KASHI_OK on success, KASHI_EFORMAT on syntax error or
# zero valid pairs. Internal.
fn _kashi_attach_text_impl(rec, buf, len) {
    var count = load64(rec + RT_COUNT);
    var pair[16];

    # Pass 1: count valid (cp, idx) pairs.
    var n = 0;
    var p = 0;
    while (p < len) {
        var le = _kashi_tab_eol(buf, p, len);
        var ls = _kashi_tab_ws(buf, p, le);
        if (ls < le) {
            var c0 = load8(buf + ls);
            if (c0 != 0x23) {
                # 0x or 0X prefix required.
                var is_0x = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x78);
                var is_0X = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x58);
                if (is_0x + is_0X == 0) { return KASHI_EFORMAT; }
                if (_kashi_tab_hex(buf, ls + 2, le, &pair) == 0) {
                    return KASHI_EFORMAT;
                }
                var glyph = load64(&pair + 0);
                var q = load64(&pair + 8);
                q = _kashi_tab_ws(buf, q, le);
                var more = 1;
                while (more == 1) {
                    if (q >= le) { more = 0; }
                    if (more == 1) {
                        var cc = load8(buf + q);
                        if (cc == 0x23) { more = 0; }
                        if (more == 1) {
                            if (_kashi_tab_pfx2(buf, q, le, 0x55, 0x2B) == 0) {
                                return KASHI_EFORMAT;
                            }
                            if (_kashi_tab_hex(buf, q + 2, le, &pair) == 0) {
                                return KASHI_EFORMAT;
                            }
                            q = load64(&pair + 8);
                            if (glyph < count) { n = n + 1; }
                            q = _kashi_tab_ws(buf, q, le);
                        }
                    }
                }
            }
        }
        p = _kashi_tab_next_line(buf, p, len);
    }
    if (n == 0) { return KASHI_EFORMAT; }

    # Pass 2: alloc and fill.
    var arr = alloc(n * 16);
    if (arr == 0) { return KASHI_EFORMAT; }
    var w = 0;
    p = 0;
    while (p < len) {
        var le = _kashi_tab_eol(buf, p, len);
        var ls = _kashi_tab_ws(buf, p, le);
        if (ls < le) {
            var c0 = load8(buf + ls);
            if (c0 != 0x23) {
                var is_0x2 = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x78);
                var is_0X2 = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x58);
                if (is_0x2 + is_0X2 == 0) { return KASHI_EFORMAT; }
                if (_kashi_tab_hex(buf, ls + 2, le, &pair) == 0) {
                    return KASHI_EFORMAT;
                }
                var glyph = load64(&pair + 0);
                var q = load64(&pair + 8);
                q = _kashi_tab_ws(buf, q, le);
                var more = 1;
                while (more == 1) {
                    if (q >= le) { more = 0; }
                    if (more == 1) {
                        var cc = load8(buf + q);
                        if (cc == 0x23) { more = 0; }
                        if (more == 1) {
                            if (_kashi_tab_pfx2(buf, q, le, 0x55, 0x2B) == 0) {
                                return KASHI_EFORMAT;
                            }
                            if (_kashi_tab_hex(buf, q + 2, le, &pair) == 0) {
                                return KASHI_EFORMAT;
                            }
                            var cp = load64(&pair + 0);
                            q = load64(&pair + 8);
                            if (glyph < count) {
                                if (w < n) {
                                    store64(arr + w * 16 + 0, cp);
                                    store64(arr + w * 16 + 8, glyph);
                                    w = w + 1;
                                }
                            }
                            q = _kashi_tab_ws(buf, q, le);
                        }
                    }
                }
            }
        }
        p = _kashi_tab_next_line(buf, p, len);
    }

    # Insertion-sort the pairs by codepoint (same shape as PSF / PCF /
    # BDF maps so binary-search at lookup time works).
    var i = 1;
    while (i < w) {
        var kc = load64(arr + i * 16 + 0);
        var kg = load64(arr + i * 16 + 8);
        var j = i;
        var sdone = 0;
        while (sdone == 0) {
            if (j == 0) { sdone = 1; }
            if (sdone == 0) {
                var cprev = load64(arr + (j - 1) * 16 + 0);
                if (cprev <= kc) { sdone = 1; }
                if (sdone == 0) {
                    store64(arr + j * 16 + 0, cprev);
                    store64(arr + j * 16 + 8, load64(arr + (j - 1) * 16 + 8));
                    j = j - 1;
                }
            }
        }
        store64(arr + j * 16 + 0, kc);
        store64(arr + j * 16 + 8, kg);
        i = i + 1;
    }

    # Replace any existing umap + seqs (text format carries no sequences).
    store64(rec + RT_UMAP, arr);
    store64(rec + RT_UCOUNT, w);
    store64(rec + RT_SEQS, 0);
    store64(rec + RT_SEQCOUNT, 0);
    store64(rec + RT_SEQDATA, 0);
    return KASHI_OK;
}

# --- Public attach APIs ---

# Attach a binary PSF Unicode table to a runtime font. `kind` is
# KASHI_PSF_KIND_PSF1 (LE-u16) or KASHI_PSF_KIND_PSF2 (UTF-8).
# Replaces any existing umap/seqs. Returns KASHI_OK or `0 - <code>`.
fn kashi_attach_unicode_table(font_id, buf, len, kind) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - KASHI_EINVAL; }
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }
    if (kind != KASHI_PSF_KIND_PSF1) {
        if (kind != KASHI_PSF_KIND_PSF2) { return 0 - KASHI_EINVAL; }
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - KASHI_EINVAL; }

    # 0.8.0 audit F9 (CVE-2015-1803 stale-state-after-parse-error
    # pattern): snapshot the existing umap/seqs before clearing. If the
    # new table produces nothing, restore the previous state — a failed
    # attach must not silently strip the font's existing Unicode map.
    var prev_umap = load64(rec + RT_UMAP);
    var prev_ucount = load64(rec + RT_UCOUNT);
    var prev_seqs = load64(rec + RT_SEQS);
    var prev_seqcount = load64(rec + RT_SEQCOUNT);
    var prev_seqdata = load64(rec + RT_SEQDATA);

    store64(rec + RT_UMAP, 0);
    store64(rec + RT_UCOUNT, 0);
    store64(rec + RT_SEQS, 0);
    store64(rec + RT_SEQCOUNT, 0);
    store64(rec + RT_SEQDATA, 0);

    _kashi_build_umap(rec, buf, len, kind, 0);
    _kashi_build_useqs(rec, buf, len, kind, 0);
    if (load64(rec + RT_UCOUNT) == 0) {
        if (load64(rec + RT_SEQCOUNT) == 0) {
            store64(rec + RT_UMAP, prev_umap);
            store64(rec + RT_UCOUNT, prev_ucount);
            store64(rec + RT_SEQS, prev_seqs);
            store64(rec + RT_SEQCOUNT, prev_seqcount);
            store64(rec + RT_SEQDATA, prev_seqdata);
            return 0 - KASHI_EFORMAT;
        }
    }
    return KASHI_OK;
}

# File companion for kashi_attach_unicode_table. Reads at most 256 KiB.
fn kashi_attach_unicode_table_file(font_id, path, kind) {
    var cap = KASHI_TAB_FILE_CAP;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0 - KASHI_EINVAL; }
    if (n == 0) { return 0 - KASHI_EFORMAT; }
    return kashi_attach_unicode_table(font_id, buf, n, kind);
}

# Attach a text-format Unicode table (psfgettable convention).
fn kashi_attach_unicode_text(font_id, buf, len) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - KASHI_EINVAL; }
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - KASHI_EINVAL; }
    var rc = _kashi_attach_text_impl(rec, buf, len);
    if (rc == KASHI_OK) { return KASHI_OK; }
    return 0 - rc;
}

# File companion for kashi_attach_unicode_text. Reads at most 256 KiB.
fn kashi_attach_unicode_text_file(font_id, path) {
    var cap = KASHI_TAB_FILE_CAP;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0 - KASHI_EINVAL; }
    if (n == 0) { return 0 - KASHI_EFORMAT; }
    return kashi_attach_unicode_text(font_id, buf, n);
}

# --- Raw glyph-INDEX accessors (runtime fonts only) ---

# Base pointer to runtime-font glyph `idx`'s row bytes (idx in [0,count)).
# No codepoint mapping — for tooling / enumeration / table-less fonts.
# Returns 0 for an unknown runtime font or out-of-range index. (Built-in
# fonts have no separate index space; use kashi_glyph_ptr for those.)
fn kashi_rt_glyph_ptr(font_id, idx) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    if (idx < 0) { return 0; }
    var count = load64(rec + RT_COUNT);
    if (idx >= count) { return 0; }
    var charsize = load64(rec + RT_CHARSIZE);
    var data = load64(rec + RT_DATA);
    return data + idx * charsize;
}

# One row byte of runtime-font glyph `idx` (bit 7 = leftmost). For wide
# fonts (stride > 1) this returns the LEADING byte of the row (byte_idx 0);
# use kashi_rt_glyph_row_byte for the other bytes. Returns 0 for an unknown
# runtime font, out-of-range index, or out-of-range row.
fn kashi_rt_glyph_row(font_id, idx, row) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var height = load64(rec + RT_HEIGHT);
    if (row < 0) { return 0; }
    if (row >= height) { return 0; }
    var base = kashi_rt_glyph_ptr(font_id, idx);
    if (base == 0) { return 0; }
    var stride = load64(rec + RT_STRIDE);
    return load8(base + row * stride);
}

# One row byte at column-byte position `byte_idx` for runtime-font glyph
# `idx`. Multi-byte-aware sibling of kashi_rt_glyph_row. Returns 0 for any
# out-of-range input (unknown font, bad idx/row/byte_idx). Added in 0.5.0.
fn kashi_rt_glyph_row_byte(font_id, idx, row, byte_idx) {
    if (byte_idx < 0) { return 0; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var stride = load64(rec + RT_STRIDE);
    if (byte_idx >= stride) { return 0; }
    var height = load64(rec + RT_HEIGHT);
    if (row < 0) { return 0; }
    if (row >= height) { return 0; }
    var base = kashi_rt_glyph_ptr(font_id, idx);
    if (base == 0) { return 0; }
    return load8(base + row * stride + byte_idx);
}

# --- Unified, CODEPOINT-addressed accessors: built-in (0,1) vs runtime (>=2) ---

# Base pointer to a glyph's row bytes for ANY font, addressed by codepoint.
# Built-ins: `cp` is an ASCII codepoint (0x20..0x7F). Runtime: `cp` resolved
# via the font's Unicode map, or treated as a raw glyph index if the font
# carried no table. Returns 0 (null) for an unknown font or unmapped cp.
fn kashi_font_ptr(font_id, cp) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_ptr(font_id, cp);
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_ptr(font_id, idx);
}

# One row byte of a glyph for ANY font, addressed by codepoint (see
# kashi_font_ptr). For wide fonts (stride > 1) this is the LEADING byte;
# use kashi_font_row_byte for the other bytes. Returns 0 for an unknown
# font, unmapped cp, or bad row.
fn kashi_font_row(font_id, cp, row) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_row(font_id, cp, row);
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_row(font_id, idx, row);
}

# Multi-byte-aware row accessor for ANY font, addressed by codepoint.
# `byte_idx` 0 is the leftmost 8 px, then 8..15, etc. For stride-1 fonts
# only byte_idx 0 is meaningful. Bounds-safe across the full input domain.
# Added in 0.5.0 (ADR 0005).
fn kashi_font_row_byte(font_id, cp, row, byte_idx) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_row_byte(font_id, cp, row, byte_idx);
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_row_byte(font_id, idx, row, byte_idx);
}

# Runtime-font metadata (ids >= 2). Unknown id -> 0.
fn kashi_rt_font_width(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + RT_WIDTH);
}

fn kashi_rt_font_height(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + RT_HEIGHT);
}

fn kashi_rt_font_count(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + RT_COUNT);
}

# Bytes per row for a runtime font (= ceil(width/8)). Mirrors the core's
# kashi_font_stride for built-ins. Added in 0.5.0. Unknown id -> 0.
fn kashi_rt_font_stride(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + RT_STRIDE);
}

# PSF ligature lookup: given a sequence of `len` codepoints (each a u64 at
# `cps_ptr + i*8`), return the glyph index of the matching ligature in
# `font_id`, or `0 - 1` if there's no match (incl. built-in ids, fonts
# without a sequence table, null inputs, or non-positive `len`). Linear
# scan — sequences are typically few per font. Added in 0.5.0 (ADR 0005).
fn kashi_font_seq_glyph(font_id, cps_ptr, len) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - 1; }
    if (cps_ptr == 0) { return 0 - 1; }
    if (len < 1) { return 0 - 1; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - 1; }
    var seqs = load64(rec + RT_SEQS);
    if (seqs == 0) { return 0 - 1; }
    var seqcount = load64(rec + RT_SEQCOUNT);
    var i = 0;
    while (i < seqcount) {
        var rec_len = load64(seqs + i * 24 + 8);
        if (rec_len == len) {
            var rec_cps = load64(seqs + i * 24 + 0);
            var eq = 1;
            var j = 0;
            while (j < len) {
                if (load64(rec_cps + j * 8) != load64(cps_ptr + j * 8)) { eq = 0; }
                j = j + 1;
            }
            if (eq == 1) { return load64(seqs + i * 24 + 16); }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Number of fonts kashi currently knows: the three freestanding built-ins
# (VGA 8x16, CGA 8x8, VGA 9x16) plus every runtime-registered font. Font
# ids are dense `[0, kashi_font_total())`, so enumeration is a plain
# `for id in 0..total` loop through the existing accessors.
fn kashi_font_total() {
    if (_rt_registry == 0) { return 3; }
    return 3 + vec_len(_rt_registry);
}

# --- Active-font knob (M2 registry nicety) ---
#
# A console (or any consumer with the concept of a "current font") can stash
# its selection here instead of plumbing the id everywhere. Defaults to 0 (the
# VGA 8x16 built-in). Purely additive — the accessors never consult this; the
# consumer reads it and passes the id to kashi_font_ptr/row themselves.
var _kashi_active_font = 0;

# Set the active font_id. Returns KASHI_OK or `0 - KASHI_EINVAL` for an id
# outside `[0, kashi_font_total())`.
fn kashi_set_active_font(font_id) {
    if (font_id < 0) { return 0 - KASHI_EINVAL; }
    if (font_id >= kashi_font_total()) { return 0 - KASHI_EINVAL; }
    _kashi_active_font = font_id;
    return KASHI_OK;
}

# Read the active font_id (default 0 = VGA 8x16).
fn kashi_active_font() {
    return _kashi_active_font;
}
