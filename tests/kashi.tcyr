# kashi — integration test suite (cross-module behavior).
# Stdlib auto-included via cyrius.cyml. The src/test.cyr entry holds the
# bulk of the unit assertions; this file exercises the public surface the
# way a consumer would: init once, then iterate the whole glyph range and
# check structural invariants that span the two fonts.

include "src/lib.cyr"

# Count set bits in one glyph row byte (population count over 8 bits).
fn popcount8(b) {
    var n = 0;
    var i = 0;
    while (i < 8) {
        if ((b & (1 << i)) != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Total set pixels across a whole glyph (sum of popcounts over its rows).
fn glyph_ink(font_id, ch) {
    var h = kashi_font_height(font_id);
    var total = 0;
    var row = 0;
    while (row < h) {
        total = total + popcount8(kashi_glyph_row(font_id, ch, row));
        row = row + 1;
    }
    return total;
}

# Invariant: a font's render width is 8, so no glyph row can have a set bit
# outside the low 8 bits. (kashi_glyph_row returns a single byte, but verify
# the value really is byte-bounded.)
fn test_row_byte_bounded() {
    test_group("row byte-bounded");
    var ch = 0x20;
    var ok = 1;
    while (ch <= 0xFF) {
        var row = 0;
        while (row < 16) {
            if (kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, row) > 0xFF) { ok = 0; }
            row = row + 1;
        }
        ch = ch + 1;
    }
    assert_eq(ok, 1, "all vga rows <= 0xFF");
    return 0;
}

# Invariant: SPACE (0x20) is blank ink in BOTH fonts; a visible glyph like
# 'M' (0x4D) has ink in both. This catches a whole-table off-by-one in the
# (ch - first) index math (which would shift every glyph by one slot).
fn test_space_vs_visible() {
    test_group("space vs visible");
    assert_eq(glyph_ink(KASHI_FONT_VGA_8X16, 0x20), 0, "vga space no ink");
    assert_eq(glyph_ink(KASHI_FONT_CGA_8X8, 0x20), 0, "cga space no ink");
    assert_gt(glyph_ink(KASHI_FONT_VGA_8X16, 0x4D), 0, "vga M has ink");
    assert_gt(glyph_ink(KASHI_FONT_CGA_8X8, 0x4D), 0, "cga M has ink");
    # 'M' is a dense glyph; both fonts should carry substantial ink.
    assert_gt(glyph_ink(KASHI_FONT_VGA_8X16, 0x4D), 20, "vga M dense");
    assert_gt(glyph_ink(KASHI_FONT_CGA_8X8, 0x4D), 15, "cga M dense");
    return 0;
}

# Invariant: the index math is monotone — glyph N's pointer is exactly one
# glyph-height past glyph N-1's, across the full range, for both fonts.
fn test_pointer_monotone() {
    test_group("pointer monotone");
    var ok16 = 1;
    var ok8 = 1;
    var ch = 0x21;
    while (ch <= 0xFF) {
        var prev16 = kashi_glyph_ptr(KASHI_FONT_VGA_8X16, ch - 1);
        var cur16 = kashi_glyph_ptr(KASHI_FONT_VGA_8X16, ch);
        if (cur16 - prev16 != 16) { ok16 = 0; }
        var prev8 = kashi_glyph_ptr(KASHI_FONT_CGA_8X8, ch - 1);
        var cur8 = kashi_glyph_ptr(KASHI_FONT_CGA_8X8, ch);
        if (cur8 - prev8 != 8) { ok8 = 0; }
        ch = ch + 1;
    }
    assert_eq(ok16, 1, "vga ptrs 16 apart");
    assert_eq(ok8, 1, "cga ptrs 8 apart");
    return 0;
}

# Re-init idempotency: calling kashi_font_init twice yields identical bytes.
fn test_reinit_idempotent() {
    test_group("reinit idempotent");
    var before = kashi_glyph_row(KASHI_FONT_VGA_8X16, 0x40, 7);
    kashi_font_init();
    var after = kashi_glyph_row(KASHI_FONT_VGA_8X16, 0x40, 7);
    assert_eq(before, after, "reinit stable");
    return 0;
}

# End-to-end PSF import: build a real PSF1 font, write it to a file, load it
# back via kashi_load_psf_file, and read glyph rows through the unified
# dispatcher — the way a userland consumer would. Exercises the parser,
# the io.file_read_all path, the glyph-store copy, and the registry.
# --- VGA 9x16 (id 2, 0.5.1, ADR 0006) — the 2-byte-stride built-in. Until
# 1.0.10 this suite exercised only the two 8-wide fonts. The 9x16 is DERIVED
# at init from the 8x16 plus the VGA col-9 rule, so its structure is fully
# checkable against font 0: leading byte == the 8x16 row, second byte ==
# col 9 (bit 7), which is a copy of col 8 for the box-drawing range
# 0xC0..0xDF and 0 everywhere else.
fn test_vga_9x16_structural() {
    test_group("vga 9x16 structural");
    assert_eq(kashi_font_stride(KASHI_FONT_VGA_9X16), 2, "9x16 stride 2");
    assert_eq(kashi_font_width(KASHI_FONT_VGA_9X16), 9, "9x16 width 9");
    assert_eq(kashi_font_height(KASHI_FONT_VGA_9X16), 16, "9x16 height 16");
    assert_eq(kashi_font_count(KASHI_FONT_VGA_9X16), 224, "9x16 count 224");

    var ok_ptr = 1;
    var ok_lead = 1;
    var ok_col9 = 1;
    var ok_past = 1;
    var ch = 0x20;
    while (ch <= 0xFF) {
        if (ch > 0x20) {
            var prev = kashi_glyph_ptr(KASHI_FONT_VGA_9X16, ch - 1);
            var cur = kashi_glyph_ptr(KASHI_FONT_VGA_9X16, ch);
            if (cur - prev != 32) { ok_ptr = 0; }
        }
        var row = 0;
        while (row < 16) {
            var b0 = kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ch, row, 0);
            var b1 = kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ch, row, 1);
            if (b0 != kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, row)) { ok_lead = 0; }
            if (b0 != kashi_glyph_row(KASHI_FONT_VGA_9X16, ch, row)) { ok_lead = 0; }
            var want1 = 0;
            if (ch >= 0xC0) {
                if (ch <= 0xDF) { want1 = (b0 & 1) << 7; }
            }
            if (b1 != want1) { ok_col9 = 0; }
            if (kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ch, row, 2) != 0) { ok_past = 0; }
            row = row + 1;
        }
        ch = ch + 1;
    }
    assert_eq(ok_ptr, 1, "9x16 ptrs 32 apart");
    assert_eq(ok_lead, 1, "9x16 leading byte == 8x16 row, via row and row_byte");
    assert_eq(ok_col9, 1, "9x16 col-9 rule holds across 0x20..0xFF");
    assert_eq(ok_past, 1, "9x16 byte_idx 2 is the sentinel");
    return 0;
}

# --- Unicode -> CP437 cell, and the extension block (1.1.0, ADR 0011) ---
#
# This suite keeps its OWN copy of the standard CP437 -> Unicode mapping of
# the high half (generated from Python's 'cp437' codec, i.e. the Unicode
# Consortium's CP437.TXT), separate from src/font_data.cyr's, so a
# transcription slip in either fails here. Slot i (one u64) holds the
# codepoint of cell 0x80 + i — module scope, so `[128]` is 128 u64 slots.
var _ti_cp437_uni[128];

fn _ti_cp437_row(cell, a, b, c, d, e, f, g, h) {
    var p = &_ti_cp437_uni + (cell - 0x80) * 8;
    store64(p, a);
    store64(p + 8, b);
    store64(p + 16, c);
    store64(p + 24, d);
    store64(p + 32, e);
    store64(p + 40, f);
    store64(p + 48, g);
    store64(p + 56, h);
    return 0;
}

fn _ti_cp437_fill() {
    _ti_cp437_row(0x80, 0x00C7, 0x00FC, 0x00E9, 0x00E2, 0x00E4, 0x00E0, 0x00E5, 0x00E7);
    _ti_cp437_row(0x88, 0x00EA, 0x00EB, 0x00E8, 0x00EF, 0x00EE, 0x00EC, 0x00C4, 0x00C5);
    _ti_cp437_row(0x90, 0x00C9, 0x00E6, 0x00C6, 0x00F4, 0x00F6, 0x00F2, 0x00FB, 0x00F9);
    _ti_cp437_row(0x98, 0x00FF, 0x00D6, 0x00DC, 0x00A2, 0x00A3, 0x00A5, 0x20A7, 0x0192);
    _ti_cp437_row(0xA0, 0x00E1, 0x00ED, 0x00F3, 0x00FA, 0x00F1, 0x00D1, 0x00AA, 0x00BA);
    _ti_cp437_row(0xA8, 0x00BF, 0x2310, 0x00AC, 0x00BD, 0x00BC, 0x00A1, 0x00AB, 0x00BB);
    _ti_cp437_row(0xB0, 0x2591, 0x2592, 0x2593, 0x2502, 0x2524, 0x2561, 0x2562, 0x2556);
    _ti_cp437_row(0xB8, 0x2555, 0x2563, 0x2551, 0x2557, 0x255D, 0x255C, 0x255B, 0x2510);
    _ti_cp437_row(0xC0, 0x2514, 0x2534, 0x252C, 0x251C, 0x2500, 0x253C, 0x255E, 0x255F);
    _ti_cp437_row(0xC8, 0x255A, 0x2554, 0x2569, 0x2566, 0x2560, 0x2550, 0x256C, 0x2567);
    _ti_cp437_row(0xD0, 0x2568, 0x2564, 0x2565, 0x2559, 0x2558, 0x2552, 0x2553, 0x256B);
    _ti_cp437_row(0xD8, 0x256A, 0x2518, 0x250C, 0x2588, 0x2584, 0x258C, 0x2590, 0x2580);
    _ti_cp437_row(0xE0, 0x03B1, 0x00DF, 0x0393, 0x03C0, 0x03A3, 0x03C3, 0x00B5, 0x03C4);
    _ti_cp437_row(0xE8, 0x03A6, 0x0398, 0x03A9, 0x03B4, 0x221E, 0x03C6, 0x03B5, 0x2229);
    _ti_cp437_row(0xF0, 0x2261, 0x00B1, 0x2265, 0x2264, 0x2320, 0x2321, 0x00F7, 0x2248);
    _ti_cp437_row(0xF8, 0x00B0, 0x2219, 0x00B7, 0x221A, 0x207F, 0x00B2, 0x25A0, 0x00A0);
    return 0;
}

# The codepoint kashi says CP437 cell `c` (0x20..0xFF) draws: ASCII is
# itself, 0x7F is U+2302 HOUSE (the ADR 0011 rule — the codec's U+007F
# DELETE is a control character), the high half per the table above.
fn _ti_cell_uni(c) {
    if (c < 0x7F) { return c; }
    if (c == 0x7F) { return 0x2302; }
    return load64(&_ti_cp437_uni + (c - 0x80) * 8);
}

# Rows `first`..`first + 7` of `cell` in `font_id` (leading bytes, through
# kashi_glyph_row) against eight expected rows packed like the source's
# literals (byte `packed >> 56` = row `first`). Returns how many differ.
fn _ti_rows8(font_id, cell, first, packed) {
    var bad = 0;
    var i = 0;
    while (i < 8) {
        var want = (packed >> (56 - i * 8)) & 0xFF;
        if (kashi_glyph_row(font_id, cell, first + i) != want) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

# FNV-1a 64 over every row byte of cells 0x20..0xFF of one font, in the
# glyph sheet's order (cell, row, byte), read through the byte-indexed
# accessor a byte-indexed consumer uses.
fn _ti_cp437_fnv(font_id) {
    var h = 0xCBF29CE484222325;
    var height = kashi_font_height(font_id);
    var stride = kashi_font_stride(font_id);
    var ch = KASHI_GLYPH_FIRST;
    while (ch <= KASHI_GLYPH_LAST) {
        var row = 0;
        while (row < height) {
            var b = 0;
            while (b < stride) {
                h = h ^ kashi_glyph_row_byte(font_id, ch, row, b);
                h = h * 0x100000001B3;
                b = b + 1;
            }
            row = row + 1;
        }
        ch = ch + 1;
    }
    return h;
}

# 1 + the first slot of the reverse index (kashi_cp437_rev, one u64 slot
# per entry: byte 0 = cp >> 8, byte 1 = cp & 0xFF, byte 2 = cell) whose
# codepoint is not strictly above the previous slot's, or whose cell is
# below 0x80; 0 when all 128 are in order. An unwritten slot reads as
# codepoint 0 and fails. Strict ascent is what the binary search needs.
fn _ti_rev_first_unsorted() {
    var prev = 0;
    var i = 0;
    while (i < 128) {
        var e = &kashi_cp437_rev + i * 8;
        var ecp = (load8(e) << 8) | load8(e + 1);
        if (ecp <= prev) { return i + 1; }
        if (load8(e + 2) < 0x80) { return i + 1; }
        prev = ecp;
        i = i + 1;
    }
    return 0;
}

# FNV-1a 64 over all 1 KiB of the reverse index's slots.
fn _ti_rev_fnv() {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < 1024) {
        h = h ^ load8(&kashi_cp437_rev + i);
        h = h * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# Before kashi_font_init the reverse index is empty: ASCII, U+2302 and the
# extension still resolve (pure arithmetic) and the high half answers 0,
# which the accessors render blank — the same "safe but blank" state every
# glyph is in before init. Runs from main() ahead of kashi_font_init.
fn test_cp437_preinit() {
    test_group("cp437 map before init");
    assert_eq(kashi_font_is_ready(), 0, "preinit: fonts not ready yet");
    assert_eq(kashi_cp437_from_unicode(0x41), 0x41, "preinit: ASCII resolves");
    assert_eq(kashi_cp437_from_unicode(0x2302), 0x7F, "preinit: U+2302 resolves");
    assert_eq(kashi_cp437_from_unicode(0x2026), KASHI_EXT_FIRST, "preinit: U+2026 resolves");
    assert_eq(kashi_cp437_from_unicode(0xE7), 0, "preinit: high half -> 0 (blank)");
    return 0;
}

fn test_cp437_map() {
    test_group("cp437 from unicode");
    _ti_cp437_fill();
    # Every CP437 cell 0x20..0xFF is reachable by its codepoint and lands on
    # itself (cell -> Unicode -> cell). first_bad names the first cell that
    # does not, so a failure points at the entry.
    var first_bad = 0;
    var c = KASHI_GLYPH_FIRST;
    while (c <= KASHI_GLYPH_LAST) {
        if (kashi_cp437_from_unicode(_ti_cell_uni(c)) != c) {
            if (first_bad == 0) { first_bad = c; }
        }
        c = c + 1;
    }
    assert_eq(first_bad, 0, "cell -> Unicode -> cell round trip, 0x20..0xFF (first bad cell)");
    # The confusions this mapping exists to stop.
    assert_eq(kashi_cp437_from_unicode(0xE7), 0x87, "U+00E7 c-cedilla -> 0x87 (not 0xE7)");
    assert_eq(kashi_cp437_from_unicode(0x3C4), 0xE7, "U+03C4 tau -> 0xE7");
    assert_eq(kashi_cp437_from_unicode(0x2500), 0xC4, "U+2500 light horizontal -> 0xC4");
    assert_eq(kashi_cp437_from_unicode(0x2588), 0xDB, "U+2588 full block -> 0xDB");
    assert_eq(kashi_cp437_from_unicode(0xC7), 0x80, "U+00C7 -> 0x80 (first high cell)");
    assert_eq(kashi_cp437_from_unicode(0xA0), 0xFF, "U+00A0 NBSP (lowest high-half cp) -> 0xFF");
    assert_eq(kashi_cp437_from_unicode(0x25A0), 0xFE, "U+25A0 black square (highest) -> 0xFE");
    var ascii_ok = 1;
    var a = 0x20;
    while (a <= 0x7E) {
        if (kashi_cp437_from_unicode(a) != a) { ascii_ok = 0; }
        a = a + 1;
    }
    assert_eq(ascii_ok, 1, "U+0020..U+007E -> themselves");
    # The 0x7F rule: cell 0x7F draws IBM's house, so U+2302 HOUSE reaches it;
    # U+007F DELETE is a control character and maps to nothing.
    assert_eq(kashi_cp437_from_unicode(0x2302), 0x7F, "U+2302 HOUSE -> 0x7F");
    assert_eq(kashi_cp437_from_unicode(0x7F), 0, "U+007F DELETE -> 0");
    assert_eq(kashi_cp437_from_unicode(0x2026), KASHI_EXT_FIRST, "U+2026 -> KASHI_EXT_FIRST");
    assert_eq(kashi_cp437_from_unicode(0xFFFD), KASHI_EXT_FIRST + 1, "U+FFFD -> KASHI_EXT_FIRST + 1");
    # The index is in binary-search order AS WRITTEN (init runs no sort), so
    # check the search's precondition on the table itself.
    assert_eq(kashi_cp437_n, 128, "reverse index holds 128 entries");
    assert_eq(_ti_rev_first_unsorted(), 0, "reverse index strictly ascending by codepoint (1 + first bad slot)");
    # A second kashi_font_init rewrites the index in place: same count, and
    # every byte the value that was already there.
    var rev_before = _ti_rev_fnv();
    kashi_font_init();
    assert_eq(kashi_cp437_n, 128, "re-init: reverse index still 128 entries");
    assert_eq(_ti_rev_fnv(), rev_before, "re-init: every reverse-index byte unchanged");
    assert_eq(kashi_cp437_from_unicode(0xE7), 0x87, "re-init: U+00E7 still -> 0x87");
    return 0;
}

fn test_cp437_unmapped() {
    test_group("cp437 unmapped -> 0");
    var ctl_ok = 1;
    var k = 0;
    while (k < 0x20) {
        if (kashi_cp437_from_unicode(k) != 0) { ctl_ok = 0; }
        k = k + 1;
    }
    k = 0x7F;
    while (k <= 0x9F) {
        if (kashi_cp437_from_unicode(k) != 0) { ctl_ok = 0; }
        k = k + 1;
    }
    assert_eq(ctl_ok, 1, "C0, DEL and C1 controls -> 0");
    assert_eq(kashi_cp437_from_unicode(0xC0), 0, "U+00C0 A-grave (not in CP437) -> 0");
    assert_eq(kashi_cp437_from_unicode(0xDB), 0, "U+00DB U-circumflex -> 0 (cell 0xDB is the block)");
    assert_eq(kashi_cp437_from_unicode(0x100), 0, "U+0100 -> 0 (cell 0x100 is not a codepoint)");
    assert_eq(kashi_cp437_from_unicode(0x101), 0, "U+0101 -> 0");
    assert_eq(kashi_cp437_from_unicode(0x3B2), 0, "U+03B2 beta -> 0 (0xE1 is sharp s)");
    assert_eq(kashi_cp437_from_unicode(0x263A), 0, "U+263A smiley -> 0 (cell 0x01 is not encoded)");
    assert_eq(kashi_cp437_from_unicode(0x2025), 0, "U+2025 two-dot leader -> 0");
    assert_eq(kashi_cp437_from_unicode(0x2027), 0, "U+2027 -> 0");
    assert_eq(kashi_cp437_from_unicode(0x25A1), 0, "U+25A1 (past the highest) -> 0");
    assert_eq(kashi_cp437_from_unicode(0xFFFC), 0, "U+FFFC -> 0");
    assert_eq(kashi_cp437_from_unicode(0xFFFE), 0, "U+FFFE -> 0");
    assert_eq(kashi_cp437_from_unicode(0x10FFFF), 0, "U+10FFFF -> 0");
    assert_eq(kashi_cp437_from_unicode(0x110000), 0, "past Unicode -> 0");
    assert_eq(kashi_cp437_from_unicode(0 - 1), 0, "negative -> 0");
    assert_eq(kashi_cp437_from_unicode(0x7FFFFFFFFFFFFFFF), 0, "i64 max -> 0");
    assert_eq(kashi_cp437_from_unicode(0 - 0x7FFFFFFFFFFFFFFF), 0, "i64 near-min -> 0");
    # Exhaustive over Unicode: exactly 226 codepoints have a built-in glyph
    # (95 ASCII + 128 high half + U+2302 + the 2 extension glyphs), and every
    # answer is a cell the accessors accept.
    var mapped = 0;
    var bad_cell = 0;
    var u = 0;
    while (u <= 0x10FFFF) {
        var cell = kashi_cp437_from_unicode(u);
        if (cell != 0) {
            mapped = mapped + 1;
            if (kashi_glyph_encoded(cell) == 0) { bad_cell = bad_cell + 1; }
        }
        u = u + 1;
    }
    assert_eq(mapped, 226, "exactly 226 codepoints in U+0000..U+10FFFF map");
    assert_eq(bad_cell, 0, "every mapped result is an encoded cell");
    return 0;
}

fn test_ext_glyphs() {
    test_group("extension glyphs");
    var ell = kashi_cp437_from_unicode(0x2026);
    var rep = kashi_cp437_from_unicode(0xFFFD);
    # VGA 8x16: '...' is the period's 2x2 dot three times (##.##.## on rows
    # 10-11, the rows '.' (0x2E) uses); U+FFFD the lozenge with a 5x7 '?'.
    assert_eq(kashi_glyph_row(KASHI_FONT_VGA_8X16, 0x2E, 10), 0x18, "vga '.' row10 is the 2x2 dot");
    assert_eq(_ti_rows8(KASHI_FONT_VGA_8X16, ell, 0, 0x0000000000000000), 0, "vga U+2026 rows 0-7");
    assert_eq(_ti_rows8(KASHI_FONT_VGA_8X16, ell, 8, 0x0000DBDB00000000), 0, "vga U+2026 rows 8-15");
    assert_eq(_ti_rows8(KASHI_FONT_VGA_8X16, rep, 0, 0x0010387CC6BAFAF6), 0, "vga U+FFFD rows 0-7");
    assert_eq(_ti_rows8(KASHI_FONT_VGA_8X16, rep, 8, 0xEEFEEE7C38100000), 0, "vga U+FFFD rows 8-15");
    # CGA 8x8: its '.' sits on rows 5-6; U+FFFD the octagon with a 3x5 '?'.
    assert_eq(kashi_glyph_row(KASHI_FONT_CGA_8X8, 0x2E, 5), 0x18, "cga '.' row5 is the 2x2 dot");
    assert_eq(_ti_rows8(KASHI_FONT_CGA_8X8, ell, 0, 0x0000000000DBDB00), 0, "cga U+2026 rows 0-7");
    assert_eq(_ti_rows8(KASHI_FONT_CGA_8X8, rep, 0, 0x3844F6EEFE6C3800), 0, "cga U+FFFD rows 0-7");
    # VGA 9x16 (derived, ADR 0006): byte 0 = the 8x16 row, byte 1 (col 9)
    # blank — the extension is outside the 0xC0..0xDF replication range.
    var lead_ok = 1;
    var col9_blank = 1;
    var r = 0;
    while (r < 16) {
        var e0 = kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ell, r, 0);
        var f0 = kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, rep, r, 0);
        if (e0 != kashi_glyph_row(KASHI_FONT_VGA_8X16, ell, r)) { lead_ok = 0; }
        if (f0 != kashi_glyph_row(KASHI_FONT_VGA_8X16, rep, r)) { lead_ok = 0; }
        if (kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ell, r, 1) != 0) { col9_blank = 0; }
        if (kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, rep, r, 1) != 0) { col9_blank = 0; }
        r = r + 1;
    }
    assert_eq(lead_ok, 1, "vga9 ext byte 0 == the vga 8x16 rows");
    assert_eq(col9_blank, 1, "vga9 ext col 9 blank");
    assert_eq(kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, ell, 10, 0), 0xDB, "vga9 U+2026 r10 b0");
    assert_eq(kashi_glyph_row(KASHI_FONT_VGA_9X16, rep, 9), 0xFE, "vga9 U+FFFD r9 leading byte");
    # The pointer path agrees with the row accessor (hot-path pattern). The
    # deref is guarded so a regression to null reports instead of crashing.
    var p = kashi_glyph_ptr(KASHI_FONT_VGA_8X16, ell);
    assert_neq(p, 0, "vga U+2026 ptr non-null");
    var via_ptr = 0;
    if (p != 0) { via_ptr = load8(p + 11); }
    assert_eq(via_ptr, 0xDB, "vga U+2026 load8(ptr + 11)");
    return 0;
}

fn test_ext_bounds() {
    test_group("extension bounds");
    # Contiguity is what lets one `(ch - FIRST) * size` offset reach both.
    assert_eq(KASHI_EXT_FIRST, KASHI_GLYPH_LAST + 1, "ext starts right after 0xFF");
    assert_eq(KASHI_EXT_LAST - KASHI_EXT_FIRST + 1, KASHI_EXT_COUNT, "ext count matches its bounds");
    # The CP437 constants and kashi_font_count keep their 1.0 meaning.
    assert_eq(KASHI_GLYPH_LAST, 0xFF, "glyph last still 0xFF");
    assert_eq(KASHI_GLYPH_COUNT, 224, "glyph count still 224");
    assert_eq(kashi_font_count(KASHI_FONT_VGA_8X16), 224, "font_count still the CP437 count");
    var spacing_ok = 1;
    var past_null = 1;
    var row_sentinel = 1;
    var byte_sentinel = 1;
    var f = 0;
    while (f < 3) {
        var h = kashi_font_height(f);
        var stride = kashi_font_stride(f);
        var p_ff = kashi_glyph_ptr(f, 0xFF);
        var p_e0 = kashi_glyph_ptr(f, KASHI_EXT_FIRST);
        var p_e1 = kashi_glyph_ptr(f, KASHI_EXT_LAST);
        if (p_e0 - p_ff != h * stride) { spacing_ok = 0; }
        if (p_e1 - p_e0 != h * stride) { spacing_ok = 0; }
        if (kashi_glyph_ptr(f, KASHI_EXT_LAST + 1) != 0) { past_null = 0; }
        if (kashi_glyph_row(f, KASHI_EXT_LAST + 1, 10) != 0) { past_null = 0; }
        if (kashi_glyph_row(f, KASHI_EXT_FIRST, h) != 0) { row_sentinel = 0; }
        if (kashi_glyph_row(f, KASHI_EXT_LAST, 0 - 1) != 0) { row_sentinel = 0; }
        if (kashi_glyph_row_byte(f, KASHI_EXT_LAST, 5, stride) != 0) { byte_sentinel = 0; }
        if (kashi_glyph_row_byte(f, KASHI_EXT_FIRST, 5, 0 - 1) != 0) { byte_sentinel = 0; }
        f = f + 1;
    }
    assert_eq(spacing_ok, 1, "ext ptrs continue the glyph stride after 0xFF (3 fonts)");
    assert_eq(past_null, 1, "KASHI_EXT_LAST + 1 is null / blank (3 fonts)");
    assert_eq(row_sentinel, 1, "ext cells: out-of-range row -> 0 (3 fonts)");
    assert_eq(byte_sentinel, 1, "ext cells: byte_idx >= stride or < 0 -> 0 (3 fonts)");
    assert_eq(kashi_glyph_ptr(7, KASHI_EXT_FIRST), 0, "unknown font + ext cell -> null");
    assert_eq(kashi_glyph_encoded(KASHI_EXT_LAST + 1), 0, "first cell past ext unencoded");
    return 0;
}

# The library face on BUILT-IN fonts takes a Unicode codepoint (1.1.0).
fn test_lib_unicode_builtin() {
    test_group("library face: unicode on built-ins");
    _ti_cp437_fill();    # idempotent; keeps this group order-independent
    # The bug 1.1.0 fixes: U+00E7 'c-cedilla' drew cell 0xE7 'tau'.
    var c_ok = 1;
    var differs = 0;
    var r = 0;
    while (r < 16) {
        var got = kashi_font_row(KASHI_FONT_VGA_8X16, 0xE7, r);
        if (got != kashi_glyph_row(KASHI_FONT_VGA_8X16, 0x87, r)) { c_ok = 0; }
        if (got != kashi_glyph_row(KASHI_FONT_VGA_8X16, 0xE7, r)) { differs = 1; }
        r = r + 1;
    }
    assert_eq(c_ok, 1, "vga font_row U+00E7 == CP437 0x87 rows");
    assert_eq(differs, 1, "vga font_row U+00E7 is no longer cell 0xE7 (tau)");
    assert_eq(kashi_font_ptr(KASHI_FONT_VGA_8X16, 0xE7),
      kashi_glyph_ptr(KASHI_FONT_VGA_8X16, 0x87), "vga font_ptr U+00E7 == cell 0x87");
    assert_eq(kashi_font_ptr(KASHI_FONT_CGA_8X8, 0xE7),
      kashi_glyph_ptr(KASHI_FONT_CGA_8X8, 0x87), "cga font_ptr U+00E7 == cell 0x87");
    assert_eq(kashi_font_row_byte(KASHI_FONT_VGA_9X16, 0xE7, 12, 0),
      kashi_glyph_row_byte(KASHI_FONT_VGA_9X16, 0x87, 12, 0), "vga9 font_row_byte U+00E7 == cell 0x87");
    # Every CP437 glyph is reachable through the library face by its
    # codepoint, in all three fonts (ASCII lands where it always did) — the
    # pointer, and every row byte through both row accessors.
    var reach_ok = 1;
    var rows_ok = 1;
    var f = 0;
    while (f < 3) {
        var h = kashi_font_height(f);
        var stride = kashi_font_stride(f);
        var c = KASHI_GLYPH_FIRST;
        while (c <= KASHI_GLYPH_LAST) {
            var u = _ti_cell_uni(c);
            if (kashi_font_ptr(f, u) != kashi_glyph_ptr(f, c)) { reach_ok = 0; }
            var rr = 0;
            while (rr < h) {
                if (kashi_font_row(f, u, rr) != kashi_glyph_row(f, c, rr)) { rows_ok = 0; }
                var b = 0;
                while (b < stride) {
                    if (kashi_font_row_byte(f, u, rr, b) != kashi_glyph_row_byte(f, c, rr, b)) { rows_ok = 0; }
                    b = b + 1;
                }
                rr = rr + 1;
            }
            c = c + 1;
        }
        f = f + 1;
    }
    assert_eq(reach_ok, 1, "font_ptr(id, U(cell)) == glyph_ptr(id, cell), 224 cells x 3 fonts");
    assert_eq(rows_ok, 1, "font_row / font_row_byte(id, U(cell)) == the cell's rows, 3 fonts");
    assert_eq(kashi_font_ptr(KASHI_FONT_VGA_8X16, 0x2026),
      kashi_glyph_ptr(KASHI_FONT_VGA_8X16, KASHI_EXT_FIRST), "vga font_ptr U+2026 == ext cell");
    assert_eq(kashi_font_row(KASHI_FONT_VGA_8X16, 0x2026, 10), 0xDB, "vga font_row U+2026 r10");
    assert_eq(kashi_font_row(KASHI_FONT_CGA_8X8, 0x2026, 5), 0xDB, "cga font_row U+2026 r5");
    assert_eq(kashi_font_row(KASHI_FONT_VGA_8X16, 0xFFFD, 9), 0xFE, "vga font_row U+FFFD r9");
    assert_eq(kashi_font_row_byte(KASHI_FONT_VGA_9X16, 0x2026, 10, 1), 0, "vga9 font_row_byte U+2026 col 9 blank");
    assert_eq(kashi_font_ptr(KASHI_FONT_VGA_8X16, 0x2302),
      kashi_glyph_ptr(KASHI_FONT_VGA_8X16, 0x7F), "vga font_ptr U+2302 == cell 0x7F");
    assert_eq(kashi_font_row(KASHI_FONT_VGA_8X16, 0x2302, 10), 0xFE, "vga font_row U+2302 house base r10");
    # Unmapped codepoints render blank / null, as a runtime font's do.
    var blank = 1;
    r = 0;
    while (r < 16) {
        if (kashi_font_row(KASHI_FONT_VGA_8X16, 0x100, r) != 0) { blank = 0; }
        if (kashi_font_row(KASHI_FONT_VGA_8X16, 0x7F, r) != 0) { blank = 0; }
        if (kashi_font_row(KASHI_FONT_VGA_8X16, 0x263A, r) != 0) { blank = 0; }
        r = r + 1;
    }
    assert_eq(blank, 1, "unmapped U+0100 / U+007F / U+263A render blank");
    assert_eq(kashi_font_ptr(KASHI_FONT_VGA_8X16, 0x100), 0, "font_ptr U+0100 null (not the ext cell)");
    assert_eq(kashi_font_ptr(KASHI_FONT_VGA_8X16, 0x7F), 0, "font_ptr U+007F null");
    assert_eq(kashi_font_ptr(KASHI_FONT_CGA_8X8, 0 - 1), 0, "font_ptr negative cp null");
    return 0;
}

# Byte-indexed reads of 0x20..0xFF are exactly 1.0.10's. The expected
# FNV-1a values were computed from the 1.0.10 glyph sheet (sha256
# b68ca4d9...), so a match means no byte-indexed consumer sees any change.
fn test_cp437_bytes_unchanged() {
    test_group("cp437 bytes unchanged since 1.0.10");
    assert_eq(_ti_cp437_fnv(KASHI_FONT_VGA_8X16), 0xE5BC21886E563E88, "vga 8x16: 0x20..0xFF bytes == 1.0.10");
    assert_eq(_ti_cp437_fnv(KASHI_FONT_CGA_8X8), 0x6BE5DCEF83C5D456, "cga 8x8: 0x20..0xFF bytes == 1.0.10");
    assert_eq(_ti_cp437_fnv(KASHI_FONT_VGA_9X16), 0x87C79BBB359687DA, "vga 9x16: 0x20..0xFF bytes == 1.0.10");
    return 0;
}

fn test_psf_file_roundtrip() {
    test_group("psf file round-trip");
    # 256 glyphs, height 3. Plant glyph 'B' (index 0x42) rows = 0x11,0x22,0x33.
    var n = 4 + 256 * 3;
    var buf = alloc(n);
    var i = 0;
    while (i < n) { store8(buf + i, 0); i = i + 1; }
    store8(buf + 0, 0x36); store8(buf + 1, 0x04); store8(buf + 2, 0); store8(buf + 3, 3);
    store8(buf + 4 + 0x42 * 3 + 0, 0x11);
    store8(buf + 4 + 0x42 * 3 + 1, 0x22);
    store8(buf + 4 + 0x42 * 3 + 2, 0x33);

    var path = "/tmp/kashi_test_roundtrip.psf";
    file_write_all(path, buf, n);

    var id = kashi_load_psf_file(path);
    assert_gte(id, KASHI_RT_FONT_BASE, "file load returns id >= 2");
    assert_eq(kashi_rt_font_width(id), 8, "file font width 8");
    assert_eq(kashi_rt_font_height(id), 3, "file font height 3");
    assert_eq(kashi_rt_font_count(id), 256, "file font count 256");
    assert_eq(kashi_font_row(id, 0x42, 0), 0x11, "file glyph 0x42 r0");
    assert_eq(kashi_font_row(id, 0x42, 1), 0x22, "file glyph 0x42 r1");
    assert_eq(kashi_font_row(id, 0x42, 2), 0x33, "file glyph 0x42 r2");
    # A missing file is a negative error, not a crash.
    assert_lt(kashi_load_psf_file("/tmp/kashi_no_such_font_zzq.psf"), 0, "missing file -> negative");

    syscall(SYS_UNLINK, path);
    return 0;
}

# End-to-end codepoint addressing: write a PSF2 carrying a Unicode table,
# load it from a file, and fetch a glyph BY CODEPOINT through the unified
# dispatcher (the M2 path). All header fields here fit in one byte and the
# buffer is zeroed, so we store them directly (little-endian low byte).
fn test_psf_unicode_file() {
    test_group("psf unicode file round-trip");
    var buf = alloc(128);
    var i = 0;
    while (i < 128) { store8(buf + i, 0); i = i + 1; }
    # PSF2 header: 4 glyphs, height 3, width 8, flags = HAS_UNICODE.
    store8(buf + 0, 0x72); store8(buf + 1, 0xB5); store8(buf + 2, 0x4A); store8(buf + 3, 0x86);
    store8(buf + 8, 32);     # headersize
    store8(buf + 12, 1);     # flags: HAS_UNICODE
    store8(buf + 16, 4);     # count
    store8(buf + 20, 3);     # charsize
    store8(buf + 24, 3);     # height
    store8(buf + 28, 8);     # width
    # glyph 2 data (rows) at 32 + 2*3 = 38.
    store8(buf + 38, 0x71); store8(buf + 39, 0x72); store8(buf + 40, 0x73);
    # Unicode table at 32 + 4*3 = 44: g0 FF, g1 FF, g2 'Q'(0x51) FF, g3 FF.
    store8(buf + 44, 0xFF);
    store8(buf + 45, 0xFF);
    store8(buf + 46, 0x51); store8(buf + 47, 0xFF);
    store8(buf + 48, 0xFF);
    var len = 49;

    var path = "/tmp/kashi_test_unicode.psf";
    file_write_all(path, buf, len);
    var id = kashi_load_psf_file(path);
    assert_gte(id, KASHI_RT_FONT_BASE, "unicode file load ok");
    assert_eq(kashi_rt_font_count(id), 4, "unicode font count 4");
    # 'Q' resolves through the Unicode map to glyph 2.
    assert_eq(kashi_font_row(id, 0x51, 0), 0x71, "cp 'Q' -> glyph2 r0");
    assert_eq(kashi_font_row(id, 0x51, 2), 0x73, "cp 'Q' -> glyph2 r2");
    assert_eq(kashi_rt_glyph_row(id, 2, 0), 0x71, "raw idx 2 agrees");
    assert_eq(kashi_font_row(id, 0x41, 0), 0, "unmapped cp 'A' -> 0");

    syscall(SYS_UNLINK, path);
    return 0;
}

# BDF file round-trip: build a small BDF source, write it to a file, load it
# back via kashi_load_bdf_file, and read glyphs through the unified
# codepoint-addressed dispatcher. Exercises kashi_bdf_parse_header,
# kashi_bdf_next_glyph, the io.file_read_all path, and the cp-map build.
fn test_bdf_file_roundtrip() {
    test_group("bdf file round-trip");
    var buf = alloc(2048);
    var p = 0;
    p = _ti_str(buf, p, "STARTFONT 2.1\n");
    p = _ti_str(buf, p, "FONTBOUNDINGBOX 8 8 0 0\n");
    p = _ti_str(buf, p, "CHARS 2\n");
    p = _ti_str(buf, p, "STARTCHAR Q\n");
    p = _ti_str(buf, p, "ENCODING 81\n");
    p = _ti_str(buf, p, "BBX 8 8 0 0\n");
    p = _ti_str(buf, p, "BITMAP\nAA\nBB\nCC\nDD\nEE\nFF\n11\n22\nENDCHAR\n");
    p = _ti_str(buf, p, "STARTCHAR R\n");
    p = _ti_str(buf, p, "ENCODING 82\n");
    p = _ti_str(buf, p, "BBX 8 8 0 0\n");
    p = _ti_str(buf, p, "BITMAP\n01\n02\n03\n04\n05\n06\n07\n08\nENDCHAR\n");
    p = _ti_str(buf, p, "ENDFONT\n");

    var path = "/tmp/kashi_test_bdf.bdf";
    file_write_all(path, buf, p);
    var id = kashi_load_bdf_file(path);
    assert_gte(id, KASHI_RT_FONT_BASE, "bdf file load id >= rt base");
    assert_eq(kashi_rt_font_width(id), 8, "bdf file width 8");
    assert_eq(kashi_rt_font_height(id), 8, "bdf file height 8");
    assert_eq(kashi_rt_font_count(id), 2, "bdf file count 2");
    # 'Q' (0x51) rows.
    assert_eq(kashi_font_row(id, 0x51, 0), 0xAA, "bdf 'Q' r0");
    assert_eq(kashi_font_row(id, 0x51, 5), 0xFF, "bdf 'Q' r5");
    assert_eq(kashi_font_row(id, 0x51, 7), 0x22, "bdf 'Q' r7");
    # 'R' (0x52) rows.
    assert_eq(kashi_font_row(id, 0x52, 0), 0x01, "bdf 'R' r0");
    assert_eq(kashi_font_row(id, 0x52, 7), 0x08, "bdf 'R' r7");
    # Missing file -> negative.
    assert_lt(kashi_load_bdf_file("/tmp/kashi_no_such_bdf_zzq.bdf"), 0, "missing bdf negative");

    syscall(SYS_UNLINK, path);
    return 0;
}

# Tiny inline string-copy helper (mirrors src/test.cyr's _bdf_str).
fn _ti_str(buf, p, s) {
    var i = 0;
    var done = 0;
    while (done == 0) {
        var c = load8(s + i);
        if (c == 0) { done = 1; }
        if (done == 0) {
            store8(buf + p + i, c);
            i = i + 1;
        }
    }
    return p + i;
}

# PCF file round-trip: build a small PCF, write it to /tmp, load it
# back via kashi_load_pcf_file, verify glyph round-trip by codepoint.
# Exercises kashi_pcf_parse_header, decode_glyph (incl. bit-reverse
# branch), cp_to_idx, and the io.file_read_all path.
fn test_pcf_file_roundtrip() {
    test_group("pcf file round-trip");
    var buf = alloc(512);
    var p = 0;
    # Header
    store8(buf + 0, 0x01); store8(buf + 1, 0x66);
    store8(buf + 2, 0x63); store8(buf + 3, 0x70);
    _ti_put32(buf, 4, 3);
    # TOC: METRICS, BITMAPS, BDF_ENCODINGS — same layout as src/test.cyr's
    # _mk_pcf (compressed metrics, MSB-bit, LE-byte, scan/pad 1).
    var moff = 56;
    var msize = 4 + 2 + 2 * 5;
    _ti_put32(buf, 8, 0x04);
    _ti_put32(buf, 12, 0x108);
    _ti_put32(buf, 16, msize);
    _ti_put32(buf, 20, moff);
    var boff = moff + msize;
    var bsize = 4 + 4 + 2 * 4 + 16 + 2 * 8;
    _ti_put32(buf, 24, 0x08);
    _ti_put32(buf, 28, 0x08);
    _ti_put32(buf, 32, bsize);
    _ti_put32(buf, 36, boff);
    var eoff = boff + bsize;
    var esize = 4 + 5 * 2 + 2 * 2;
    _ti_put32(buf, 40, 0x20);
    _ti_put32(buf, 44, 0x08);
    _ti_put32(buf, 48, esize);
    _ti_put32(buf, 52, eoff);
    # METRICS body
    _ti_put32(buf, moff, 0x108);
    store8(buf + moff + 4, 2); store8(buf + moff + 5, 0);    # count = 2
    # Per-glyph: left=0, right=8, width=8, ascent=8, descent=0
    var mi = 0;
    while (mi < 2) {
        var s = moff + 6 + mi * 5;
        store8(buf + s + 0, 0x80);
        store8(buf + s + 1, 0x88);
        store8(buf + s + 2, 0x88);
        store8(buf + s + 3, 0x88);
        store8(buf + s + 4, 0x80);
        mi = mi + 1;
    }
    # BITMAPS body
    _ti_put32(buf, boff, 0x08);
    _ti_put32(buf, boff + 4, 2);
    _ti_put32(buf, boff + 8, 0);
    _ti_put32(buf, boff + 12, 8);
    _ti_put32(buf, boff + 16, 16);
    _ti_put32(buf, boff + 20, 48);
    _ti_put32(buf, boff + 24, 96);
    _ti_put32(buf, boff + 28, 192);
    var bd = boff + 32;
    # Glyph 0: Q-ish pattern
    store8(buf + bd + 0, 0x3C);
    store8(buf + bd + 1, 0x42);
    store8(buf + bd + 2, 0x42);
    store8(buf + bd + 3, 0x42);
    store8(buf + bd + 4, 0x42);
    store8(buf + bd + 5, 0x4A);
    store8(buf + bd + 6, 0x3C);
    store8(buf + bd + 7, 0x02);
    # Glyph 1: R-ish pattern
    store8(buf + bd + 8, 0x7C);
    store8(buf + bd + 9, 0x42);
    store8(buf + bd + 10, 0x42);
    store8(buf + bd + 11, 0x7C);
    store8(buf + bd + 12, 0x44);
    store8(buf + bd + 13, 0x42);
    store8(buf + bd + 14, 0x42);
    store8(buf + bd + 15, 0x00);
    # ENCODINGS body
    _ti_put32(buf, eoff, 0x08);
    store8(buf + eoff + 4, 0x51); store8(buf + eoff + 5, 0);   # min_b2 = 'Q'
    store8(buf + eoff + 6, 0x52); store8(buf + eoff + 7, 0);   # max_b2 = 'R'
    store8(buf + eoff + 8, 0); store8(buf + eoff + 9, 0);      # min_b1
    store8(buf + eoff + 10, 0); store8(buf + eoff + 11, 0);    # max_b1
    store8(buf + eoff + 12, 0); store8(buf + eoff + 13, 0);    # default
    store8(buf + eoff + 14, 0); store8(buf + eoff + 15, 0);    # 'Q' -> glyph 0
    store8(buf + eoff + 16, 1); store8(buf + eoff + 17, 0);    # 'R' -> glyph 1
    var total = eoff + esize;

    var path = "/tmp/kashi_test_pcf.pcf";
    file_write_all(path, buf, total);
    var id = kashi_load_pcf_file(path);
    assert_gte(id, KASHI_RT_FONT_BASE, "pcf file load id");
    assert_eq(kashi_rt_font_width(id), 8, "pcf file width");
    assert_eq(kashi_rt_font_height(id), 8, "pcf file height");
    assert_eq(kashi_rt_font_count(id), 2, "pcf file count");
    assert_eq(kashi_font_row(id, 0x51, 0), 0x3C, "pcf 'Q' r0");
    assert_eq(kashi_font_row(id, 0x51, 7), 0x02, "pcf 'Q' r7");
    assert_eq(kashi_font_row(id, 0x52, 0), 0x7C, "pcf 'R' r0");
    assert_eq(kashi_font_row(id, 0x52, 4), 0x44, "pcf 'R' r4");
    # Missing file -> negative.
    assert_lt(kashi_load_pcf_file("/tmp/kashi_no_such_pcf_zzq.pcf"), 0, "missing pcf negative");

    syscall(SYS_UNLINK, path);
    return 0;
}

# Tiny LE u32 helper (mirrors src/test.cyr's _put32).
fn _ti_put32(buf, off, v) {
    store8(buf + off + 0, v & 0xFF);
    store8(buf + off + 1, (v >> 8) & 0xFF);
    store8(buf + off + 2, (v >> 16) & 0xFF);
    store8(buf + off + 3, (v >> 24) & 0xFF);
    return 0;
}

# PSF + sidecar tab file round-trip: write a tableless PSF and a text-
# format .tab to /tmp, load the PSF then attach the tab via
# kashi_attach_unicode_text_file, verify codepoint round-trip end-to-end.
fn test_psf_tab_file_roundtrip() {
    test_group("psf + sidecar tab file");
    # Tableless PSF1: 256 glyphs height 3, glyph 0x21 ('!') = rows 0xAA, 0xBB, 0xCC.
    var psf_len = 4 + 256 * 3;
    var psf = alloc(psf_len);
    var i = 0;
    while (i < psf_len) { store8(psf + i, 0); i = i + 1; }
    store8(psf + 0, 0x36); store8(psf + 1, 0x04);
    store8(psf + 2, 0); store8(psf + 3, 3);
    store8(psf + 4 + 0x21 * 3 + 0, 0xAA);
    store8(psf + 4 + 0x21 * 3 + 1, 0xBB);
    store8(psf + 4 + 0x21 * 3 + 2, 0xCC);
    var psf_path = "/tmp/kashi_test_tabless.psf";
    file_write_all(psf_path, psf, psf_len);

    # Text-tab mapping glyph 0x21 to U+2603 (☃) and U+FE0F (variation selector).
    var tab = alloc(256);
    var tp = 0;
    tp = _ti_str(tab, tp, "# kashi integration tab\n");
    tp = _ti_str(tab, tp, "0x21   U+2603 U+FE0F   # snowman + VS\n");
    var tab_path = "/tmp/kashi_test_tabless.tab";
    file_write_all(tab_path, tab, tp);

    var id = kashi_load_psf_file(psf_path);
    assert_gte(id, KASHI_RT_FONT_BASE, "tableless psf file load");
    assert_eq(kashi_attach_unicode_text_file(id, tab_path), KASHI_OK,
      "attach tab file ok");
    # Both attached codepoints resolve to glyph 0x21.
    assert_eq(kashi_font_row(id, 0x2603, 0), 0xAA, "U+2603 r0");
    assert_eq(kashi_font_row(id, 0x2603, 2), 0xCC, "U+2603 r2");
    assert_eq(kashi_font_row(id, 0xFE0F, 0), 0xAA, "U+FE0F r0");
    # Missing .tab file -> negative (file_read_all error path).
    assert_lt(kashi_attach_unicode_text_file(id, "/tmp/kashi_no_such_tab_zzq.tab"), 0,
      "missing tab file -> negative");

    syscall(SYS_UNLINK, psf_path);
    syscall(SYS_UNLINK, tab_path);
    return 0;
}

fn main() {
    alloc_init();
    test_cp437_preinit();     # before kashi_font_init: the documented pre-init answers
    kashi_font_init();

    test_row_byte_bounded();
    test_space_vs_visible();
    test_pointer_monotone();
    test_reinit_idempotent();
    test_vga_9x16_structural();
    test_cp437_map();
    test_cp437_unmapped();
    test_ext_glyphs();
    test_ext_bounds();
    test_lib_unicode_builtin();
    test_cp437_bytes_unchanged();
    test_psf_file_roundtrip();
    test_psf_unicode_file();
    test_bdf_file_roundtrip();
    test_pcf_file_roundtrip();
    test_psf_tab_file_roundtrip();

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
