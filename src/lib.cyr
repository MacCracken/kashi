# === kashi — library root ===
#
# kashi (काशि, "shining") is the AGNOS console-font subsystem: bitmap glyph
# data plus the machinery to load and query console fonts. This file is the
# stdlib-using LIBRARY face — the surface consumers who CAN link the Cyrius
# stdlib (userland tools, the future TTY/console stack) use.
#
# --- The two faces of kashi (the load-bearing split — see docs/adr/0001) ---
#
#   1. FREESTANDING CORE  — src/font_data.cyr
#      No stdlib, no heap, no syscalls. Three built-in fonts (VGA 8x16,
#      CGA 8x8, VGA 9x16 derived) + pure-arithmetic accessors covering full
#      CP437. A freestanding kernel (agnos, which has `[deps] stdlib = []`
#      and a vendored klib/) `include`s this file DIRECTLY and never
#      touches the rest of kashi.
#
#   2. FULL LIBRARY       — this file (src/lib.cyr) + the parsers
#      src/font_psf.cyr, src/font_bdf.cyr, src/font_pcf.cyr. stdlib-using.
#      Runtime PSF1/PSF2 / BDF / PCF import (`kashi_load_*`,
#      `kashi_register_font`), sidecar Unicode-table attach,
#      codepoint→glyph Unicode mapping, ligature
#      lookup, unified codepoint-addressed accessors (built-in + runtime),
#      active-font knob. Do NOT let any of it leak `include`s into
#      font_data.cyr — the boundary is checked by `cyrius vet`.

include "src/font_data.cyr"
include "src/font_psf.cyr"
include "src/font_bdf.cyr"
include "src/font_pcf.cyr"

# ---------------------------------------------------------------------------
# Runtime font surface (M1). The PSF byte parser + result codes (KashiResult)
# and PSF constants live in src/font_psf.cyr; this file owns the runtime
# registry, glyph-store allocation, and the unified accessors that dispatch
# across the built-in (ids 0..2) and runtime (ids >= KASHI_RT_FONT_BASE = 3)
# id spaces. See docs/adr/0002 and 0006.
#
# Return convention: kashi_load_psf / kashi_register_font return a font_id
# (>= KASHI_RT_FONT_BASE) on success, or `0 - <KashiResult>` (negative) on
# failure. Built-in ids 0..2 are never returned by these. (`0 - N` form per
# the no-negative-literals rule.)
#
# Glyph addressing (M2 — see docs/adr/0003; built-ins refined by
# docs/adr/0011): the unified accessors kashi_font_ptr / kashi_font_row /
# kashi_font_row_byte are CODEPOINT-addressed — `cp` is a Unicode codepoint
# for every font. A built-in resolves it through kashi_cp437_from_unicode
# (ASCII, the CP437 repertoire, U+2302 and the extension glyphs U+2026 /
# U+FFFD; anything else is unmapped -> 0 / null, exactly like a runtime
# font's unmapped codepoint). Until 1.1.0 a built-in took `cp` as the CP437
# CELL, so U+00E7 'ç' drew cell 0xE7 'τ' — fixed; byte-indexed callers want
# the core's kashi_glyph_* accessors, which still take the cell. A runtime
# font that carried a PSF Unicode table resolves the codepoint through that
# table; a runtime font WITHOUT a table falls back to treating the
# codepoint as a raw glyph index. Raw glyph-INDEX access (tooling /
# enumeration) is kashi_rt_glyph_ptr / _row.
# ---------------------------------------------------------------------------

# Runtime fonts start at id 3 (0 = VGA 8x16, 1 = CGA 8x8, 2 = VGA 9x16 are
# the freestanding-core built-ins). Bumped 2 -> 3 in 0.5.1 (ADR 0006) when
# the 9x16 derived built-in landed.
enum KashiRtBase {
    KASHI_RT_FONT_BASE = 3;
}

# Runtime font record: 88 bytes (grown in 0.5.0 for stride + sequences).
enum _KashiRtRec {
    _KASHI_RT_WIDTH = 0;
    _KASHI_RT_HEIGHT = 8;
    _KASHI_RT_COUNT = 16;
    _KASHI_RT_CHARSIZE = 24;
    _KASHI_RT_DATA = 32;       # ptr to owned glyph bytes (count * charsize)
    _KASHI_RT_UMAP = 40;       # ptr to sorted {u64 codepoint, u64 glyph} pairs, 0 if none
    _KASHI_RT_UCOUNT = 48;     # number of codepoint->glyph pairs in _KASHI_RT_UMAP
    _KASHI_RT_STRIDE = 56;     # bytes per glyph row = ceil(width / 8)
    _KASHI_RT_SEQS = 64;       # ptr to {u64 cps_ptr, u64 length, u64 glyph} records, 0 if none
    _KASHI_RT_SEQCOUNT = 72;   # number of sequence records in _KASHI_RT_SEQS
    _KASHI_RT_SEQDATA = 80;    # ptr to flat codepoint stream backing _KASHI_RT_SEQS, 0 if none
}

# Registry: a vec of record pointers, lazily created on first register.
var _kashi_rt_registry = 0;

# Fetch the record for a runtime font_id, or 0 if out of range / no registry.
fn _kashi_rt_get(font_id) {
    if (_kashi_rt_registry == 0) { return 0; }
    var idx = font_id - KASHI_RT_FONT_BASE;
    if (idx < 0) { return 0; }
    if (idx >= vec_len(_kashi_rt_registry)) { return 0; }
    return vec_get(_kashi_rt_registry, idx);
}

# Register an ALREADY-OWNED glyph store (count * charsize bytes the registry
# now owns — no copy) together with its maps. `maps` is 0 (no Unicode table)
# or a 40-byte {umap, ucount, seqs, seqcount, seqdata} block. The record is
# complete before the push publishes it, so no lookup ever sees a font
# without the map it was loaded with (1.3.0; until then the loaders
# registered first and attached the map after). Returns the new font_id, or
# `0 - KASHI_EINVAL` if an allocation failed. Internal.
fn _kashi_rt_register(width, height, count, charsize, data, maps) {
    if (_kashi_rt_registry == 0) {
        _kashi_rt_registry = vec_new();
        if (_kashi_rt_registry == 0) { return 0 - KASHI_EINVAL; }
    }
    var rec = alloc(88);
    if (rec == 0) { return 0 - KASHI_EINVAL; }
    var stride = (width + 7) / 8;
    store64(rec + _KASHI_RT_WIDTH, width);
    store64(rec + _KASHI_RT_HEIGHT, height);
    store64(rec + _KASHI_RT_COUNT, count);
    store64(rec + _KASHI_RT_CHARSIZE, charsize);
    store64(rec + _KASHI_RT_DATA, data);
    store64(rec + _KASHI_RT_UMAP, 0);
    store64(rec + _KASHI_RT_UCOUNT, 0);
    store64(rec + _KASHI_RT_STRIDE, stride);
    store64(rec + _KASHI_RT_SEQS, 0);
    store64(rec + _KASHI_RT_SEQCOUNT, 0);
    store64(rec + _KASHI_RT_SEQDATA, 0);
    if (maps != 0) {
        store64(rec + _KASHI_RT_UMAP, load64(maps + 0));
        store64(rec + _KASHI_RT_UCOUNT, load64(maps + 8));
        store64(rec + _KASHI_RT_SEQS, load64(maps + 16));
        store64(rec + _KASHI_RT_SEQCOUNT, load64(maps + 24));
        store64(rec + _KASHI_RT_SEQDATA, load64(maps + 32));
    }
    # vec_push_a, not vec_push: when the registry must grow and the doubled
    # array cannot be allocated, vec_push aborts the whole process; this
    # fails the registration instead (1.3.0, audit 2026-10-30 L6).
    if (vec_push_a(default_alloc(), _kashi_rt_registry, rec) < 0) { return 0 - KASHI_EINVAL; }
    return KASHI_RT_FONT_BASE + vec_len(_kashi_rt_registry) - 1;
}

# The map of a font whose Unicode table maps no single codepoint (only
# sequences, or nothing usable). _KASHI_RT_UMAP points here with a count of
# 0, so every codepoint misses. _KASHI_RT_UMAP == 0 still means "no table":
# codepoints are raw glyph indices. Until 1.3.0 such a font fell back to
# identity addressing and drew U+00E7 'ç' as glyph 0xE7 (audit 2026-10-30,
# L7). Never written.
var _kashi_empty_map[2];

# --- Map construction (1.3.0; ADR 0012) ---
#
# A codepoint map is an array of {u64 codepoint, u64 glyph} pairs (16 bytes,
# "kind 0"), sorted by codepoint for the binary search in
# _kashi_rt_cp_to_glyph. A sequence list is an array of {u64 cps_ptr, u64
# length, u64 glyph} records (24 bytes, "kind 1"), sorted by codepoints for
# the binary search in kashi_font_seq_glyph. Both sort with one heapsort.

# Compare codepoint runs a (alen long) and b (blen long): lexicographically,
# then shorter first. Returns 0 - 1, 0 or 1.
fn _kashi_seq_cmp(acps, alen, bcps, blen) {
    var n = alen;
    if (blen < n) { n = blen; }
    var res = 0;
    var i = 0;
    while (i < n) {
        var ca = load64(acps + i * 8);
        var cb = load64(bcps + i * 8);
        if (ca < cb) { res = 0 - 1; i = n; }
        if (ca > cb) { res = 1; i = n; }
        i = i + 1;
    }
    if (res != 0) { return res; }
    if (alen < blen) { return 0 - 1; }
    if (alen > blen) { return 1; }
    return 0;
}

# 1 if record `a` orders after record `b`: by codepoint (kind 0) or by
# codepoint run (kind 1), then by glyph.
fn _kashi_rec_gt(arr, a, b, kind) {
    var size = 16;
    var goff = 8;
    if (kind == 1) { size = 24; goff = 16; }
    var ra = arr + a * size;
    var rb = arr + b * size;
    var c = 0;
    if (kind == 0) {
        if (load64(ra) > load64(rb)) { c = 1; }
        if (load64(ra) < load64(rb)) { c = 0 - 1; }
    }
    if (kind == 1) {
        c = _kashi_seq_cmp(load64(ra), load64(ra + 8), load64(rb), load64(rb + 8));
    }
    if (c > 0) { return 1; }
    if (c < 0) { return 0; }
    if (load64(ra + goff) > load64(rb + goff)) { return 1; }
    return 0;
}

fn _kashi_rec_swap(arr, a, b, kind) {
    var size = 16;
    if (kind == 1) { size = 24; }
    var ra = arr + a * size;
    var rb = arr + b * size;
    var off = 0;
    while (off < size) {
        var t = load64(ra + off);
        store64(ra + off, load64(rb + off));
        store64(rb + off, t);
        off = off + 8;
    }
    return 0;
}

# Sift the record at `root` down a max-heap of the first `n` records.
fn _kashi_rec_sift(arr, root, n, kind) {
    var r = root;
    var going = 1;
    while (going == 1) {
        var child = r * 2 + 1;
        if (child >= n) { going = 0; }
        if (going == 1) {
            if (child + 1 < n) {
                if (_kashi_rec_gt(arr, child + 1, child, kind) == 1) { child = child + 1; }
            }
            var bigger = _kashi_rec_gt(arr, child, r, kind);
            if (bigger == 1) {
                _kashi_rec_swap(arr, r, child, kind);
                r = child;
            }
            if (bigger == 0) { going = 0; }
        }
    }
    return 0;
}

# Heapsort `n` records ascending: O(n log n) on any input, in place, no
# allocation. The four insertion sorts this replaces were quadratic, so a
# hostile 256 KiB table took ~200 s to load (audit 2026-10-30, L1).
fn _kashi_rec_sort(arr, n, kind) {
    if (n < 2) { return 0; }
    var i = n / 2;
    while (i > 0) {
        i = i - 1;
        _kashi_rec_sift(arr, i, n, kind);
    }
    var last = n - 1;
    while (last > 0) {
        _kashi_rec_swap(arr, 0, last, kind);
        _kashi_rec_sift(arr, 0, last, kind);
        last = last - 1;
    }
    return 0;
}

# Sift for codepoint pairs with the comparison inlined: the map sort's hot
# loop, without the call per compare that _kashi_rec_sift pays.
fn _kashi_pair_sift(arr, root, n) {
    var r = root;
    var going = 1;
    while (going == 1) {
        var child = r * 2 + 1;
        if (child >= n) { going = 0; }
        if (going == 1) {
            var cc = load64(arr + child * 16);
            var cg = load64(arr + child * 16 + 8);
            if (child + 1 < n) {
                var dc = load64(arr + (child + 1) * 16);
                var dg = load64(arr + (child + 1) * 16 + 8);
                var right = 0;
                if (dc > cc) { right = 1; }
                if (dc == cc) {
                    if (dg > cg) { right = 1; }
                }
                if (right == 1) {
                    child = child + 1;
                    cc = dc;
                    cg = dg;
                }
            }
            var rc = load64(arr + r * 16);
            var rg = load64(arr + r * 16 + 8);
            var bigger = 0;
            if (cc > rc) { bigger = 1; }
            if (cc == rc) {
                if (cg > rg) { bigger = 1; }
            }
            if (bigger == 1) {
                store64(arr + r * 16, cc);
                store64(arr + r * 16 + 8, cg);
                store64(arr + child * 16, rc);
                store64(arr + child * 16 + 8, rg);
                r = child;
            }
            if (bigger == 0) { going = 0; }
        }
    }
    return 0;
}

# Sort `n` codepoint pairs and drop repeated codepoints; returns the count
# kept. Pairs already in order — most real fonts' tables, and every PCF —
# skip the sort after one linear check, so a typical load costs what it did
# under insertion sort; anything else heapsorts. Of a run of pairs with one
# codepoint the HIGHEST glyph index stays — the Linux console's rule, where
# a later table entry overwrites an earlier one. Until 1.3.0 the winner
# depended on the map's size (ADR 0012).
fn _kashi_pairs_finish(arr, n) {
    var sorted = 1;
    var i = 1;
    while (i < n) {
        var pc = load64(arr + (i - 1) * 16);
        var cc = load64(arr + i * 16);
        if (pc > cc) {
            sorted = 0;
            i = n;
        }
        if (pc == cc) {
            if (load64(arr + (i - 1) * 16 + 8) > load64(arr + i * 16 + 8)) {
                sorted = 0;
                i = n;
            }
        }
        i = i + 1;
    }
    if (sorted == 0) {
        var k = n / 2;
        while (k > 0) {
            k = k - 1;
            _kashi_pair_sift(arr, k, n);
        }
        var last = n - 1;
        while (last > 0) {
            _kashi_rec_swap(arr, 0, last, 0);
            _kashi_pair_sift(arr, 0, last);
            last = last - 1;
        }
    }
    var w = 0;
    var r = 0;
    while (r < n) {
        var keep = 1;
        if (r + 1 < n) {
            if (load64(arr + (r + 1) * 16) == load64(arr + r * 16)) { keep = 0; }
        }
        if (keep == 1) {
            store64(arr + w * 16, load64(arr + r * 16));
            store64(arr + w * 16 + 8, load64(arr + r * 16 + 8));
            w = w + 1;
        }
        r = r + 1;
    }
    return w;
}

# Sort `n` sequence records and drop repeated sequences (the highest glyph
# stays, as for codepoints); returns the count kept. The records point into
# a shared codepoint store, which does not move. Until 1.3.0 the lookup
# scanned every record, ~0.8 ms a call on a hostile font (audit 2026-10-30,
# L2).
fn _kashi_seqs_finish(seqs, n) {
    _kashi_rec_sort(seqs, n, 1);
    var w = 0;
    var r = 0;
    while (r < n) {
        var keep = 1;
        if (r + 1 < n) {
            var a = seqs + r * 24;
            var b = seqs + (r + 1) * 24;
            if (_kashi_seq_cmp(load64(a), load64(a + 8), load64(b), load64(b + 8)) == 0) { keep = 0; }
        }
        if (keep == 1) {
            store64(seqs + w * 24, load64(seqs + r * 24));
            store64(seqs + w * 24 + 8, load64(seqs + r * 24 + 8));
            store64(seqs + w * 24 + 16, load64(seqs + r * 24 + 16));
            w = w + 1;
        }
        r = r + 1;
    }
    return w;
}

# Build the codepoint->glyph map for a font of `count` glyphs from its PSF
# Unicode table (bytes [unioff, len) of `buf`, decoded per `kind`). Two
# passes: count single-codepoint mappings, then fill the pairs and finish
# them (_kashi_pairs_finish). Writes the pair array to out + 0 and its count
# to out + 8 (0 and 0 when the table maps no single codepoint). Returns 0, or
# 0 - 1 if the allocation failed. Bounded by `len` and `count`; a malformed
# table just yields a shorter map, never a crash. Sequence entries (after a
# separator) are skipped. Internal.
fn _kashi_build_umap(buf, len, kind, unioff, count, out) {
    store64(out + 0, 0);
    store64(out + 8, 0);
    var tok[24];

    # Pass 1 — count single codepoints belonging to a real glyph.
    var n = 0;
    var pos = unioff;
    var glyph = 0;
    var inseq = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t = load64(&tok + KASHI_UT_TYPE);
        if (t == KASHI_TOK_END) { pos = len; }
        if (t != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t == KASHI_TOK_CP) {
                if (inseq == 0) {
                    if (glyph < count) { n = n + 1; }
                }
            }
            if (t == KASHI_TOK_SEQ) { inseq = 1; }
            if (t == KASHI_TOK_TERM) {
                glyph = glyph + 1;
                inseq = 0;
            }
        }
    }
    if (n == 0) { return 0; }

    var arr = alloc(n * 16);
    if (arr == 0) { return 0 - 1; }

    # Pass 2 — fill (codepoint, glyph) pairs.
    var w = 0;
    pos = unioff;
    glyph = 0;
    inseq = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t2 = load64(&tok + KASHI_UT_TYPE);
        if (t2 == KASHI_TOK_END) { pos = len; }
        if (t2 != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t2 == KASHI_TOK_CP) {
                if (inseq == 0) {
                    if (glyph < count) {
                        if (w < n) {
                            store64(arr + w * 16 + 0, load64(&tok + KASHI_UT_CP));
                            store64(arr + w * 16 + 8, glyph);
                            w = w + 1;
                        }
                    }
                }
            }
            if (t2 == KASHI_TOK_SEQ) { inseq = 1; }
            if (t2 == KASHI_TOK_TERM) {
                glyph = glyph + 1;
                inseq = 0;
            }
        }
    }

    store64(out + 0, arr);
    store64(out + 8, _kashi_pairs_finish(arr, w));
    return 0;
}

# Build the sequence (ligature) list for a font of `count` glyphs: walk the
# same PSF Unicode table _kashi_build_umap consumes, this time harvesting
# multi-codepoint runs that follow a SEQ separator. Each sequence becomes one
# record `{cps_ptr, length, glyph}` (24 bytes), with all codepoints packed
# into one flat backing store. Two passes: count sequences + total
# codepoints, then alloc both, fill, and sort the records
# (_kashi_seqs_finish) for kashi_font_seq_glyph's binary search. Writes the
# records to out + 0, their count to out + 8 and the backing store to
# out + 16 (all 0 when there are none). Returns 0, or 0 - 1 if an
# allocation failed. Internal.
fn _kashi_build_useqs(buf, len, kind, unioff, count, out) {
    store64(out + 0, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var tok[24];

    # Pass 1 — count sequences and total codepoint length.
    var nseqs = 0;
    var ntotal = 0;
    var pos = unioff;
    var glyph = 0;
    var inseq = 0;
    var curlen = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t = load64(&tok + KASHI_UT_TYPE);
        if (t == KASHI_TOK_END) { pos = len; }
        if (t != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t == KASHI_TOK_SEQ) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            nseqs = nseqs + 1;
                            ntotal = ntotal + curlen;
                        }
                    }
                }
                inseq = 1;
                curlen = 0;
            }
            if (t == KASHI_TOK_TERM) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            nseqs = nseqs + 1;
                            ntotal = ntotal + curlen;
                        }
                    }
                }
                glyph = glyph + 1;
                inseq = 0;
                curlen = 0;
            }
            if (t == KASHI_TOK_CP) {
                if (inseq == 1) { curlen = curlen + 1; }
            }
        }
    }
    if (nseqs == 0) { return 0; }

    var seqs = alloc(nseqs * 24);
    if (seqs == 0) { return 0 - 1; }
    var cps = alloc(ntotal * 8);
    if (cps == 0) { return 0 - 1; }

    # Pass 2 — fill records and the codepoint backing store.
    var w = 0;
    var wcps = 0;
    var curstart = 0;
    pos = unioff;
    glyph = 0;
    inseq = 0;
    curlen = 0;
    while (pos < len) {
        kashi_psf_uni_token(buf, pos, len, kind, &tok);
        var t2 = load64(&tok + KASHI_UT_TYPE);
        if (t2 == KASHI_TOK_END) { pos = len; }
        if (t2 != KASHI_TOK_END) {
            pos = load64(&tok + KASHI_UT_NEXT);
            if (t2 == KASHI_TOK_SEQ) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            if (w < nseqs) {
                                store64(seqs + w * 24 + 0, cps + curstart * 8);
                                store64(seqs + w * 24 + 8, curlen);
                                store64(seqs + w * 24 + 16, glyph);
                                w = w + 1;
                            }
                        }
                    }
                }
                inseq = 1;
                curstart = wcps;
                curlen = 0;
            }
            if (t2 == KASHI_TOK_TERM) {
                if (inseq == 1) {
                    if (curlen > 0) {
                        if (glyph < count) {
                            if (w < nseqs) {
                                store64(seqs + w * 24 + 0, cps + curstart * 8);
                                store64(seqs + w * 24 + 8, curlen);
                                store64(seqs + w * 24 + 16, glyph);
                                w = w + 1;
                            }
                        }
                    }
                }
                glyph = glyph + 1;
                inseq = 0;
                curlen = 0;
            }
            if (t2 == KASHI_TOK_CP) {
                if (inseq == 1) {
                    if (wcps < ntotal) {
                        store64(cps + wcps * 8, load64(&tok + KASHI_UT_CP));
                        wcps = wcps + 1;
                        curlen = curlen + 1;
                    }
                }
            }
        }
    }

    store64(out + 0, seqs);
    store64(out + 8, _kashi_seqs_finish(seqs, w));
    store64(out + 16, cps);
    return 0;
}

# Build both maps for a font of `count` glyphs from the PSF Unicode table at
# [unioff, len) of `buf`, into the 40-byte `maps` block _kashi_rt_register
# takes. A table that maps no single codepoint gets the empty map, never
# "no map": the font is codepoint-addressed by its table either way.
# Returns 0, 0 - 1 if an allocation failed, or 0 - 2 if the table yields
# nothing at all (no single codepoint and no sequence). Internal.
fn _kashi_build_maps(buf, len, kind, unioff, count, maps) {
    var um[16];
    var sq[24];
    if (_kashi_build_umap(buf, len, kind, unioff, count, &um) != 0) { return 0 - 1; }
    if (_kashi_build_useqs(buf, len, kind, unioff, count, &sq) != 0) { return 0 - 1; }
    var umap = load64(&um + 0);
    var ucount = load64(&um + 8);
    var seqcount = load64(&sq + 8);
    store64(maps + 0, umap);
    store64(maps + 8, ucount);
    store64(maps + 16, load64(&sq + 0));
    store64(maps + 24, seqcount);
    store64(maps + 32, load64(&sq + 16));
    if (umap == 0) {
        store64(maps + 0, &_kashi_empty_map);
        store64(maps + 8, 0);
    }
    if (ucount == 0) {
        if (seqcount == 0) { return 0 - 2; }
    }
    return 0;
}

# Resolve a codepoint to a glyph index for a runtime font record. With a
# Unicode map: binary search (returns 0 - 1 if the codepoint is unmapped; the
# empty map misses everything). Without a map (no table at all): identity —
# the codepoint as a raw index if in [0,count), else 0 - 1. Internal.
fn _kashi_rt_cp_to_glyph(rec, cp) {
    var umap = load64(rec + _KASHI_RT_UMAP);
    if (umap == 0) {
        var count = load64(rec + _KASHI_RT_COUNT);
        if (cp < 0) { return 0 - 1; }
        if (cp >= count) { return 0 - 1; }
        return cp;
    }
    var ucount = load64(rec + _KASHI_RT_UCOUNT);
    var lo = 0;
    var hi = ucount - 1;
    while (lo <= hi) {
        var mid = lo + (hi - lo) / 2;
        var mc = load64(umap + mid * 16 + 0);
        if (mc == cp) { return load64(umap + mid * 16 + 8); }
        if (mc < cp) { lo = mid + 1; }
        if (mc > cp) { hi = mid - 1; }
    }
    return 0 - 1;
}

# Register a runtime font from caller-supplied glyph data. width must be
# 1..32, height 1..32, glyph_count in [1, KASHI_PSF_MAX_COUNT]. Rows are
# ceil(width/8) bytes each (one byte per row for <= 8 wide). The glyph
# bytes are COPIED into a store the registry owns, so the caller may
# free/reuse its buffer afterward. Returns font_id (>= KASHI_RT_FONT_BASE)
# or `0 - KASHI_EINVAL`.
fn kashi_register_font(width, height, glyph_data, glyph_count) {
    if (width < 1) { return 0 - KASHI_EINVAL; }
    if (width > KASHI_PSF_MAX_WIDTH) { return 0 - KASHI_EINVAL; }
    if (height < 1) { return 0 - KASHI_EINVAL; }
    if (height > KASHI_PSF_MAX_HEIGHT) { return 0 - KASHI_EINVAL; }
    if (glyph_count < 1) { return 0 - KASHI_EINVAL; }
    # 0.6.0 audit F1: cap glyph_count at the same bound the PSF parser
    # enforces, otherwise `glyph_count * charsize` could overflow i64 for
    # an adversarial caller and the subsequent alloc/memcpy would walk off.
    if (glyph_count > KASHI_PSF_MAX_COUNT) { return 0 - KASHI_EINVAL; }
    if (glyph_data == 0) { return 0 - KASHI_EINVAL; }
    var stride = (width + 7) / 8;
    var charsize = height * stride;
    var nbytes = glyph_count * charsize;
    var owned = alloc(nbytes);
    if (owned == 0) { return 0 - KASHI_EINVAL; }
    memcpy(owned, glyph_data, nbytes);
    return _kashi_rt_register(width, height, glyph_count, charsize, owned, 0);
}

# --- File reading (1.3.0; ADR 0012) ---
#
# The five *_file entry points read through _kashi_read_file. Until 1.3.0
# each allocated a buffer of its full cap before opening the path (kept for
# good, even when the path was missing), cut a larger file at the cap and
# loaded what fit, and on a FIFO or a tty blocked forever (audit
# 2026-10-30, L3 / L4 / L5).

# Read the whole file at `path` into a buffer sized to it. Returns the
# buffer and stores its byte count at `nout`; or returns 0 and stores the
# KashiResult code at `nout`: KASHI_EINVAL for a path that cannot be read,
# is not a regular file (Linux), or is larger than `cap`; KASHI_EFORMAT for
# an empty file. Internal.
fn _kashi_read_file(path, cap, nout) {
    store64(nout, KASHI_EINVAL);
    if (path == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return _kashi_read_bounded(path, cap, nout);
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return _kashi_read_bounded(path, cap, nout);
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    return _kashi_read_bounded(path, cap, nout);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_MACOS
    # Linux (x86_64 and aarch64). O_NONBLOCK: opening a FIFO never waits for
    # a writer. 256 = O_NOCTTY on both arches: a tty never becomes the
    # caller's controlling terminal. Then fstat the OPEN descriptor (no
    # stat-then-open race) and take only a regular file of 1..cap bytes.
    var fd = file_open(path, O_NONBLOCK | 256 | O_CLOEXEC, 0);
    if (fd < 0) { return 0; }
    var st[256];
    if (sys_fstat(fd, &st) != 0) { file_close(fd); return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) { file_close(fd); return 0; }
    var size = load64(&st + STAT_SIZE);
    if (size > cap) { file_close(fd); return 0; }
    if (size < 1) { file_close(fd); store64(nout, KASHI_EFORMAT); return 0; }
    var buf = alloc(size + 1);
    if (buf == 0) { file_close(fd); return 0; }
    # Read to EOF. One byte of room past `size` catches a file that grew
    # since the fstat; a read interrupted by a signal (-EINTR) is retried.
    var total = 0;
    var going = 1;
    while (going == 1) {
        var n = file_read(fd, buf + total, size + 1 - total);
        if (n == 0) { going = 0; }
        if (n > 0) {
            total = total + n;
            if (total > size) { going = 0; }
        }
        if (n < 0) {
            if (n != 0 - 4) {
                total = 0 - 1;
                going = 0;
            }
        }
    }
    file_close(fd);
    if (total < 0) { return 0; }
    if (total > size) { return 0; }
    if (total == 0) { store64(nout, KASHI_EFORMAT); return 0; }
    store64(nout, total);
    return buf;
    #endif
    #endif
    #endif
}

# The other targets' reader: up to cap + 1 bytes through the stdlib, so a
# file larger than `cap` is refused rather than cut. Same contract as
# _kashi_read_file. Internal.
fn _kashi_read_bounded(path, cap, nout) {
    store64(nout, KASHI_EINVAL);
    var buf = alloc(cap + 1);
    if (buf == 0) { return 0; }
    var n = file_read_all(path, buf, cap + 1);
    if (n < 0) { return 0; }
    if (n > cap) { return 0; }
    if (n == 0) { store64(nout, KASHI_EFORMAT); return 0; }
    store64(nout, n);
    return buf;
}

# Load a PSF1/PSF2 font from an in-memory buffer into a runtime font slot.
# Validates via kashi_psf_parse, copies the glyph bytes into an owned store,
# builds the font's Unicode maps if it carries a table, and registers the
# complete record. Returns font_id (>= KASHI_RT_FONT_BASE) or
# `0 - <KashiResult>` on a malformed / unsupported / truncated font (so a
# caller can `if (id < 0)`), or `0 - KASHI_EFORMAT` if an allocation failed.
fn kashi_load_psf(buf, len) {
    var hdr[56];
    var maps[40];
    var rc = kashi_psf_parse(buf, len, &hdr);
    if (rc != KASHI_OK) { return 0 - rc; }
    var width = load64(&hdr + KASHI_PH_WIDTH);
    var height = load64(&hdr + KASHI_PH_HEIGHT);
    var count = load64(&hdr + KASHI_PH_COUNT);
    var charsize = load64(&hdr + KASHI_PH_CHARSIZE);
    var dataoff = load64(&hdr + KASHI_PH_DATAOFF);
    var unioff = load64(&hdr + KASHI_PH_UNIOFF);
    var kind = load64(&hdr + KASHI_PH_KIND);
    var mp = 0;
    if (unioff != 0) {
        # A table that yields nothing still makes the font table-addressed
        # (the empty map), so only an allocation failure fails the load.
        if (_kashi_build_maps(buf, len, kind, unioff, count, &maps) == 0 - 1) {
            return 0 - KASHI_EFORMAT;
        }
        mp = &maps;
    }
    var nbytes = count * charsize;
    var owned = alloc(nbytes);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    memcpy(owned, buf + dataoff, nbytes);
    return _kashi_rt_register(width, height, count, charsize, owned, mp);
}

# Load a PSF font from a file path: a regular file of at most 256 KiB
# (ample for any console font). A larger file, a FIFO / tty / device, or an
# unreadable path is `0 - KASHI_EINVAL`; an empty file `0 - KASHI_EFORMAT`.
# Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.
fn kashi_load_psf_file(path) {
    var res[8];
    var buf = _kashi_read_file(path, 262144, &res);
    if (buf == 0) { return 0 - load64(&res); }
    return kashi_load_psf(buf, load64(&res));
}

# --- BDF import (0.7.0; ADR 0008) ---
#
# Load an X11 BDF (Bitmap Distribution Format) font from an in-memory
# buffer into a runtime slot. The pure parser lives in src/font_bdf.cyr;
# this routine drives it glyph-by-glyph, copying each glyph's bitmap into
# an owned glyph store and collecting (codepoint, glyph) pairs for the
# codepoint→glyph map. ENCODING -1 glyphs are skipped (ADR 0008).
# Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.

# Translate a BDF-parser result code into the public KashiResult negative-form.
fn _kashi_bdf_to_result(rc) {
    if (rc == KASHI_BDF_OK) { return KASHI_OK; }
    if (rc == KASHI_BDF_EINVAL) { return KASHI_EINVAL; }
    return KASHI_EFORMAT;
}

fn kashi_load_bdf(buf, len) {
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }

    var hdr[56];
    var ctx[32];
    var rc = kashi_bdf_parse_header(buf, len, &hdr, &ctx);
    if (rc != KASHI_BDF_OK) { return 0 - _kashi_bdf_to_result(rc); }

    var width = load64(&hdr + BDF_PH_WIDTH);
    var height = load64(&hdr + BDF_PH_HEIGHT);
    var count = load64(&hdr + BDF_PH_COUNT);
    var charsize = load64(&hdr + BDF_PH_CHARSIZE);
    var dataoff = load64(&hdr + BDF_PH_DATAOFF);

    # Single-pass over-allocate to the declared count and write each OK glyph
    # into its slot; SKIP glyphs land in a scratch slot and are discarded.
    # 1.3.0 (audit 2026-10-30, B2): bound that count by what the input can
    # hold as well. Every glyph record spends at least 33 bytes on its five
    # keywords (STARTCHAR, ENCODING, BBX, BITMAP, ENDCHAR), so the bytes from
    # the first STARTCHAR on hold at most (len - dataoff) / 33 + 1 glyphs; a
    # 400-byte file declaring CHARS 65536 no longer reserves 9 MiB.
    var fit = (len - dataoff) / 33 + 1;
    if (count > fit) { count = fit; }
    var owned = alloc(count * charsize);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    var umap = alloc(count * 16);
    if (umap == 0) { return 0 - KASHI_EFORMAT; }

    # Stack scratch for SKIP rows and for the "CHARS was a lie (too low)"
    # detection path. 128 bytes = max charsize (32*4) per ADR 0005.
    var scratch[128];

    var gout[24];
    var maps[40];
    var pos = dataoff;
    var w = 0;
    var loop_done = 0;
    var err = 0;
    while (loop_done == 0) {
        var slot = &scratch;
        if (w < count) { slot = owned + w * charsize; }
        var grc = kashi_bdf_next_glyph(buf, pos, len, &ctx, slot, charsize, &gout);
        if (grc != KASHI_BDF_OK) { err = 1; loop_done = 1; }
        if (loop_done == 0) {
            var kind = load64(&gout + BG_KIND);
            if (kind == BG_KIND_END) {
                loop_done = 1;
                # 1.3.0 (audit 2026-10-30, B1): the cursor also reports END
                # at the end of the buffer; only an ENDFONT line ends a
                # complete font. A truncated file used to load as a partial
                # font and succeed.
                if (_kashi_bdf_has_endfont(buf, pos, len) == 0) { err = 1; }
            }
            if (loop_done == 0) {
                pos = load64(&gout + BG_NEXT);
                if (kind == BG_KIND_OK) {
                    if (w >= count) { err = 1; loop_done = 1; }
                    if (loop_done == 0) {
                        var cp = load64(&gout + BG_CP);
                        store64(umap + w * 16 + 0, cp);
                        store64(umap + w * 16 + 8, w);
                        w = w + 1;
                    }
                }
            }
        }
    }
    if (err == 1) { return 0 - KASHI_EFORMAT; }
    if (w == 0) { return 0 - KASHI_EFORMAT; }

    store64(&maps + 0, umap);
    store64(&maps + 8, _kashi_pairs_finish(umap, w));
    store64(&maps + 16, 0);
    store64(&maps + 24, 0);
    store64(&maps + 32, 0);
    return _kashi_rt_register(width, height, w, charsize, owned, &maps);
}

# Load a BDF font from a file path: a regular file of at most
# KASHI_BDF_FILE_CAP (4 MiB — ADR 0008). A larger file, a FIFO / tty /
# device, or an unreadable path is `0 - KASHI_EINVAL`; an empty file
# `0 - KASHI_EFORMAT`. Returns font_id (>= KASHI_RT_FONT_BASE) or
# `0 - <KashiResult>`.
fn kashi_load_bdf_file(path) {
    var res[8];
    var buf = _kashi_read_file(path, KASHI_BDF_FILE_CAP, &res);
    if (buf == 0) { return 0 - load64(&res); }
    return kashi_load_bdf(buf, load64(&res));
}

# --- PCF import (0.7.1; ADR 0009) ---
#
# X11 compiled bitmap format. The pure parser lives in src/font_pcf.cyr;
# this routine drives it: parse header, decode every glyph in source
# order, then walk the BDF_ENCODINGS range to build the codepoint→glyph
# map. Returns font_id (>= KASHI_RT_FONT_BASE) or `0 - <KashiResult>`.

fn _kashi_pcf_to_result(rc) {
    if (rc == KASHI_PCF_OK) { return KASHI_OK; }
    if (rc == KASHI_PCF_EINVAL) { return KASHI_EINVAL; }
    return KASHI_EFORMAT;
}

fn kashi_load_pcf(buf, len) {
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }

    var hdr[56];
    var ctx[144];
    var maps[40];
    var rc = kashi_pcf_parse_header(buf, len, &hdr, &ctx);
    if (rc != KASHI_PCF_OK) { return 0 - _kashi_pcf_to_result(rc); }

    var width = load64(&hdr + PCF_PH_WIDTH);
    var height = load64(&hdr + PCF_PH_HEIGHT);
    var count = load64(&hdr + PCF_PH_COUNT);
    var charsize = load64(&hdr + PCF_PH_CHARSIZE);

    # Decode every glyph in source order. The runtime store mirrors the
    # PCF's glyph index space; the cp-map below maps codepoints to those
    # same indices (multiple cps can map to the same glyph index).
    var owned = alloc(count * charsize);
    if (owned == 0) { return 0 - KASHI_EFORMAT; }
    var g = 0;
    while (g < count) {
        var grc = kashi_pcf_decode_glyph(buf, &ctx, g, owned + g * charsize, charsize);
        if (grc != KASHI_PCF_OK) { return 0 - KASHI_EFORMAT; }
        g = g + 1;
    }

    # Walk the encoded codepoint range, collect (cp, glyph_idx) pairs.
    # Worst case is range_b1 * range_b2 entries (≤ 65536 for plane-0 BMP).
    var min_b1 = load64(&ctx + PCF_CTX_MIN_B1);
    var max_b1 = load64(&ctx + PCF_CTX_MAX_B1);
    var min_b2 = load64(&ctx + PCF_CTX_MIN_B2);
    var max_b2 = load64(&ctx + PCF_CTX_MAX_B2);
    var range_b1 = max_b1 - min_b1 + 1;
    var range_b2 = max_b2 - min_b2 + 1;
    var max_entries = range_b1 * range_b2;
    var umap = alloc(max_entries * 16);
    if (umap == 0) { return 0 - KASHI_EFORMAT; }

    var w = 0;
    var b1 = min_b1;
    while (b1 <= max_b1) {
        var b2 = min_b2;
        while (b2 <= max_b2) {
            var cp = (b1 << 8) | b2;
            var idx = kashi_pcf_cp_to_idx(buf, &ctx, cp);
            if (idx >= 0) {
                if (w < max_entries) {
                    store64(umap + w * 16 + 0, cp);
                    store64(umap + w * 16 + 8, idx);
                    w = w + 1;
                }
            }
            b2 = b2 + 1;
        }
        b1 = b1 + 1;
    }
    if (w == 0) { return 0 - KASHI_EFORMAT; }

    # The walk visits codepoints in ascending order, so the pairs arrive
    # sorted; finishing them is linear-cost here and keeps one rule for
    # every map (ADR 0012).
    store64(&maps + 0, umap);
    store64(&maps + 8, _kashi_pairs_finish(umap, w));
    store64(&maps + 16, 0);
    store64(&maps + 24, 0);
    store64(&maps + 32, 0);
    return _kashi_rt_register(width, height, count, charsize, owned, &maps);
}

# Load a PCF font from a file path: a regular file of at most
# KASHI_PCF_FILE_CAP (4 MiB — ADR 0009). A larger file, a FIFO / tty /
# device, or an unreadable path is `0 - KASHI_EINVAL`; an empty file
# `0 - KASHI_EFORMAT`. Returns font_id (>= KASHI_RT_FONT_BASE) or
# `0 - <KashiResult>`.
fn kashi_load_pcf_file(path) {
    var res[8];
    var buf = _kashi_read_file(path, KASHI_PCF_FILE_CAP, &res);
    if (buf == 0) { return 0 - load64(&res); }
    return kashi_load_pcf(buf, load64(&res));
}

# --- Sidecar Unicode table attachment (0.7.2; ADR 0010) ---
#
# Attach an externally-supplied codepoint→glyph mapping to an
# already-loaded runtime font. Two source formats:
#   * Binary — raw PSF1 (LE-u16) or PSF2 (UTF-8) Unicode-table bytes
#     (the format psfaddtable / psfgettable emit when the PSF carries
#     no inline table). Reuses _kashi_build_umap + _kashi_build_useqs.
#   * Text — psfgettable-style: one line per glyph,
#     "0x<hex_idx>  U+<hex_cp> [U+<hex_cp> ...]   # comment".
#
# Replace semantics: a successful attach overwrites the record's umap/seqs
# (the previous allocations leak-conceptually; the bump allocator reclaims
# at process exit). The new maps are built aside and stored only once the
# table has parsed, so a failed attach leaves the record exactly as it was
# (since 1.3.0 it is never cleared in between). Built-in fonts return
# `0 - KASHI_EINVAL` — attach is for runtime ids (≥ KASHI_RT_FONT_BASE) only.
# Returns KASHI_OK or `0 - <KashiResult>`.

# Tab file-size cap (matches the existing PSF cap).
enum KashiTabCap {
    KASHI_TAB_FILE_CAP = 262144;
}

# --- Text-tab parser primitives (internal) ---

fn _kashi_tab_ws(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            var c = load8(buf + pos);
            if (c == 0x20) { pos = pos + 1; }
            if (c == 0x09) { pos = pos + 1; }
            if (c != 0x20) {
                if (c != 0x09) { done = 1; }
            }
        }
    }
    return pos;
}

fn _kashi_tab_eol(buf, pos, end) {
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            if (load8(buf + pos) == 0x0A) { done = 1; }
            if (done == 0) { pos = pos + 1; }
        }
    }
    return pos;
}

fn _kashi_tab_next_line(buf, pos, end) {
    var e = _kashi_tab_eol(buf, pos, end);
    if (e < end) { return e + 1; }
    return end;
}

# Check whether buf[pos..pos+2] equals (p0, p1). Returns 1 if yes.
fn _kashi_tab_pfx2(buf, pos, end, p0, p1) {
    if (pos + 2 > end) { return 0; }
    if (load8(buf + pos) != p0) { return 0; }
    if (load8(buf + pos + 1) != p1) { return 0; }
    return 1;
}

# Parse a hex integer at pos (no prefix; just hex digits). Writes
# value at out + 0, post-position at out + 8. Returns 1 on success,
# 0 on no-digits. Caps consumed digits at 12 to keep i64 safe.
fn _kashi_tab_hex(buf, pos, end, out) {
    store64(out + 0, 0);
    store64(out + 8, pos);
    var start = pos;
    var n = 0;
    var digits = 0;
    var done = 0;
    while (done == 0) {
        if (pos >= end) { done = 1; }
        if (done == 0) {
            if (digits >= 12) { done = 1; }
            if (done == 0) {
                var c = load8(buf + pos);
                var d = 0 - 1;
                if (c >= 0x30) {
                    if (c <= 0x39) { d = c - 0x30; }
                }
                if (c >= 0x41) {
                    if (c <= 0x46) { d = c - 0x41 + 10; }
                }
                if (c >= 0x61) {
                    if (c <= 0x66) { d = c - 0x61 + 10; }
                }
                if (d < 0) { done = 1; }
                if (done == 0) {
                    n = (n << 4) | d;
                    pos = pos + 1;
                    digits = digits + 1;
                }
            }
        }
    }
    if (pos == start) { return 0; }
    store64(out + 0, n);
    store64(out + 8, pos);
    return 1;
}

# Text-tab parser. Walks `buf[0..len]`, parses each non-blank /
# non-comment line as "0x<idx>  U+<cp> [U+<cp> ...]  # comment".
# Builds the (cp, glyph_idx) pair array, sorts, attaches to `rec`.
# Returns KASHI_OK on success, KASHI_EFORMAT on syntax error or
# zero valid pairs. Internal.
fn _kashi_attach_text_impl(rec, buf, len) {
    var count = load64(rec + _KASHI_RT_COUNT);
    var pair[16];

    # Pass 1: count valid (cp, idx) pairs.
    var n = 0;
    var p = 0;
    while (p < len) {
        var le = _kashi_tab_eol(buf, p, len);
        var ls = _kashi_tab_ws(buf, p, le);
        if (ls < le) {
            var c0 = load8(buf + ls);
            if (c0 != 0x23) {
                # 0x or 0X prefix required.
                var is_0x = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x78);
                var is_0X = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x58);
                if (is_0x + is_0X == 0) { return KASHI_EFORMAT; }
                if (_kashi_tab_hex(buf, ls + 2, le, &pair) == 0) {
                    return KASHI_EFORMAT;
                }
                var glyph = load64(&pair + 0);
                var q = load64(&pair + 8);
                q = _kashi_tab_ws(buf, q, le);
                var more = 1;
                while (more == 1) {
                    if (q >= le) { more = 0; }
                    if (more == 1) {
                        var cc = load8(buf + q);
                        if (cc == 0x23) { more = 0; }
                        if (more == 1) {
                            if (_kashi_tab_pfx2(buf, q, le, 0x55, 0x2B) == 0) {
                                return KASHI_EFORMAT;
                            }
                            if (_kashi_tab_hex(buf, q + 2, le, &pair) == 0) {
                                return KASHI_EFORMAT;
                            }
                            # 1.3.0 (audit 2026-10-30, L9): a U+ value must be
                            # a Unicode scalar, as the binary tables' decoder
                            # requires — not a surrogate, not past U+10FFFF.
                            var cpv = load64(&pair + 0);
                            if (cpv > 0x10FFFF) { return KASHI_EFORMAT; }
                            if (cpv >= 0xD800) {
                                if (cpv <= 0xDFFF) { return KASHI_EFORMAT; }
                            }
                            q = load64(&pair + 8);
                            if (glyph < count) { n = n + 1; }
                            q = _kashi_tab_ws(buf, q, le);
                        }
                    }
                }
            }
        }
        p = _kashi_tab_next_line(buf, p, len);
    }
    if (n == 0) { return KASHI_EFORMAT; }

    # Pass 2: alloc and fill.
    var arr = alloc(n * 16);
    if (arr == 0) { return KASHI_EFORMAT; }
    var w = 0;
    p = 0;
    while (p < len) {
        var le = _kashi_tab_eol(buf, p, len);
        var ls = _kashi_tab_ws(buf, p, le);
        if (ls < le) {
            var c0 = load8(buf + ls);
            if (c0 != 0x23) {
                var is_0x2 = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x78);
                var is_0X2 = _kashi_tab_pfx2(buf, ls, le, 0x30, 0x58);
                if (is_0x2 + is_0X2 == 0) { return KASHI_EFORMAT; }
                if (_kashi_tab_hex(buf, ls + 2, le, &pair) == 0) {
                    return KASHI_EFORMAT;
                }
                var glyph = load64(&pair + 0);
                var q = load64(&pair + 8);
                q = _kashi_tab_ws(buf, q, le);
                var more = 1;
                while (more == 1) {
                    if (q >= le) { more = 0; }
                    if (more == 1) {
                        var cc = load8(buf + q);
                        if (cc == 0x23) { more = 0; }
                        if (more == 1) {
                            if (_kashi_tab_pfx2(buf, q, le, 0x55, 0x2B) == 0) {
                                return KASHI_EFORMAT;
                            }
                            if (_kashi_tab_hex(buf, q + 2, le, &pair) == 0) {
                                return KASHI_EFORMAT;
                            }
                            var cp = load64(&pair + 0);
                            q = load64(&pair + 8);
                            if (glyph < count) {
                                if (w < n) {
                                    store64(arr + w * 16 + 0, cp);
                                    store64(arr + w * 16 + 8, glyph);
                                    w = w + 1;
                                }
                            }
                            q = _kashi_tab_ws(buf, q, le);
                        }
                    }
                }
            }
        }
        p = _kashi_tab_next_line(buf, p, len);
    }

    w = _kashi_pairs_finish(arr, w);

    # Replace any existing umap + seqs (text format carries no sequences).
    store64(rec + _KASHI_RT_UMAP, arr);
    store64(rec + _KASHI_RT_UCOUNT, w);
    store64(rec + _KASHI_RT_SEQS, 0);
    store64(rec + _KASHI_RT_SEQCOUNT, 0);
    store64(rec + _KASHI_RT_SEQDATA, 0);
    return KASHI_OK;
}

# --- Public attach APIs ---

# Attach a binary PSF Unicode table to a runtime font. `kind` is
# KASHI_PSF_KIND_PSF1 (LE-u16) or KASHI_PSF_KIND_PSF2 (UTF-8).
# Replaces any existing umap/seqs. Returns KASHI_OK or `0 - <code>`.
fn kashi_attach_unicode_table(font_id, buf, len, kind) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - KASHI_EINVAL; }
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }
    if (kind != KASHI_PSF_KIND_PSF1) {
        if (kind != KASHI_PSF_KIND_PSF2) { return 0 - KASHI_EINVAL; }
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - KASHI_EINVAL; }

    # 0.8.0 audit F9 (CVE-2015-1803 stale-state-after-parse-error pattern):
    # a table that yields nothing must not strip the font's existing map.
    # Since 1.3.0 the new maps are built aside and stored only on success, so
    # the record is never cleared in between (audit 2026-10-30, L8).
    var maps[40];
    var mrc = _kashi_build_maps(buf, len, kind, 0, load64(rec + _KASHI_RT_COUNT), &maps);
    if (mrc != 0) { return 0 - KASHI_EFORMAT; }
    store64(rec + _KASHI_RT_SEQS, load64(&maps + 16));
    store64(rec + _KASHI_RT_SEQCOUNT, load64(&maps + 24));
    store64(rec + _KASHI_RT_SEQDATA, load64(&maps + 32));
    store64(rec + _KASHI_RT_UMAP, load64(&maps + 0));
    store64(rec + _KASHI_RT_UCOUNT, load64(&maps + 8));
    return KASHI_OK;
}

# File companion for kashi_attach_unicode_table: a regular file of at most
# KASHI_TAB_FILE_CAP (256 KiB), read only after the font id and kind are
# known to be valid (1.3.0; a call that must fail no longer opens the path).
fn kashi_attach_unicode_table_file(font_id, path, kind) {
    if (_kashi_rt_get(font_id) == 0) { return 0 - KASHI_EINVAL; }
    if (kind != KASHI_PSF_KIND_PSF1) {
        if (kind != KASHI_PSF_KIND_PSF2) { return 0 - KASHI_EINVAL; }
    }
    var res[8];
    var buf = _kashi_read_file(path, KASHI_TAB_FILE_CAP, &res);
    if (buf == 0) { return 0 - load64(&res); }
    return kashi_attach_unicode_table(font_id, buf, load64(&res), kind);
}

# Attach a text-format Unicode table (psfgettable convention).
fn kashi_attach_unicode_text(font_id, buf, len) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - KASHI_EINVAL; }
    if (buf == 0) { return 0 - KASHI_EINVAL; }
    if (len < 0) { return 0 - KASHI_EINVAL; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - KASHI_EINVAL; }
    var rc = _kashi_attach_text_impl(rec, buf, len);
    if (rc == KASHI_OK) { return KASHI_OK; }
    return 0 - rc;
}

# File companion for kashi_attach_unicode_text: a regular file of at most
# KASHI_TAB_FILE_CAP (256 KiB), read only after the font id is known to be
# valid (1.3.0).
fn kashi_attach_unicode_text_file(font_id, path) {
    if (_kashi_rt_get(font_id) == 0) { return 0 - KASHI_EINVAL; }
    var res[8];
    var buf = _kashi_read_file(path, KASHI_TAB_FILE_CAP, &res);
    if (buf == 0) { return 0 - load64(&res); }
    return kashi_attach_unicode_text(font_id, buf, load64(&res));
}

# --- Raw glyph-INDEX accessors (runtime fonts only) ---

# Base pointer to runtime-font glyph `idx`'s row bytes (idx in [0,count)).
# No codepoint mapping — for tooling / enumeration / table-less fonts.
# Returns 0 for an unknown runtime font or out-of-range index. (Built-in
# fonts have no separate index space; use kashi_glyph_ptr for those.)
fn kashi_rt_glyph_ptr(font_id, idx) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    if (idx < 0) { return 0; }
    var count = load64(rec + _KASHI_RT_COUNT);
    if (idx >= count) { return 0; }
    var charsize = load64(rec + _KASHI_RT_CHARSIZE);
    var data = load64(rec + _KASHI_RT_DATA);
    return data + idx * charsize;
}

# One row byte of runtime-font glyph `idx` (bit 7 = leftmost). For wide
# fonts (stride > 1) this returns the LEADING byte of the row (byte_idx 0);
# use kashi_rt_glyph_row_byte for the other bytes. Returns 0 for an unknown
# runtime font, out-of-range index, or out-of-range row.
fn kashi_rt_glyph_row(font_id, idx, row) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var height = load64(rec + _KASHI_RT_HEIGHT);
    if (row < 0) { return 0; }
    if (row >= height) { return 0; }
    var base = kashi_rt_glyph_ptr(font_id, idx);
    if (base == 0) { return 0; }
    var stride = load64(rec + _KASHI_RT_STRIDE);
    return load8(base + row * stride);
}

# One row byte at column-byte position `byte_idx` for runtime-font glyph
# `idx`. Multi-byte-aware sibling of kashi_rt_glyph_row. Returns 0 for any
# out-of-range input (unknown font, bad idx/row/byte_idx). Added in 0.5.0.
fn kashi_rt_glyph_row_byte(font_id, idx, row, byte_idx) {
    if (byte_idx < 0) { return 0; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var stride = load64(rec + _KASHI_RT_STRIDE);
    if (byte_idx >= stride) { return 0; }
    var height = load64(rec + _KASHI_RT_HEIGHT);
    if (row < 0) { return 0; }
    if (row >= height) { return 0; }
    var base = kashi_rt_glyph_ptr(font_id, idx);
    if (base == 0) { return 0; }
    return load8(base + row * stride + byte_idx);
}

# --- Unified, CODEPOINT-addressed accessors: built-in (0..2) vs runtime (>=3) ---

# Base pointer to a glyph's row bytes for ANY font, addressed by Unicode
# codepoint. Built-ins: `cp` is mapped to a cell by kashi_cp437_from_unicode
# (1.1.0, ADR 0011) — ASCII, the CP437 repertoire, U+2302 and the extension
# glyphs U+2026 / U+FFFD resolve; anything else is unmapped (until 1.1.0 `cp`
# was taken as the CP437 cell, so U+00E7 'ç' drew 0xE7 'τ'). Runtime: `cp`
# resolved via the font's Unicode map, or treated as a raw glyph index if
# the font carried no table. Returns 0 (null) for an unknown font or
# unmapped cp.
fn kashi_font_ptr(font_id, cp) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_ptr(font_id, kashi_cp437_from_unicode(cp));
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_ptr(font_id, idx);
}

# One row byte of a glyph for ANY font, addressed by Unicode codepoint
# (built-ins map it through kashi_cp437_from_unicode — see kashi_font_ptr).
# For wide fonts (stride > 1) this is the LEADING byte; use
# kashi_font_row_byte for the other bytes. Returns 0 for an unknown font,
# unmapped cp, or bad row. Resolves `cp` on every call; a render loop should
# resolve once per glyph with kashi_font_ptr and read rows with load8.
fn kashi_font_row(font_id, cp, row) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_row(font_id, kashi_cp437_from_unicode(cp), row);
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_row(font_id, idx, row);
}

# Multi-byte-aware row accessor for ANY font, addressed by Unicode
# codepoint (built-ins map it through kashi_cp437_from_unicode, 1.1.0).
# `byte_idx` 0 is the leftmost 8 px, then 8..15, etc. For stride-1 fonts
# only byte_idx 0 is meaningful. Bounds-safe across the full input domain.
# Added in 0.5.0 (ADR 0005).
fn kashi_font_row_byte(font_id, cp, row, byte_idx) {
    if (font_id < KASHI_RT_FONT_BASE) {
        return kashi_glyph_row_byte(font_id, kashi_cp437_from_unicode(cp), row, byte_idx);
    }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    var idx = _kashi_rt_cp_to_glyph(rec, cp);
    if (idx < 0) { return 0; }
    return kashi_rt_glyph_row_byte(font_id, idx, row, byte_idx);
}

# Runtime-font metadata (ids >= KASHI_RT_FONT_BASE). Unknown id -> 0.
fn kashi_rt_font_width(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + _KASHI_RT_WIDTH);
}

fn kashi_rt_font_height(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + _KASHI_RT_HEIGHT);
}

fn kashi_rt_font_count(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + _KASHI_RT_COUNT);
}

# Bytes per row for a runtime font (= ceil(width/8)). Mirrors the core's
# kashi_font_stride for built-ins. Added in 0.5.0. Unknown id -> 0.
fn kashi_rt_font_stride(font_id) {
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0; }
    return load64(rec + _KASHI_RT_STRIDE);
}

# PSF ligature lookup: given a sequence of `len` codepoints (each a u64 at
# `cps_ptr + i*8`), return the glyph index of the matching ligature in
# `font_id`, or `0 - 1` if there's no match (incl. built-in ids, fonts
# without a sequence table, null inputs, or non-positive `len`). Binary
# search over the sorted records since 1.3.0 (a linear scan before). Added
# in 0.5.0 (ADR 0005).
fn kashi_font_seq_glyph(font_id, cps_ptr, len) {
    if (font_id < KASHI_RT_FONT_BASE) { return 0 - 1; }
    if (cps_ptr == 0) { return 0 - 1; }
    if (len < 1) { return 0 - 1; }
    var rec = _kashi_rt_get(font_id);
    if (rec == 0) { return 0 - 1; }
    var seqs = load64(rec + _KASHI_RT_SEQS);
    if (seqs == 0) { return 0 - 1; }
    var seqcount = load64(rec + _KASHI_RT_SEQCOUNT);
    # Binary search over the sorted records (1.3.0; it was a linear scan).
    var lo = 0;
    var hi = seqcount - 1;
    while (lo <= hi) {
        var mid = lo + (hi - lo) / 2;
        var r = seqs + mid * 24;
        var c = _kashi_seq_cmp(load64(r), load64(r + 8), cps_ptr, len);
        if (c == 0) { return load64(r + 16); }
        if (c < 0) { lo = mid + 1; }
        if (c > 0) { hi = mid - 1; }
    }
    return 0 - 1;
}

# Number of fonts kashi currently knows: the three freestanding built-ins
# (VGA 8x16, CGA 8x8, VGA 9x16) plus every runtime-registered font. Font
# ids are dense `[0, kashi_font_total())`, so enumeration is a plain
# `for id in 0..total` loop through the existing accessors.
fn kashi_font_total() {
    if (_kashi_rt_registry == 0) { return 3; }
    return 3 + vec_len(_kashi_rt_registry);
}

# --- Active-font knob (M2 registry nicety) ---
#
# A console (or any consumer with the concept of a "current font") can stash
# its selection here instead of plumbing the id everywhere. Defaults to 0 (the
# VGA 8x16 built-in). Purely additive — the accessors never consult this; the
# consumer reads it and passes the id to kashi_font_ptr/row themselves.
var _kashi_active_font = 0;

# Set the active font_id. Returns KASHI_OK or `0 - KASHI_EINVAL` for an id
# outside `[0, kashi_font_total())`.
fn kashi_set_active_font(font_id) {
    if (font_id < 0) { return 0 - KASHI_EINVAL; }
    if (font_id >= kashi_font_total()) { return 0 - KASHI_EINVAL; }
    _kashi_active_font = font_id;
    return KASHI_OK;
}

# Read the active font_id (default 0 = VGA 8x16).
fn kashi_active_font() {
    return _kashi_active_font;
}
